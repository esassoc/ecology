---
// __SPOKE_NAME__ base layout — wires the hub tokens + the __SPOKE_NAME__ theme,
// loads the brand's fonts, and sets data-theme="__SPOKE_SLUG__" so every
// inherited esa-* component re-skins to __SPOKE_NAME__.
import '@esa/tokens/tokens.css';
import '@esa/tokens/component-tokens.css';
import '@esa/tokens/typography.css';
import '@esa/tokens/layouts.css';
// The page-level focus ring. Light DOM only — the esa-* web components paint
// their own from the same tokens. Without this a spoke's own <a>/<button> fall
// back to the browser default, which differs per engine and is user-editable.
import '@esa/tokens/focus.css';
import '@esa/tokens/a11y.css';
import '../styles/theme-__SPOKE_SLUG__.css';
// Runtime handoff inspector — self-gating: dormant unless the current route
// has a bundle at public/handoff/<slug>/ (generated via `npx handoff`).
import HandoffInspector from '@esa/handoff/HandoffInspector.astro';

// ACCESSIBILITY ASSURANCE (optional). If this project has a conformance obligation
// — Section 508, EN 301 549, a procurement clause — add data-a11y-assurance="wcag-aa" to
// the <html> tag below. It composes with data-theme; the brand does not change:
//
//   <html lang="en" data-theme="__SPOKE_SLUG__" data-a11y-assurance="wcag-aa">
//
// It ships inside @esa/tokens and is inert until set, so there is nothing to import.
//
// YOUR THEME CARRIES ITS OWN, and that is the half that actually moves your brand. A
// theme written by `npm run theme:make` emits its own [data-a11y-assurance="wcag-aa"] block
// alongside the brand block, scoped so it outranks both. Grep theme-__SPOKE_SLUG__.css
// for `data-a11y-assurance` to see exactly what the attribute changes for this project — it
// is usually short, because a generated theme is already AA in both schemes.
//
// IT CHANGES COLOUR AND NOTHING ELSE. Solid fills that carry text move to a
// contrast-safe step. Your components do not change: not their size, not their type,
// not one pixel of layout — verified across all 91 pages of the hub's own site. So
// size="xs" still renders at xs, and your size ramp keeps all four distinct steps.
//
// Anything that WOULD require a component to change is reported instead, and names
// the compliant option to use:
//
//   npm run a11y:sizes
//
// THE HUB'S HALF CANNOT REACH YOUR BRAND, and do not expect it to. `[data-theme]` and
// a bare `[data-a11y-assurance]` have equal specificity and theme-__SPOKE_SLUG__.css loads
// later, so every role your theme re-points wins over the hub's profile — and the hub's
// values point at ITS brand ramp (grass), which would be wrong here anyway. That is why
// the block in your own theme file exists. Verify rather than assume, in both schemes:
//
//   node ../ecology/scripts/check-themes.mjs
//
// That one command grades every theme-*.css in src/styles across both schemes, with and
// without each profile — the four runs per theme that check-contrast.mjs takes one at a
// time. It exits 1 on any failure, so it belongs in this project's own `npm test`.
//
// DO NOT HAND-DECLARE THESE NAMES in a block of your own. Regenerating the theme is the
// channel; a hand-written override at the same specificity loses to whichever loads last.
//
// Setting the attribute is a statement about DEFAULTS, not a conformance certificate.
// See packages/tokens/src/assurance.css for what a profile cannot fix.

interface Props {
  title?: string;
}
const { title = '__SPOKE_NAME__' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="__SPOKE_SLUG__">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    __FONT_LINKS__
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--typography-font-family-sans, system-ui, sans-serif);
        font-weight: var(--typography-font-weight-regular, 350);
        color: var(--color-content-default, #3d3d3d);
        background: var(--color-background-elevation-raised, #fff);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-content-link, #43608a); text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font-family: inherit; cursor: pointer; background: none; border: 0; }
    </style>
  </head>
  <body>
    <slot />
    <HandoffInspector />
  </body>
</html>
