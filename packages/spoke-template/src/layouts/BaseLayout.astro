---
// __SPOKE_NAME__ base layout — wires the hub tokens + the __SPOKE_NAME__ theme,
// loads the brand's fonts, and sets data-theme="__SPOKE_SLUG__" so every
// inherited esa-* component re-skins to __SPOKE_NAME__.
import '@esa/tokens/tokens.css';
import '@esa/tokens/component-tokens.css';
import '@esa/tokens/typography.css';
import '@esa/tokens/layouts.css';
// The page-level focus ring. Light DOM only — the esa-* web components paint
// their own from the same tokens. Without this a spoke's own <a>/<button> fall
// back to the browser default, which differs per engine and is user-editable.
import '@esa/tokens/focus.css';
import '@esa/tokens/a11y.css';
import '../styles/theme-__SPOKE_SLUG__.css';
// Runtime handoff inspector — self-gating: dormant unless the current route
// has a bundle at public/handoff/<slug>/ (generated via `npx handoff`).
import HandoffInspector from '@esa/handoff/HandoffInspector.astro';

// ACCESSIBILITY ASSURANCE (optional). If this project has a conformance obligation
// — Section 508, EN 301 549, a procurement clause — add data-assurance="wcag-aa" to
// the <html> tag below. It composes with data-theme; the brand does not change:
//
//   <html lang="en" data-theme="__SPOKE_SLUG__" data-assurance="wcag-aa">
//
// It ships inside @esa/tokens and is inert until set, so there is nothing to import.
// What it moves: solid fills that carry text go to a contrast-safe step, the smallest
// type rung is raised, and interactive controls take a 24x24 minimum hit area.
//
// IT DOES NOT OVERRIDE YOUR THEME. Equal specificity, and theme-__SPOKE_SLUG__.css
// loads after it, so any role your theme re-points still wins — including your brand.
// Verify rather than assume:
//
//   node ../ecology/scripts/check-contrast.mjs src/styles/theme-__SPOKE_SLUG__.css --assurance wcag-aa
//
// Setting the attribute is a statement about DEFAULTS, not a conformance certificate.
// See packages/tokens/src/assurance.css for what a profile cannot fix.

interface Props {
  title?: string;
}
const { title = '__SPOKE_NAME__' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="__SPOKE_SLUG__">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    __FONT_LINKS__
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--typography-font-family-sans, system-ui, sans-serif);
        font-weight: var(--typography-font-weight-regular, 350);
        color: var(--color-content-default, #3d3d3d);
        background: var(--color-background-elevation-raised, #fff);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-content-link, #43608a); text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font-family: inherit; cursor: pointer; background: none; border: 0; }
    </style>
  </head>
  <body>
    <slot />
    <HandoffInspector />
  </body>
</html>
