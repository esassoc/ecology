---
// esa-app-shell — CANONICAL application shell (.astro).
//
// The house chrome: NEUTRAL off-white surfaces layered by value (canvas < bar <
// rail), a FULL-HEIGHT sidenav carrying the logo and its own collapse toggle, a
// compact CENTERED omnibox, and a profile dropdown. A composition of
// esa-app-bar + esa-sidebar-nav + esa-search-panel + esa-dropdown-menu — it owns
// no new visual primitives.
//
// HOUSE DECISIONS baked in: brand color never fills the chrome (only the active
// nav item + primary actions); the wordmark lives in the SIDENAV (not the top
// bar); the SIDENAV RUNS THE FULL HEIGHT and the collapse toggle belongs to it.
// `accent` (off by default) adds a faint brand-TINTED neutral wash to the bar
// (a color-mix, not a fill).
//
// THE TOGGLE USED TO BE A BUTTON IN THE TOP-LEFT OF THE BAR, and this component
// re-implemented one — 20 lines of markup, CSS and wiring — while setting
// `nav.collapsible = false` to suppress the toggle esa-sidebar-nav already
// ships. Two costs beyond the duplication: the shell's button carried a static
// `aria-label="Toggle sidebar"` where the component's says which way it goes
// ("Expand sidebar" / "Collapse sidebar"), and it needed `aria-controls` to
// point at a rail it sat outside of. A toggle INSIDE the region it collapses
// needs no such reference.
//
// LAYOUT-AGNOSTIC: does not wrap BaseLayout / <html>. Render it inside a parent
// with a fixed height (e.g. height:100dvh); the frame fills its parent and only
// the main region scrolls.
//
// DATA IN, NOT MARKUP: nav items, the user menu, and the search index are props
// (server-serialized into a JSON island the client script reads). The logo mark
// is a raw inline-SVG string passed via `mark` (rendered DIRECTLY into the sidenav
// header — no nested slot, which is what previously failed to project into the
// Lit shadow DOM).
import EsaAppBar from './esa-app-bar.astro';
import EsaButton from './esa-button.astro';
// The omnibox trigger is UI text at the compact step (`body-sm`); its hotkey hint is
// the same label rung esa-kbd uses; the main region carries `body-md` so app content
// slotted into it lands on a role by default. The import is the Astro half of the
// composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

export interface AppShellNavItem {
  key?: string;
  label: string;
  href?: string;
  icon?: string; // inner Lucide SVG (the <path>/<rect>… children)
  badge?: string | number;
  group?: string;
  children?: AppShellNavItem[];
}
export interface AppShellMenuItem {
  label: string;
  action?: string;
  icon?: string;
  divider?: boolean;
  variant?: 'default' | 'danger';
}
export interface AppShellSearchEntry {
  id: string; // a real in-app href; result-select navigates here
  title: string;
  subtitle?: string;
  category?: string;
}

interface Props {
  title?: string;
  active?: string;
  items?: AppShellNavItem[];
  userMenu?: AppShellMenuItem[];
  userName?: string;
  /** Live omnibox index (sections + records). Omit/empty to drop the search control. */
  searchIndex?: AppShellSearchEntry[];
  searchPlaceholder?: string;
  /** Raw inline SVG (full <svg>…</svg>) for the sidenav logo mark. */
  mark?: string;
  brandHref?: string;
  accent?: boolean;
  collapsed?: boolean;
  /** Stable id base — required when more than one shell is on a page. */
  id?: string;
}

const DEFAULT_USER_MENU: AppShellMenuItem[] = [
  { label: 'Profile', action: 'profile' },
  { label: 'Settings', action: 'settings' },
  { divider: true, label: '' },
  { label: 'Sign out', action: 'sign-out', variant: 'danger' },
];

const {
  title = 'App',
  active,
  items = [],
  userMenu = DEFAULT_USER_MENU,
  userName = 'Account',
  searchIndex = [],
  searchPlaceholder = 'Search…',
  mark,
  brandHref = '/',
  accent = false,
  collapsed = false,
} = Astro.props;

const uid = Astro.props.id ?? 'esa-shell';
const navId = `${uid}-nav`;
const searchId = `${uid}-search`;
const menuId = `${uid}-menu`;

const markActive = (list: AppShellNavItem[]): AppShellNavItem[] =>
  list.map((it) => ({
    ...it,
    active: active != null && it.key != null && it.key === active,
    children: it.children ? markActive(it.children) : undefined,
  }));
const navItems = markActive(items);
const hasSearch = searchIndex.length > 0;
const hasLogoSlot = Astro.slots.has('logo');
const shellCls = ['esa-app-shell', accent && 'esa-app-shell--accent'].filter(Boolean).join(' ');
// Adapt the flat searchIndex into esa-entity-search's entities + scopes (the omnibox).
const searchScopes = [...new Set(searchIndex.map((e) => e.category).filter(Boolean))].map((c) => ({ id: c, label: c }));
const searchEntities = searchIndex.map((e, i) => ({ id: `e-${i}`, title: e.title, subtitle: e.subtitle, scope: e.category, url: e.id }));
const payload = JSON.stringify({ navId, searchId, menuId, nav: navItems, menu: userMenu, entities: searchEntities, scopes: searchScopes });
---
<div class={shellCls} data-shell={uid}>
  {/* The rail is a SIBLING of the bar, not a child of a row beneath it — that is
      what makes it full-height. It comes first in the DOM as well as in the
      layout, so the reading order matches the visual order with no tabindex. */}
  <esa-sidebar-nav id={navId} class="esa-app-shell__nav" collapsed={collapsed ? '' : undefined}>
    {/* Logo lives at the TOP OF THE SIDENAV. Content is rendered DIRECTLY here
        (mark via set:html + wordmark, or a `logo` slot) — never a nested <slot>,
        so it projects cleanly into esa-sidebar-nav's shadow `header` slot. */}
    <a slot="header" class="esa-app-shell__brand" href={brandHref}>
      {hasLogoSlot ? <slot name="logo" /> : (
        <Fragment>
          {mark && <span class="esa-app-shell__mark" set:html={mark} />}
          <span class="esa-app-shell__wordmark">{title}</span>
        </Fragment>
      )}
    </a>
  </esa-sidebar-nav>

  <div class="esa-app-shell__frame">
    <EsaAppBar tone="surface" as="header" class="esa-app-shell__bar">
      {hasSearch && (
        <button class="esa-app-shell__search typography-microcopy-sm-subtle" data-shell-search={uid} type="button" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="esa-app-shell__search-label">{searchPlaceholder}</span>
          <kbd class="esa-app-shell__search-kbd typography-microcopy-xs">/</kbd>
        </button>
      )}

      <esa-dropdown-menu slot="end" id={menuId} position="below-end">
        <EsaButton variant="chrome" icon="circle-user" iconRight="chevron-down" size="sm">{userName}</EsaButton>
      </esa-dropdown-menu>
    </EsaAppBar>

    {/* `body-md` is the default for whatever the app renders here — a page that
        composes esa-* legos has each of them override it with their own role. */}
    {/* tabindex="0" because this pane is the app's scroll container
        (`overflow-y: auto`). A scrollable region that holds no focusable element
        — a long report, a map legend, a log — cannot be scrolled by keyboard at
        all unless it is itself focusable: there is nothing to Tab to inside it,
        so arrow keys never reach it. WCAG 2.1.1, and axe's
        `scrollable-region-focusable`. It costs one Tab stop before the page
        content, which is the same stop a skip-link targets. */}
    <main class="esa-app-shell__content typography-body-md" tabindex="0"><slot /></main>
  </div>

  {hasSearch && (
    <esa-entity-search id={searchId} placeholder={searchPlaceholder} hotkey="slash"></esa-entity-search>
  )}

  <script is:inline type="application/json" data-shell-data={uid} set:html={payload}></script>
</div>

<script>
  import '@esa/ecology/esa-sidebar-nav';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-entity-search';

  type AnyEl = HTMLElement & Record<string, unknown>;

  function wireShell(island: HTMLScriptElement): void {
    const cfg = JSON.parse(island.textContent || '{}');
    const uid = island.getAttribute('data-shell-data');
    const nav = document.getElementById(cfg.navId) as AnyEl | null;
    const menu = document.getElementById(cfg.menuId) as AnyEl | null;
    const panel = document.getElementById(cfg.searchId) as AnyEl | null;

    // `collapsible` is deliberately NOT set here. It defaults to true, and the
    // rail's own toggle is now the only one — this used to read
    // `nav.collapsible = false` to make room for a button in the top bar.
    if (nav) nav.items = cfg.nav;
    if (menu) menu.items = cfg.menu;

    if (panel) {
      panel.entities = cfg.entities || [];
      panel.scopes = cfg.scopes || [];
      panel.addEventListener('select', (ev) => {
        const url = (ev as CustomEvent<{ entity?: { url?: string } }>).detail?.entity?.url;
        if (url) window.location.href = url;
      });
    }
    const trigger = document.querySelector(`[data-shell-search="${uid}"]`);
    trigger?.addEventListener('click', () => (panel as (AnyEl & { show?: () => void }) | null)?.show?.());
  }

  document.querySelectorAll<HTMLScriptElement>('script[type="application/json"][data-shell-data]').forEach(wireShell);
</script>

<style>
  /* Neutral chrome via SEMANTIC tokens (a spoke re-points these to its off-whites). */
  .esa-app-shell {
    --app-bar-bg: var(--color-background-elevation-sunken, #f0f0f0);
    --app-bar-text: var(--color-content-default, #202020);
    --app-bar-pad-y: var(--spacing-200, 8px);
    --app-bar-pad-x: var(--spacing-400, 16px);
    --app-bar-gap: var(--spacing-300, 12px);
    --sidenav-bg: var(--color-background-default, #fcfcfc);
    --sidenav-border-color: var(--color-border-default, #cecece);

    /* A ROW, not a column: the rail is the first child and stretches to the
       shell's full height, and the bar spans only the content beside it. When
       the bar owned the top edge this was `column` with a nested `__body` row. */
    display: flex;
    flex-direction: row;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--color-background-default, #fcfcfc);
  }
  .esa-app-shell--accent {
    --app-bar-bg: color-mix(in srgb, var(--color-background-brand, #46a758) 5%, var(--color-background-elevation-sunken, #f0f0f0));
  }

  .esa-app-shell__bar { flex: none; border-bottom: var(--border-width-default, 1px) solid var(--color-border-default-strong, #bbbbbb); }

  /* Compact, CENTERED omnibox trigger. */
  .esa-app-shell__search {
    margin-inline: auto;
    display: inline-flex; align-items: center; gap: var(--spacing-200, 8px);
    /* SHRINKABLE, and sized against the BAR rather than the window. This was
       `width: clamp(180px, 30vw, 340px)` — 30vw is the VIEWPORT, which says
       nothing about how much room the bar has. It did not matter while the bar
       spanned the whole window; once the full-height rail took 236-280px off the
       left, a shell embedded in a doc column asked for 340px inside a 498px row
       that also had to hold a 142px profile button, and the overflow went out
       through the right edge. A flex basis with min-width: 0 lets it give way,
       and the label already ellipsises. */
    flex: 0 1 340px; min-width: 0; height: 34px; padding: 0 var(--spacing-300, 12px);
    border: var(--border-width-default, 1px) solid var(--color-border-default, #cecece); border-radius: var(--radius-md, 0.5rem);
    background: var(--color-background-elevation-raised, #fcfcfc); color: var(--color-content-default-muted, #838383);
    /* Kept: a UA reset on a native <button>, not a type role — the rest of the type
       comes from .typography-body-sm on this element. */
    font-family: inherit;
    cursor: pointer; transition: border-color 150ms ease;
  }
  .esa-app-shell__search:hover { border-color: var(--color-border-default-strong, #bbbbbb); }
  .esa-app-shell__search:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }
  /* clip/visible, not `overflow: hidden` — the search button carries a microcopy
     composite, whose line-height `none` (1) leaves the line box 1em against DM Sans's
     1.30em glyph box, so hiding the Y axis clips the descenders in a placeholder like
     "Search sites and permits…". Same fix as esa-file-list's .file__name, where the
     arithmetic is written out. */
  .esa-app-shell__search-label { flex: 1; text-align: left; overflow-x: clip; overflow-y: visible; text-overflow: ellipsis; white-space: nowrap; }
  .esa-app-shell__search-kbd {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    min-width: 18px; height: 18px; padding: 0 5px;
    border: var(--border-width-default, 1px) solid var(--color-border-default, #cecece); border-radius: var(--radius-sm, 0.25rem);
    background: var(--color-background-elevation-sunken, #f0f0f0);
  }

  /* Logo lockup at the top of the sidenav. */
  .esa-app-shell__brand {
    display: inline-flex; align-items: center; gap: var(--spacing-200, 8px);
    padding: var(--spacing-100, 4px); text-decoration: none;
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-content-default, #202020);
    transition: background 150ms ease;
  }
  .esa-app-shell__brand:hover { background: var(--app-shell-brand-bg-hover, color-mix(in srgb, currentColor 8%, transparent)); }
  /* Collapsed rail: drop the wordmark (it pins the rail open), center the mark. */
  esa-sidebar-nav[collapsed] .esa-app-shell__brand { justify-content: center; padding-inline: 0; }
  esa-sidebar-nav[collapsed] .esa-app-shell__wordmark { display: none; }
  .esa-app-shell__mark { display: inline-flex; flex: none; color: var(--color-content-brand, #2a7e3b); }
  /* Brand, not a type role — the four hooks are tier-3 so a spoke can re-skin the
     wordmark without touching a composite every other component shares. */
  .esa-app-shell__wordmark {
    font-family: var(--typography-font-family-display, var(--typography-font-family-sans, sans-serif));
    font-size: var(--font-size-300, 1.125rem);
    font-weight: var(--typography-font-weight-bold, 650);
    letter-spacing: var(--letter-spacing-tight, -0.01em);
    /* A logotype, not a type role — it names no composite, so leading here is not a
       role being overridden. Flush because leading on a wordmark is meaningless. */
    line-height: var(--line-height-none, 1);
  }

  /* The rail sizes itself (esa-sidebar-nav's :host carries the width and
     `height: 100%`); the frame takes the rest. `min-height: 0` on the frame is
     load-bearing — without it the flex column refuses to shrink below its
     content and `__content` never scrolls, it just overflows the shell. */
  .esa-app-shell__nav { flex: none; }
  .esa-app-shell__frame { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
  .esa-app-shell__content { flex: 1; min-height: 0; overflow-y: auto; padding: var(--spacing-500, 1.5rem); }

  @media (max-width: 720px) {
    .esa-app-shell__search-label, .esa-app-shell__search-kbd { display: none; }
    .esa-app-shell__search { flex: none; width: 34px; padding: 0; justify-content: center; }
  }
</style>
