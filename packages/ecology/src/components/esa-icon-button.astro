---
// esa-icon-button — presentational (.astro).
//
// Icon-only action for toolbars and chrome (search, close, overflow, etc.).
// Lightweight + transparent and INHERITS currentColor, so it lives happily on a
// dark app bar or a light surface. Square footprint on the shared form size
// scale. This is the chrome-grade counterpart to esa-button's heavier `iconOnly`
// mode (which carries a solid color + fixed 40px box).
//
// `label` is REQUIRED — an icon-only control needs an accessible name.
import EsaIcon from './esa-icon.astro';

type EsaSize = 'xs' | 'sm' | 'md' | 'lg';

interface Props {
  /** Lucide icon name. */
  icon: string;
  /** Accessible name (aria-label + title). Required. */
  label: string;
  /** When present, renders an <a>; otherwise a <button>. */
  href?: string;
  size?: EsaSize;
  type?: 'button' | 'submit' | 'reset';
}

const { icon, label, href, size = 'md', type = 'button' } = Astro.props;
const Tag = href ? 'a' : 'button';
const cls = ['esa-icon-button', `esa-icon-button--${size}`].join(' ');
---
<Tag
  class={cls}
  href={href}
  type={href ? undefined : type}
  aria-label={label}
  title={label}
>
  <EsaIcon name={icon} size={size} />
</Tag>

<style>
  .esa-icon-button {
    /* ONE value spends on all four sides. It names the same spacing rung a text
       button's padding-inline does, so the two still agree on a row — but that
       agreement used to be carried by --form-padding-y-* and -x-* being equal
       tokens, and since 2026-08-14 it is carried only by both sites naming
       --spacing-300. If the axes ever need to diverge, this is a site that will
       not follow on its own. */
    --_ib-pad: var(--spacing-300, 0.75rem);
    --_ib-bg-hover: var(--icon-button-bg-hover, color-mix(in srgb, currentColor 14%, transparent));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Square by ratio, not by a height token. There is no text to set the height,
       so the icon plus this padding IS the size — which is why padding had to be
       ADDED here rather than re-plumbed: at padding:0 the element would collapse
       to the bare icon. Recorded for the batched a11y pass: at xs this lands
       around 32px, under the 44px AAA target though clear of the 24px AA floor. */
    aspect-ratio: 1;
    padding: var(--_ib-pad);
    border: 0;
    border-radius: var(--radius-surface, 8px);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background var(--transition-fast, 150ms ease);
    -webkit-appearance: none;
    appearance: none;
  }
  .esa-icon-button--xs { --_ib-pad: var(--spacing-200, 0.5rem); }
  .esa-icon-button--sm { --_ib-pad: var(--spacing-250, 0.625rem); }
  .esa-icon-button--lg { --_ib-pad: var(--spacing-400, 1rem); }

  .esa-icon-button:hover { background: var(--_ib-bg-hover); }
  .esa-icon-button:focus-visible {
    outline: var(--focus-ring-width) solid currentColor;
    outline-offset: var(--focus-ring-offset, 2px);
  }
</style>
