---
// esa-icon-button — DEPRECATED (2026-08-14). Now a shim over esa-button.
//
// Folded into `<EsaButton variant="chrome" iconOnly>`. The only thing this component
// carried that button could not was "take your color FROM context instead of owning
// one" — which is now the `chrome` variant. Keeping a second file for that meant
// maintaining a parallel API (six props already spelled the same as button's) for
// three CSS declarations. See docs/button-consolidation-plan.md.
//
// This shim exists so spokes do not break at the rename. It forwards everything and
// warns at build time. It is REMOVED once spokes have run /update-tokens
// (migrations.json: icon-button-to-button-chrome).
//
// One thing genuinely lost: `label` was REQUIRED here, enforced by the type system.
// On button it can only be a build-time warning, because the label is a slot and a
// boolean flag cannot make a sibling prop mandatory. See the warning in esa-button.
import EsaButton from './esa-button.astro';

type EsaSize = 'xs' | 'sm' | 'md' | 'lg';

interface Props {
  /** Lucide icon name. */
  icon: string;
  /** Accessible name (aria-label + title). Required. */
  label: string;
  /** When present, renders an <a>; otherwise a <button>. */
  href?: string;
  size?: EsaSize;
  type?: 'button' | 'submit' | 'reset';
  [attr: string]: unknown;
}

const { icon, label, href, size = 'md', type = 'button', ...rest } = Astro.props;

console.warn(
  `⚠️  esa-icon-button is deprecated — replaced by \`<EsaButton variant="chrome" iconOnly ` +
    `icon="${icon}" label="${label}" />\`. Run \`node ../ecology/scripts/migrate-tokens.mjs --write\` ` +
    `in your spoke (migrations.json: icon-button-to-button-chrome).`,
);
---
<EsaButton variant="chrome" iconOnly icon={icon} label={label} href={href} size={size} type={type} {...rest} />
