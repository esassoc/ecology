---
// esa-loading-overlay — presentational (.astro).
// Faithful translation of the Angular esa-loading-overlay: covers its positioned
// parent with a spinner (lg) and an optional message when `active`; `transparent`
// switches the opaque backdrop to a semi-transparent one. Angular host classes +
// @if(active) → class list + conditional render. The spinner markup is inlined
// (mirrors esa-loading-spinner size="lg"). Place inside a `position: relative`
// container so the absolute backdrop fills it.
//
// A11Y: the spinner used to carry `role="status" aria-label="Loading"` while `message`
// rendered in a <p> OUTSIDE it. Two failures in one line. `role="status"` is a live
// region, and a live region announces CHANGES to its contents — the spinner span is
// permanently empty, so it never announced anything. And the one piece of real text
// was outside the region, so even a working region would not have read it.
//
// Now the backdrop is a single named graphic (`role="img"` + the message as its name)
// with `aria-busy`, and the visual content is `aria-hidden` so the name is not read
// twice. Persistent and re-readable, which a live region is not.
//
// This does NOT announce when loading starts or finishes — this component cannot know
// that, because `active` is a build-time prop with no client runtime here. Whatever
// owns the loading state calls `announce()` (../announcer.ts) at both edges.
interface Props {
  active?: boolean;
  message?: string;
  transparent?: boolean;
}
const { active = false, message, transparent = false } = Astro.props;

// TYPE: the status message is short prose under the spinner — `body-sm`. The import is
// the Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const cls = ['esa-loading-overlay', transparent && 'esa-loading-overlay--transparent']
  .filter(Boolean)
  .join(' ');
---
<div class={cls}>
  {active && (
    <div
      class="esa-loading-overlay__backdrop"
      role="img"
      aria-label={message || 'Loading'}
      aria-busy="true"
    >
      {/* The spinner is decorative HERE — the backdrop above already carries the
          name. Two names for one state is noise. */}
      <div class="esa-loading-overlay__content" aria-hidden="true">
        <span class="esa-loading-overlay__spinner"></span>
        {message && <p class="esa-loading-overlay__message typography-body-sm">{message}</p>}
      </div>
    </div>
  )}
</div>

<style>
  .esa-loading-overlay {
    display: contents;
  }

  .esa-loading-overlay__backdrop {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--loading-overlay-bg, var(--color-background-elevation-raised, #fff));
    z-index: 10;
  }

  .esa-loading-overlay--transparent .esa-loading-overlay__backdrop {
    background: var(--loading-overlay-bg-transparent, rgba(255, 255, 255, 0.8));
  }

  .esa-loading-overlay__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
  }

  /* Inlined large spinner (mirrors esa-loading-spinner size="lg") — shares the
     --loading-spinner-* hooks so both retint together. */
  .esa-loading-overlay__spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--loading-spinner-track-color, var(--color-border-default-subtle, #efefef));
    border-top-color: var(--loading-spinner-color, var(--color-background-brand, #43608a));
    border-radius: var(--radius-pill, 9999px);
    animation: esa-overlay-spinner-rotate var(--animation-spin, 750ms linear infinite);
    box-sizing: border-box;
  }

  @keyframes esa-overlay-spinner-rotate {
    to { transform: rotate(360deg); }
  }

  .esa-loading-overlay__message {
    margin: 0;
    color: var(--loading-overlay-message-color, var(--color-content-default-secondary, #525252));
    text-align: center;
  }
</style>
