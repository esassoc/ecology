---
// esa-danger-zone — presentational (.astro).
// Faithful translation of Beacon's ui-danger-zone: a bordered section that
// corrals destructive action(s) behind clear danger-colored chrome so a
// misclick isn't a zero-effort accident. Angular `heading`/`description`
// inputs → props; Angular <ng-content> → the default slot (the actions).
// Per the project rule, no colored LEFT border — danger emphasis comes from
// a danger-tinted heading, subtle danger background, and a full danger border.
interface Props {
  heading?: string;
  description?: string;
}
const { heading = 'Danger Zone', description } = Astro.props;

// TYPE: `title-sm-strong` on the heading, `body-md` on the explanatory prose — roles,
// not five assembled property tokens. The slot region takes `label-md`: the prose of
// this component is the `description` prop above it, and the slot is the destructive
// action(s) the whole box exists to corral — a row of buttons, not a second paragraph.
// Slotted content inherits it as a default; an esa-button brings its own and wins.
// The import is the Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

let nextId = 0;
const headingId = `esa-danger-zone-heading-${++nextId}`;
---
<section class="esa-danger-zone" role="group" aria-labelledby={headingId}>
  <h3 class="esa-danger-zone__heading typography-title-sm-strong" id={headingId}>{heading}</h3>
  {description && <p class="esa-danger-zone__description typography-body-md">{description}</p>}
  <div class="esa-danger-zone__actions typography-label-md">
    <slot />
  </div>
</section>

<style>
  .esa-danger-zone {
    --_dz-bg: var(--color-background-utility-danger-subtle, #fff7f7);
    --_dz-border: var(--color-border-utility-danger, #fdbdbe);
    --_dz-heading-color: var(--color-content-utility-danger);
    --_dz-description-color: var(--color-content-default-secondary, #646464);
    --_dz-radius: var(--radius-md, 0.5rem);
    --_dz-padding: var(--spacing-300, 0.75rem);
    --_dz-gap: var(--spacing-200, 0.5rem);

    display: flex;
    flex-direction: column;
    gap: var(--_dz-gap);
    padding: var(--_dz-padding);
    border: var(--border-width-default, 1px) solid var(--_dz-border);
    border-radius: var(--_dz-radius);
    background: var(--_dz-bg);
  }

  .esa-danger-zone__heading {
    margin: 0;
    color: var(--_dz-heading-color);
  }

  .esa-danger-zone__description {
    margin: 0;
    color: var(--_dz-description-color);
  }

  .esa-danger-zone__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--_dz-gap);
  }
</style>
