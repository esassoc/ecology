---
// esa-header-nav — presentational top app bar (.astro).
//
// A data-driven convenience SET, now composed from the chrome bricks rather than
// re-implementing them:
//   esa-app-bar      → the bar shell + start/main/end slots + tone
//   esa-icon-link    → plain nav links
//   esa-nav-dropdown → items with children (native <details>, zero JS)
//   esa-avatar       → the user menu's trigger face
// The user menu's DISCLOSURE stays bespoke here (an avatar-triggered menu is
// set-specific, not a generic brick), but the avatar inside it no longer is: it
// used to be a hand-rolled img/initials circle, which meant --header-nav-avatar-*
// was a second implementation of what esa-avatar already owns via --avatar-*.
// Those three tokens now ALIAS the avatar's own, scoped to the trigger — the
// spoke-facing hooks are unchanged, the duplicate markup is gone. `icon` on an
// item is a Lucide name (passed straight to esa-icon-link), consistent with the
// rest of the system.
//
// For full control, compose esa-app-bar + the bricks directly (see cb-fish-design's
// cbf-public-nav, or the App Bar specimen). This component is the batteries-included
// shortcut for the common brand · nav · user shape.
import EsaAppBar from './esa-app-bar.astro';
import EsaButton from './esa-button.astro';
import EsaNavDropdown from './esa-nav-dropdown.astro';
import EsaIcon from './esa-icon.astro';
import EsaAvatar from './esa-avatar.astro';
// Menu rows and user-menu actions are navigation text (`body-md`); the account name
// is the one emphasised label in the dropdown, its email the quiet line under it.
// The brand and actions slot containers name `label-md` — bar chrome, the same role
// esa-app-bar puts on its own start/main/end wrappers. Stating it here makes the
// default local to the slot rather than something inherited from a parent component.
// The import is the Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

export interface EsaHeaderNavItem {
  label: string;
  href?: string;
  /** Lucide icon name (esa-icon). */
  icon?: string;
  children?: EsaHeaderNavItem[];
}
export interface EsaHeaderNavUser {
  name: string;
  email?: string;
  avatarUrl?: string;
  initials?: string;
}
interface Props {
  items?: EsaHeaderNavItem[];
  user?: EsaHeaderNavUser;
  /**
   * Accessible name for the navigation landmark wrapping `items`. Do NOT include
   * the word "navigation" — the role is announced already, so this reads as
   * "Main, navigation".
   */
  navLabel?: string;
}
const { items = [], user, navLabel = 'Main' } = Astro.props;

function initialsFor(u: EsaHeaderNavUser): string {
  if (u.initials) return u.initials;
  return u.name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---
<EsaAppBar tone="surface" as="header" class="esa-header-nav">
  <div slot="start" class="esa-header-nav__brand typography-label-md"><slot name="brand" /></div>

  {/* The links go inside a REAL <nav>. Until 2026-08-18 they sat loose in the bar's
      default slot, so this component — the primary site navigation on most pages —
      exposed a `banner` full of links and NO navigation landmark at all. Landmark
      navigation (NVDA's D, VoiceOver's rotor) found nothing to jump to, which is
      the first thing a screen reader user reaches for. `banner` > `navigation` is
      the standard nesting; the bar keeps `as="header"`. */}
  {items.length > 0 && (
    <nav class="esa-header-nav__items" aria-label={navLabel}>
      {items.map((item) =>
        item.children && item.children.length ? (
          <EsaNavDropdown label={item.label} icon={item.icon}>
            <ul class="esa-header-nav__menu" role="list">
              {item.children.map((child) => (
                <li>
                  {child.href ? (
                    <a class="esa-header-nav__menu-item typography-body-md" href={child.href}>{child.label}</a>
                  ) : (
                    <span class="esa-header-nav__menu-item esa-header-nav__menu-item--inert typography-body-md">{child.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </EsaNavDropdown>
        ) : (
          <EsaButton variant="chrome" href={item.href} icon={item.icon}>{item.label}</EsaButton>
        )
      )}
    </nav>
  )}

  <Fragment slot="end">
    {Astro.slots.has('actions') && (
      <span class="esa-header-nav__actions typography-label-md"><slot name="actions" /></span>
    )}

    {user && (
      <details class="esa-header-nav__user">
        <summary class="esa-header-nav__avatar-btn" aria-label={`User menu for ${user.name}`}>
          <EsaAvatar name={user.name} src={user.avatarUrl} initials={initialsFor(user)} size="sm" />
        </summary>
        <div class="esa-header-nav__user-dropdown">
          <div class="esa-header-nav__user-info">
            <span class="esa-header-nav__user-name typography-label-md-strong">{user.name}</span>
            {user.email && <span class="esa-header-nav__user-email typography-body-xs">{user.email}</span>}
          </div>
          <div class="esa-header-nav__user-actions">
            <a class="esa-header-nav__user-action typography-body-md" href="#profile"><EsaIcon name="user" size="sm" /><span>Profile</span></a>
            <a class="esa-header-nav__user-action typography-body-md" href="#settings"><EsaIcon name="settings" size="sm" /><span>Settings</span></a>
            <div class="esa-header-nav__user-divider"></div>
            <a class="esa-header-nav__user-action esa-header-nav__user-action--danger typography-body-md" href="#logout"><span>Log out</span></a>
          </div>
        </div>
      </details>
    )}
  </Fragment>
</EsaAppBar>

<style>
  /* The .esa-header-nav class lands on esa-app-bar's root (a child component), so
     it doesn't carry this file's scope hash — target it with :global. The border
     sits on the bar itself.

     THREE INERT DECLARATIONS WERE REMOVED FROM THIS RULE ON 2026-08-18 —
     --app-bar-{gap,pad-x,pad-y}, asking for a COMPACT bar (12px gap, 24px/6px
     padding). They stopped doing anything on 2026-08-16 when the tier-3 demotion
     pass deleted those hooks (migrations.json: app-bar-hooks-removed); the codemod
     rewrote reads and cannot rewrite declarations, so these were left behind
     looking deliberate while resolving to nothing. This bar has rendered at the
     app-bar's own 32px gap and 32px/16px padding ever since.

     If the compact bar is still wanted it is an esa-app-bar DENSITY VARIANT, not a
     re-added hook — esa-app-shell was asking for the same thing, and two callers
     wanting one treatment is the definition of a variant. See SPEC.md's
     "WOULD this component diverge, not COULD it". */
  :global(.esa-header-nav) {
    border-bottom: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }
  .esa-header-nav__brand { display: inline-flex; align-items: center; }

  /* The <nav> wrapper added for the landmark is one flex CHILD of the bar's main
     region where the links used to be N children, so it has to re-create the row
     itself or they stack. It uses the same step the bar itself applies
     (--spacing-600), so wrapping the links in a landmark changed no spacing.
     Keep the two in step: if esa-app-bar ever gains a density variant, this gap
     has to follow it or the nav items will sit at 32px inside a 12px bar. */
  .esa-header-nav__items {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-600, 32px);
    min-width: 0;
  }
  .esa-header-nav__actions { display: inline-flex; align-items: center; gap: var(--spacing-200, 8px); }

  /* Dropdown menu list (rendered inside esa-nav-dropdown's panel) */
  .esa-header-nav__menu { list-style: none; margin: 0; padding: 0; min-width: 180px; }
  .esa-header-nav__menu-item {
    display: block;
    padding: var(--spacing-150, 6px) var(--spacing-300, 12px);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-content-default-secondary, #646464);
    text-decoration: none;
  }
  .esa-header-nav__menu-item:hover { background: var(--color-background-elevation-sunken, #f0f0f0); }
  .esa-header-nav__menu-item--inert { color: var(--color-content-default-secondary, #646464); }

  /* User menu (the DISCLOSURE is bespoke; the avatar inside it is esa-avatar) */
  .esa-header-nav__user { position: relative; display: flex; align-items: center; }
  .esa-header-nav__avatar-btn {
    /* The three --header-nav-avatar-* hooks are kept and re-pointed at the
       avatar's own tokens, scoped to this trigger. Nothing global moves: a spoke
       still themes this face through the header-nav names it already knows, and
       an --avatar-* override elsewhere on the page is unaffected. This is also
       what makes the swap a no-op — 32px is not a step on the avatar's
       20/28/40/56 scale, and the brand fill is not its name-hash hue, so both
       arrive as scoped overrides rather than as compromises. */
    --avatar-size-sm: var(--header-nav-avatar-size, 32px);
    --avatar-bg: var(--color-background-brand, #46a758);
    --avatar-text-color: var(--color-content-default-knockout, #fcfcfc);
    --avatar-font-size-sm: var(--font-size-100, 0.75rem);

    /* The summary is now only the focusable trigger — the avatar draws the
       circle, so width/height/radius/background/overflow all moved to it. */
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; list-style: none;
  }
  .esa-header-nav__avatar-btn::-webkit-details-marker { display: none; }
  .esa-header-nav__avatar-btn:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .esa-header-nav__user-dropdown {
    position: absolute; top: calc(100% + var(--spacing-100, 4px)); right: 0;
    z-index: var(--z-dropdown, 50);
    min-width: 220px;
    background: var(--color-background-elevation-raised, #fcfcfc);
    border: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
    border-radius: var(--radius-md, 0.5rem);
    box-shadow: var(--elevation-4, 0 6px 24px -6px rgba(0, 0, 0, 0.07));
    overflow: hidden;
  }
  .esa-header-nav__user-info {
    display: flex; flex-direction: column; gap: 2px;
    padding: var(--spacing-300, 12px) var(--spacing-400, 16px);
    border-bottom: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
  }
  .esa-header-nav__user-name { color: var(--color-content-default, #202020); }
  .esa-header-nav__user-email { color: var(--color-content-default-secondary, #646464); }
  .esa-header-nav__user-actions { padding: var(--spacing-100, 4px); }
  .esa-header-nav__user-action {
    display: flex; align-items: center; gap: var(--spacing-200, 8px);
    padding: var(--spacing-150, 6px) var(--spacing-300, 12px);
    border-radius: var(--radius-sm, 0.25rem);
    color: var(--color-content-default-secondary, #646464);
    text-decoration: none;
  }
  .esa-header-nav__user-action:hover { background: var(--color-background-elevation-sunken, #f0f0f0); }
  .esa-header-nav__user-action--danger { color: var(--color-content-utility-danger, #ce2c31); }
  .esa-header-nav__user-divider { height: 1px; margin: var(--spacing-100, 4px) 0; background: var(--color-border-default, #cecece); }
</style>
