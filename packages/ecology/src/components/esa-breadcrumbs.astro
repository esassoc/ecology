---
// esa-breadcrumbs — presentational breadcrumb trail (.astro).
// Faithful translation of the Angular esa-breadcrumbs: same item shape, size
// variants, separator icon, and "last item = current page" semantics.
// Angular host classes → class list; Angular @for/@if → JS map + conditionals.
// Lucide icons are inlined as SVG (chevron-right separator by default).
export interface EsaBreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}
interface Props {
  items: EsaBreadcrumbItem[];
  size?: 'xs' | 'sm' | 'md' | 'lg';
}
const { items, size = 'md' } = Astro.props;

// A crumb is navigation text: the link steps are `body-*`, the current page is the
// same rung at label weight (medium). The import is the Astro half of the composite
// mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const ITEM_TYPE = { xs: 'body-xs', sm: 'body-sm', md: 'body-md', lg: 'body-lg' } as const;
const CURRENT_TYPE = { xs: 'label-xs', sm: 'label-sm', md: 'label-md', lg: 'label-lg' } as const;

// The size modifier no longer carries a font-size — that rung comes from the maps
// above — but it stays on the element as a spoke-facing hook.
const cls = ['esa-breadcrumbs', `esa-breadcrumbs--${size}`].join(' ');
---
<nav class={cls} aria-label="Breadcrumb">
  <ol class="esa-breadcrumbs__list">
    {items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li class="esa-breadcrumbs__item" aria-current={last ? 'page' : undefined}>
          {!last && item.href ? (
            <a href={item.href} class={`esa-breadcrumbs__link typography-${ITEM_TYPE[size]}`}>
              {item.icon && <span class="esa-breadcrumbs__icon" set:html={item.icon} />}
              {item.label}
            </a>
          ) : (
            <span class={`esa-breadcrumbs__current typography-${CURRENT_TYPE[size]}`}>
              {item.icon && <span class="esa-breadcrumbs__icon" set:html={item.icon} />}
              {item.label}
            </span>
          )}
          {!last && (
            <svg
              class="esa-breadcrumbs__separator"
              width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .esa-breadcrumbs {
    --_crumb-link-color: var(--breadcrumbs-link-color, #646464);
    --_crumb-link-hover: var(--breadcrumbs-link-hover, #202020);
    --_crumb-current-color: var(--color-content-default, #202020);
    --_crumb-separator-color: var(--color-border-default-strong, #bbbbbb);
    --_crumb-gap: var(--spacing-200, 8px);

    display: block;
    background: var(--breadcrumbs-bg, transparent);
  }

  .esa-breadcrumbs__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--_crumb-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .esa-breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: var(--_crumb-gap);
  }

  .esa-breadcrumbs__link,
  .esa-breadcrumbs__current {
  }

  .esa-breadcrumbs__link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 4px);
    color: var(--_crumb-link-color);
    /* Transparent, not `none` — text-decoration-color is force-adjusted, so the
       underline reappears in forced colors and the clickable crumbs stay
       separable from the current one. (They also differ by type role: links are
       body-*, current is label-*, which carries a weight delta that survives.) */
    text-decoration-color: transparent;
  }
  .esa-breadcrumbs__link:hover {
    color: var(--_crumb-link-hover);
    text-decoration: underline;
  }

  .esa-breadcrumbs__current {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 4px);
    color: var(--_crumb-current-color);
  }

  .esa-breadcrumbs__icon {
    display: inline-flex;
    align-items: center;
  }

  .esa-breadcrumbs__separator {
    flex-shrink: 0;
    color: var(--_crumb-separator-color);
  }
</style>
