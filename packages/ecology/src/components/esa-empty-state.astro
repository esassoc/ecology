---
// esa-empty-state — presentational (.astro).
// Faithful translation of the Angular esa-empty-state: optional icon, required title,
// optional description, slotted actions, and xs/sm/md/lg size variants.
// Angular host classes → class list; @if → conditional render; required title input
// → required `title` prop. The icon prop names a Lucide icon; pass an inline SVG via
// the "icon" slot for full fidelity, or omit it.
interface Props {
  /** What is absent, stated as a fact — "No results", "No documents yet". */
  title: string;
  /**
   * One imperative recovery action, ≤12 words — the thing the user can do to
   * make the list non-empty. "Try a different keyword." "Clear the Type filter."
   * Not a description of the missing feature, not an explanation of what the
   * view would contain, and never a note about the state of the work.
   */
  description?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
}
const { title, description, size = 'md' } = Astro.props;

// TYPE: the size variants pick a ROLE per step rather than a bare font-size, so the
// weight and line-height travel with it. The action slot takes a flat `label-md` — it
// holds buttons, whose own composite wins, so it is a default for bare markup rather
// than a step on the ramp. The "icon" slot is deliberately UNWIRED: it holds an SVG,
// and a type role on a glyph is a value nothing reads. The import is the Astro half of
// the composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

// `lg` is medium where the other three are semibold — every `title-strong` call site
// moved to `title`, and this ramp's top rung came with it. Noted, not hidden.
const TITLE_TYPE = { xs: 'label-xs-strong', sm: 'label-sm-strong', md: 'label-md-strong', lg: 'title' } as const;
const DESC_TYPE = { xs: 'body-xs', sm: 'body-xs', md: 'body-sm', lg: 'body-md' } as const;

const hasIconSlot = Astro.slots.has('icon');
const cls = ['esa-empty-state', `esa-empty-state--${size}`].join(' ');
---
<div class={cls}>
  {hasIconSlot && (
    <div class="esa-empty-state__icon">
      <slot name="icon" />
    </div>
  )}
  <h3 class={`esa-empty-state__title typography-${TITLE_TYPE[size]}`}>{title}</h3>
  {description && <p class={`esa-empty-state__description typography-${DESC_TYPE[size]}`}>{description}</p>}
  <div class="esa-empty-state__actions typography-label-md">
    <slot />
  </div>
</div>

<style>
  .esa-empty-state {
    --_empty-icon-size: var(--empty-state-icon-size-md, 48px);
    --_empty-gap: var(--spacing-200, 0.5rem);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-600, 2rem) var(--spacing-400, 1rem);
    gap: var(--_empty-gap);
  }

  /* Size ladders carry the icon size and padding only — the type steps live in
     TITLE_TYPE / DESC_TYPE above, one composite per step. */
  .esa-empty-state--xs {
    --_empty-icon-size: var(--empty-state-icon-size-xs, 24px);
    padding: var(--spacing-300, 0.75rem) var(--spacing-200, 0.5rem);
  }

  .esa-empty-state--sm {
    --_empty-icon-size: var(--empty-state-icon-size-sm, 32px);
    padding: var(--spacing-400, 1rem) var(--spacing-300, 0.75rem);
  }

  .esa-empty-state--lg {
    --_empty-icon-size: var(--empty-state-icon-size-lg, 64px);
    padding: var(--spacing-800, 4rem) var(--spacing-400, 1rem);
  }

  .esa-empty-state__icon {
    color: var(--color-content-default-secondary, #646464);
    margin-bottom: var(--spacing-100, 0.25rem);
    display: inline-flex;
  }

  .esa-empty-state__icon :global(svg) {
    width: var(--_empty-icon-size);
    height: var(--_empty-icon-size);
  }

  .esa-empty-state__title {
    margin: 0;
    color: var(--color-content-default, #202020);
  }

  .esa-empty-state__description {
    margin: 0;
    color: var(--color-content-default-secondary, #646464);
    max-width: 360px;
  }

  .esa-empty-state__actions {
    margin-top: var(--spacing-200, 0.5rem);
  }

  .esa-empty-state__actions:empty {
    display: none;
  }
</style>
