---
// esa-icon-link — DEPRECATED (2026-08-14). Now a shim over esa-button.
//
// Folded into `<EsaButton variant="chrome">`. This component shared SIX prop names
// and meanings with esa-button already (href, icon, iconRight, size, active, type)
// and had independently been through its own rename churn (trailing → iconRight,
// mirroring button's own color → variant). See docs/button-consolidation-plan.md.
//
// Two mappings are not one-to-one, and are the reason this shim is not a pass-through:
//
//   active → current   `active` meant "this is the current nav item" here and emitted
//                      aria-current. On button `active` means "this toggle is pressed"
//                      and emits aria-pressed. Those are different claims — a nav link
//                      announced as a depressed toggle is worse than an unlabelled one
//                      — so button grew a separate `current` prop and this maps onto it.
//
//   weight → dropped   button takes type from the typography-label-* composites and
//                      forbids declaring font-weight (Astro's [data-astro-cid-*]
//                      scoping outranks the composite's single-class selector, so a
//                      stray declaration wins silently instead of layering). An audit
//                      found `weight` passed ZERO times anywhere, so it is dropped
//                      rather than reconstructed. Passing it now warns.
//
// It is REMOVED once spokes have run /update-tokens
// (migrations.json: icon-link-to-button-chrome).
import EsaButton from './esa-button.astro';

type EsaIconLinkSize = 'sm' | 'md';

interface Props {
  /** When present, renders an <a>; otherwise a <button> trigger. */
  href?: string;
  /** Leading Lucide icon name. */
  icon?: string;
  /** Lucide icon to the RIGHT of the label — the dropdown/disclosure affordance (e.g. "chevron-down"). */
  iconRight?: string;
  /** DEPRECATED — renamed to `iconRight`. Still honoured; warns at build time. */
  trailing?: string;
  /** sm = 14px (sub-bars), md = 16px (primary bars). */
  size?: EsaIconLinkSize;
  /** Selected / current state. Maps to esa-button's `current` (aria-current). */
  active?: boolean;
  /** DEPRECATED — no longer honoured; type comes from the label composite. */
  weight?: 'regular' | 'medium' | 'semibold';
  /** Native button type when rendered as <button>. */
  type?: 'button' | 'submit' | 'reset';
  /** Override the element. 'summary' makes it a disclosure trigger inside <details>. */
  tag?: 'a' | 'button' | 'summary';
  [attr: string]: unknown;
}

const {
  href,
  icon,
  iconRight,
  trailing: deprecatedTrailing,
  size = 'md',
  active = false,
  weight,
  type = 'button',
  tag,
  ...rest
} = Astro.props;

const resolvedIconRight = iconRight ?? deprecatedTrailing;

console.warn(
  `⚠️  esa-icon-link is deprecated — replaced by \`<EsaButton variant="chrome" />\`. ` +
    `Run \`node ../ecology/scripts/migrate-tokens.mjs --write\` in your spoke ` +
    `(migrations.json: icon-link-to-button-chrome).`,
);
if (weight) {
  console.warn(
    `⚠️  esa-icon-link: \`weight="${weight}"\` is no longer honoured. esa-button takes its ` +
      `type from the typography-label-* composites, which own font-weight. Remove the prop.`,
  );
}
---
<EsaButton
  variant="chrome"
  href={href}
  icon={icon}
  iconRight={resolvedIconRight}
  size={size}
  current={active}
  type={type}
  tag={tag}
  {...rest}
><slot /></EsaButton>
