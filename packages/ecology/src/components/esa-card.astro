---
// esa-card — presentational (.astro).
// Faithful translation of the Angular esa-card: variant / headerVariant / padding
// host classes, header (icon + title + subtitle), body and optional footer.
// Angular TemplateRef inputs (header/actions/footer) → Astro named slots
// ("header", "actions", "footer"); the default slot is the body.
// Angular @if → conditional render here.
interface Props {
  /** What the card is — the name of the record, section, or metric it holds. */
  title?: string;
  /**
   * A short datum qualifying the title: a count, a date range, a status, an id
   * — "Across 14 monitored sites", "Next two weeks", "401 Water Quality
   * Certification". Never a sentence, and never a gloss explaining the card's
   * contents to its reader; the card's body is what says that.
   */
  subtitle?: string;
  icon?: string;
  variant?: 'default' | 'outlined' | 'elevated' | 'filled';
  headerVariant?: 'default' | 'primary' | 'muted';
  padding?: 'none' | 'compact' | 'default' | 'spacious';
}
const {
  title,
  subtitle,
  icon,
  variant = 'default',
  headerVariant = 'default',
  padding = 'default',
} = Astro.props;

// TYPE: the header names roles rather than assembling them — `title-sm-strong` on the
// card title, `body-sm` on the subtitle. The import is the Astro half of the composite
// mechanism; Lit siblings get it via `static styles = [typography, …]`.
//
// The four SLOT containers name a role too, so slotted content lands on a composite by
// inheritance instead of on whatever the host page happens to set. It is a default, not
// a dictate — any esa-* slotted in carries its own class and wins. Body → `body-md`;
// actions → `label-md`, the chrome band that holds buttons. Footer → `meta`, NOT the
// chrome default: a card footer carries a timestamp or a count, which is the thing
// `meta` is named for, and setting that in medium made it louder than the title above it.
// The header's role is applied ONLY when the header slot is filled: the slot replaces
// .esa-card__title, so it inherits that title's role. On the default path the title and
// subtitle already name their own, and a class there would be inherited by nothing.
import '@esa/tokens/typography.css';

const hasHeaderSlot = Astro.slots.has('header');
const hasActionsSlot = Astro.slots.has('actions');
const hasFooterSlot = Astro.slots.has('footer');
const showHeader = !!title || hasHeaderSlot || hasActionsSlot;

const cls = [
  'esa-card',
  variant !== 'default' && `esa-card--${variant}`,
  headerVariant !== 'default' && `esa-card--header-${headerVariant}`,
  padding !== 'default' && `esa-card--padding-${padding}`,
]
  .filter(Boolean)
  .join(' ');
---
<div class={cls}>
  {showHeader && (
    <div class:list={['esa-card__header', hasHeaderSlot && 'typography-title-sm-strong']}>
      {hasHeaderSlot ? (
        <slot name="header" />
      ) : (
        <>
          <div class="esa-card__header-content">
            {icon && (
              <svg
                class="esa-card__icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
              </svg>
            )}
            <div class="esa-card__titles">
              {title && <h3 class="esa-card__title typography-title-sm-strong">{title}</h3>}
              {subtitle && <p class="esa-card__subtitle typography-body-sm">{subtitle}</p>}
            </div>
          </div>
          {hasActionsSlot && (
            <div class="esa-card__actions typography-label-md">
              <slot name="actions" />
            </div>
          )}
        </>
      )}
    </div>
  )}
  <div class="esa-card__body typography-body-md">
    <slot />
  </div>
  {hasFooterSlot && (
    <div class="esa-card__footer typography-meta">
      <slot name="footer" />
    </div>
  )}
</div>

<style>
  .esa-card {
    --_card-bg: var(--card-bg, var(--color-background-elevation-raised, #ffffff));
    --_card-border: var(--card-border-color, var(--color-border-default, #e5e5e5));
    --_card-radius: var(--card-radius, var(--radius-md, 0.5rem));
    --_card-padding: var(--card-padding, var(--spacing-500, 1.5rem));
    --_card-header-bg: var(--card-header-bg, transparent);
    --_card-header-color: var(--card-header-color, var(--color-content-default, #171717));
    --_card-header-border: var(--card-header-border-color, var(--color-border-default-subtle, #efefef));

    display: block;
    background: var(--_card-bg);
    border: var(--border-width-default, 1px) solid var(--_card-border);
    border-radius: var(--_card-radius);
    overflow: hidden;
  }

  /* outlined: explicit (same as default) */
  .esa-card--outlined { --_card-border: var(--color-border-default, #e5e5e5); }

  /* elevated: shadow, no border */
  .esa-card--elevated {
    --_card-border: transparent;
    box-shadow: var(--elevation-2, 0 2px 12px 0 rgba(0, 0, 0, 0.04));
  }

  /* filled: sunken background, no border */
  .esa-card--filled {
    --_card-bg: var(--color-background-elevation-sunken, #efefef);
    --_card-border: transparent;
  }

  .esa-card--header-primary .esa-card__header {
    --_card-header-bg: var(--color-background-brand, #43608a);
    --_card-header-color: var(--color-content-default-knockout, #ffffff);
  }

  .esa-card--header-muted .esa-card__header {
    --_card-header-bg: var(--color-background-elevation-sunken, #efefef);
  }

  .esa-card--padding-none { --_card-padding: 0; }
  .esa-card--padding-compact { --_card-padding: var(--spacing-300, 0.75rem); }
  .esa-card--padding-spacious { --_card-padding: var(--spacing-700, 3rem); }

  .esa-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-400, 1rem) var(--_card-padding);
    background: var(--_card-header-bg);
    color: var(--_card-header-color);
    border-bottom: var(--border-width-default, 1px) solid var(--_card-header-border);
    min-height: 56px;
  }

  .esa-card__header-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
  }

  .esa-card__titles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }

  .esa-card__title {
    margin: 0;
    color: inherit;
  }

  .esa-card__subtitle {
    color: var(--color-content-default-secondary, #525252);
    margin: 0;
  }

  /* On a BRAND header, not a knocked-out one — so this is `content-on-brand`,
     the foreground for that fill, and not a knockout variant. It was
     rgba(255,255,255,0.8): a hardcode that no theme could reach and that stayed
     white however far a spoke moved its brand colour. */
  .esa-card--header-primary .esa-card__subtitle {
    color: var(--color-content-on-brand-secondary, rgba(255, 255, 255, 0.8));
  }

  .esa-card__icon {
    color: inherit;
    flex-shrink: 0;
  }

  .esa-card__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
  }

  .esa-card__body {
    padding: var(--_card-padding);
  }

  .esa-card__footer {
    padding: var(--spacing-300, 0.75rem) var(--_card-padding);
    border-top: var(--border-width-default, 1px) solid var(--_card-header-border);
    background: var(--card-footer-bg, var(--color-background-elevation-sunken, #efefef));
  }
</style>
