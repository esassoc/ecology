---
// esa-card — presentational (.astro).
// Faithful translation of the Angular esa-card: variant / headerVariant / padding
// host classes, header (icon + title + subtitle), body and optional footer.
// Angular TemplateRef inputs (header/actions/footer) → Astro named slots
// ("header", "actions", "footer"); the default slot is the body.
// Angular @if → conditional render here.
//
// `meta` replaces `subtitle` (deprecated 2026-08-16). The free-text line under
// the title took two kinds of fill: a sentence explaining the card to its
// reader, and a row of facts glued together with separators. Pairs admit
// neither — every value arrives with the name of its field, and a sentence has
// no field name to give. Pairs identify the RECORD in the card; the figure the
// card exists to report is a stat (esa-stat), and the card's own body is what
// explains it.
import type { EsaMetaPair } from './_meta';

interface Props {
  /** What the card is — the name of the record, section, or metric it holds. */
  title?: string;
  /** Identifying facts about the record, as {label, value} pairs:
      [{ label: 'Permit', value: 'USACE Section 404' }]. Renders as a definition
      list under the title. A period pair states its calendar. */
  meta?: EsaMetaPair[];
  /**
   * @deprecated Use `meta`. A free-text line under the title cannot say what
   * its facts are, so it filled with sentences and with separator-joined rows.
   * Still renders; migrate a fill to a pair, or delete it when the card's body
   * already carries the fact.
   */
  subtitle?: string;
  icon?: string;
  variant?: 'default' | 'outlined' | 'elevated' | 'filled';
  headerVariant?: 'default' | 'primary' | 'muted';
  padding?: 'none' | 'compact' | 'default' | 'spacious';
}
const {
  title,
  meta,
  subtitle,
  icon,
  variant = 'default',
  headerVariant = 'default',
  padding = 'default',
} = Astro.props;

const hasHeaderSlot = Astro.slots.has('header');
const hasActionsSlot = Astro.slots.has('actions');
const hasFooterSlot = Astro.slots.has('footer');
const hasMeta = !!meta && meta.length > 0;
const showHeader = !!title || hasMeta || hasHeaderSlot || hasActionsSlot;

const cls = [
  'esa-card',
  variant !== 'default' && `esa-card--${variant}`,
  headerVariant !== 'default' && `esa-card--header-${headerVariant}`,
  padding !== 'default' && `esa-card--padding-${padding}`,
]
  .filter(Boolean)
  .join(' ');
---
<div class={cls}>
  {showHeader && (
    <div class="esa-card__header">
      {hasHeaderSlot ? (
        <slot name="header" />
      ) : (
        <>
          <div class="esa-card__header-content">
            {icon && (
              <svg
                class="esa-card__icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
              </svg>
            )}
            <div class="esa-card__titles">
              {title && <h3 class="esa-card__title">{title}</h3>}
              {subtitle && <p class="esa-card__subtitle">{subtitle}</p>}
              {hasMeta && (
                <dl class="esa-card__meta">
                  {meta!.map((pair) => (
                    <div class="esa-card__meta-pair">
                      <dt>{pair.label}</dt>
                      <dd>{pair.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </div>
          {hasActionsSlot && (
            <div class="esa-card__actions">
              <slot name="actions" />
            </div>
          )}
        </>
      )}
    </div>
  )}
  <div class="esa-card__body">
    <slot />
  </div>
  {hasFooterSlot && (
    <div class="esa-card__footer">
      <slot name="footer" />
    </div>
  )}
</div>

<style>
  .esa-card {
    --_card-bg: var(--card-bg, var(--color-surface, #ffffff));
    --_card-border: var(--card-border-color, var(--color-border, #e5e5e5));
    --_card-radius: var(--card-radius, var(--radius-300, 0.5rem));
    --_card-padding: var(--card-padding, var(--spacing-500, 1.5rem));
    --_card-header-bg: var(--card-header-bg, transparent);
    --_card-header-color: var(--card-header-color, var(--color-text-primary, #171717));
    --_card-header-border: var(--card-header-border-color, var(--color-border-light, #efefef));
    --_card-meta-label-color: var(--card-meta-label-color, var(--color-text-secondary, #525252));
    --_card-meta-label-size: var(--card-meta-label-size, var(--type-size-150, 0.875rem));
    --_card-meta-value-size: var(--card-meta-value-size, var(--type-size-200, 0.9375rem));

    display: block;
    background: var(--_card-bg);
    border: 1px solid var(--_card-border);
    border-radius: var(--_card-radius);
    overflow: hidden;
  }

  /* outlined: explicit (same as default) */
  .esa-card--outlined { --_card-border: var(--color-border, #e5e5e5); }

  /* elevated: shadow, no border */
  .esa-card--elevated {
    --_card-border: transparent;
    box-shadow: var(--shadow-100, 0 2px 12px 0 rgba(0, 0, 0, 0.04));
  }

  /* filled: sunken background, no border */
  .esa-card--filled {
    --_card-bg: var(--color-surface-sunken, #efefef);
    --_card-border: transparent;
  }

  .esa-card--header-primary .esa-card__header {
    --_card-header-bg: var(--color-primary, #43608a);
    --_card-header-color: var(--color-text-inverse, #ffffff);
  }

  .esa-card--header-muted .esa-card__header {
    --_card-header-bg: var(--color-surface-sunken, #efefef);
  }

  .esa-card--padding-none { --_card-padding: 0; }
  .esa-card--padding-compact { --_card-padding: var(--spacing-300, 0.75rem); }
  .esa-card--padding-spacious { --_card-padding: var(--spacing-700, 3rem); }

  .esa-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-400, 1rem) var(--_card-padding);
    background: var(--_card-header-bg);
    color: var(--_card-header-color);
    border-bottom: 1px solid var(--_card-header-border);
    min-height: 56px;
  }

  .esa-card__header-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
  }

  .esa-card__titles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }

  .esa-card__title {
    font-size: var(--type-size-250, 1.0625rem);
    font-weight: 600;
    margin: 0;
    color: inherit;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
  }

  .esa-card__subtitle {
    font-size: var(--type-size-150, 0.8125rem);
    color: var(--color-text-secondary, #525252);
    margin: 0;
  }

  .esa-card--header-primary .esa-card__subtitle {
    color: rgba(255, 255, 255, 0.8);
  }

  /* meta — labeled pairs under the title. Each pair keeps its label beside its
     value on one line; pairs wrap as a set. */
  /* The gap BETWEEN pairs has to beat the gap inside one, or the reader has to
     work out which value belongs to which label — the failure the pair exists
     to prevent. */
  .esa-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100, 0.25rem) var(--spacing-500, 1.5rem);
    margin: var(--spacing-050, 0.125rem) 0 0;
  }

  .esa-card__meta-pair {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-100, 0.25rem);
    min-width: 0;
  }

  .esa-card__meta dt {
    font-size: var(--_card-meta-label-size);
    font-weight: var(--font-weight-medium, 500);
    color: var(--_card-meta-label-color);
  }

  .esa-card__meta dd {
    margin: 0;
    font-size: var(--_card-meta-value-size);
    color: inherit;
  }

  .esa-card--header-primary .esa-card__meta dt {
    color: rgba(255, 255, 255, 0.8);
  }

  .esa-card__icon {
    color: inherit;
    flex-shrink: 0;
  }

  .esa-card__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
  }

  .esa-card__body {
    padding: var(--_card-padding);
  }

  .esa-card__footer {
    padding: var(--spacing-300, 0.75rem) var(--_card-padding);
    border-top: 1px solid var(--_card-header-border);
    background: var(--card-footer-bg, var(--color-surface-sunken, #efefef));
  }
</style>
