---
// esa-page-header — presentational page top (.astro).
// The standard prototype page header: optional breadcrumbs OR an eyebrow (with
// an optional leading icon), a title (`heading-lg` by default, or the oversized
// `display` via prominence="display"), an optional lede at `body-lg` in
// secondary text, and a right-aligned actions slot. Replaces both
// the bespoke .x__head / .x__title / .x__lede / .x__cta cluster every prototype
// re-implements AND the per-spoke "hero header" (eyebrow + icon + big title).
//
// Container stays neutral — no background of its own (transparent); color is
// the consumer's job. Private --_* tokens read public semantic tokens with a
// literal fallback, mirroring esa-badge / esa-card.
//
// Slots: "breadcrumbs" (above the title — host an esa-breadcrumbs here),
// "actions" (right-aligned, top-aligned with the title block).
import EsaIcon from './esa-icon.astro';

// TYPE: the header names roles rather than assembling them — `heading-lg` on the
// default title, `display` on prominence="display", `label-md` on the eyebrow and
// `body-lg` on the lede. The slot containers name one too, as a default that reaches
// slotted content by inheritance — an esa-breadcrumbs or esa-button carries its own
// composite and wins. Actions take `label-md` (chrome that holds buttons); breadcrumbs
// take `body-md`, matching what esa-breadcrumbs sets on its own crumbs, so a bare <nav>
// slotted here reads the same as the real component rather than heavier than it.
// The import is the Astro half of the composite mechanism;
// Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

interface Props {
  title: string;
  lede?: string;
  /** Small kicker above the title (e.g. a section or award name). */
  eyebrow?: string;
  /** esa-icon registry name for the eyebrow's leading glyph, e.g. 'award' (eyebrow only). */
  icon?: string;
  /** Title scale: the page-title role (default) or the oversized display role. */
  prominence?: 'page-title' | 'display';
  as?: 'header' | 'div' | 'section';
}
const { title, lede, eyebrow, icon, prominence = 'page-title', as = 'header' } = Astro.props;
const Tag = as;

// The two title prominences are two composites, not one composite plus overrides.
const titleType = prominence === 'display' ? 'display' : 'heading-lg';

const hasBreadcrumbs = Astro.slots.has('breadcrumbs');
const hasActions = Astro.slots.has('actions');
---
<Tag class:list={['esa-page-header', prominence === 'display' && 'esa-page-header--display']}>
  {hasBreadcrumbs && (
    <div class="esa-page-header__breadcrumbs typography-body-md">
      <slot name="breadcrumbs" />
    </div>
  )}
  <div class="esa-page-header__bar">
    <div class="esa-page-header__titles">
      {eyebrow && (
        <p class="esa-page-header__eyebrow typography-label-md">
          {icon && <EsaIcon name={icon} size="sm" />}
          <span>{eyebrow}</span>
        </p>
      )}
      <h1 class={`esa-page-header__title typography-${titleType}`}>{title}</h1>
      {lede && <p class="esa-page-header__lede typography-body-lg">{lede}</p>}
    </div>
    {hasActions && (
      <div class="esa-page-header__actions typography-label-md">
        <slot name="actions" />
      </div>
    )}
  </div>
</Tag>

<style>
  .esa-page-header {
    /* THIRTEEN --page-header-* hooks used to sit in front of these, described
       right here as "the PUBLIC re-skin surface". They were declared in no token
       file, so they were public in this comment only — absent from
       component-tokens.css, absent from token-names.json, unguarded, and unknown
       to any spoke that had not read this source. Folded 2026-08-16; the type
       roles and spacing below are what a re-skin was always going to move, and
       they move every component at once instead of this one. */
    --_ph-title-color: var(--color-content-default, #202020);
    --_ph-title-font: var(--typography-heading-lg-font-family, var(--typography-font-family-display, 'DM Sans', sans-serif));
    --_ph-title-size: var(--typography-heading-lg-font-size, var(--font-size-600, 1.875rem));
    --_ph-title-weight: var(--typography-heading-lg-font-weight, var(--typography-font-weight-semibold, 550));
    --_ph-lede-color: var(--color-content-default-secondary, #646464);
    --_ph-lede-size: var(--typography-body-lg-font-size, var(--font-size-300, 1.125rem));
    --_ph-eyebrow-color: var(--color-content-default-secondary, #646464);
    --_ph-eyebrow-size: var(--typography-label-md-font-size, var(--font-size-200, 0.9375rem));
    --_ph-gap: var(--spacing-200, 0.5rem);
    --_ph-bar-gap: var(--spacing-500, 1.5rem);
    --_ph-crumb-gap: var(--spacing-300, 0.75rem);

    display: block;
    background: transparent;
  }

  /* prominence="display" — the oversized hero title. The h1 carries
     .typography-display here; these repoint onto that composite.
     3rem was never font-size-800: its clamp maxes at 2.75rem. */
  .esa-page-header--display {
    --_ph-title-font: var(--typography-display-font-family, var(--typography-font-family-display, 'DM Sans', sans-serif));
    --_ph-title-size: var(--typography-display-font-size, var(--font-size-800, 2.75rem));
    --_ph-title-weight: var(--typography-display-font-weight, var(--typography-font-weight-bold, 650));
  }

  .esa-page-header__breadcrumbs {
    margin-bottom: var(--_ph-crumb-gap);
  }

  .esa-page-header__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
    margin: 0;
    font-size: var(--_ph-eyebrow-size);
    color: var(--_ph-eyebrow-color);
  }

  .esa-page-header__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--_ph-bar-gap);
    flex-wrap: wrap;
  }

  .esa-page-header__titles {
    display: flex;
    flex-direction: column;
    gap: var(--_ph-gap);
    min-width: 0;
  }

  .esa-page-header__title {
    margin: 0;
    font-family: var(--_ph-title-font);
    font-size: var(--_ph-title-size);
    font-weight: var(--_ph-title-weight);
    color: var(--_ph-title-color);
  }

  .esa-page-header__lede {
    margin: 0;
    font-size: var(--_ph-lede-size);
    color: var(--_ph-lede-color);
    max-width: 70ch;
  }

  .esa-page-header__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    flex-shrink: 0;
  }
</style>
