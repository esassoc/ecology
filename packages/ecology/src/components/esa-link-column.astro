---
// esa-link-column — presentational (.astro).
//
// A footer/sitemap column: heading + thin rule + a list of links. Inherits
// currentColor (the rule is derived from it), so it reads on a brand footer or a
// light surface without carrying brand values.
interface LinkItem {
  label: string;
  href?: string;
}
interface Props {
  /** The category name for the links below it. "Mitigation work", "Reporting", "Funding". */
  heading: string;
  /** Optional link on the heading itself. */
  href?: string;
  links: LinkItem[];
}
const { heading, href, links } = Astro.props;

// The column heading is a label, the links underneath are `body-sm`. Both keep their
// PUBLIC font-size hook (see the style block). The import is the Astro half of the
// composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';
---
<div class="esa-link-column">
  {href
    ? <a class="esa-link-column__head typography-label-md" href={href}>{heading}</a>
    : <span class="esa-link-column__head typography-label-md">{heading}</span>}
  <hr class="esa-link-column__rule" />
  <ul class="esa-link-column__list">
    {links.map((l) => (
      <li class="typography-body-sm">{l.href ? <a href={l.href}>{l.label}</a> : l.label}</li>
    ))}
  </ul>
</div>

<style>
  .esa-link-column { color: inherit; }
  .esa-link-column__head {
    display: block;
    margin: 0 0 var(--spacing-100, 4px);
    /* Type comes from .typography-label-md on this element. The one declaration kept
       is the PUBLIC size hook — a spoke overrides it, and a deleted declaration is
       exactly what an alias cannot rescue. Its fallback is now the composite's own
       size token, so unset it and the role decides. */
    font-size: var(--typography-label-md-font-size);
    color: inherit;
    text-decoration: none;
  }
  .esa-link-column__head[href]:hover { text-decoration: underline; }
  /* rule derived from currentColor → works on any background */
  .esa-link-column__rule {
    height: 1px;
    border: 0;
    margin: 0 0 var(--spacing-200, 8px);
    background: var(--link-column-rule-color, color-mix(in srgb, currentColor 40%, transparent));
  }
  .esa-link-column__list { list-style: none; margin: 0; padding: 0; }
  .esa-link-column__list li {
    /* Same deal as the heading: keep the PUBLIC size hook, let body-sm supply the
       fallback. The bare `line-height: 22px` is gone — at 14px that was 1.57, which
       body-sm's normal ramp (1.6) already gives. */
    font-size: var(--font-size-150, var(--typography-body-sm-font-size));
    margin-bottom: var(--spacing-100, 4px);
  }
  .esa-link-column__list a { color: inherit; text-decoration: none; }
  .esa-link-column__list a:hover { text-decoration: underline; }
</style>
