---
// esa-badge — GOLDEN PRESENTATIONAL PATTERN (.astro).
// Faithful translation of the Angular esa-badge: same variants, sizes, dot mode,
// same private --_* tokens reading public semantic tokens with literal fallbacks.
// Angular host classes → class list here; Angular @if(!dot) → conditional render.
interface Props {
  value?: string | number;
  variant?: 'primary' | 'secondary' | 'success' | 'warning' | 'danger' | 'info';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  dot?: boolean;
}
const { value, variant = 'primary', size = 'md', dot = false } = Astro.props;

// Badge text is UI text at emphasis — the -strong label composite, one rung per size.
// The import is the Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const LABEL_TYPE = {
  xs: 'label-2xs-strong',
  sm: 'label-xs-strong',
  md: 'label-sm-strong',
  lg: 'label-md-strong',
} as const;

const cls = [
  'esa-badge',
  `esa-badge--${variant}`,
  `esa-badge--${size}`,
  `typography-${LABEL_TYPE[size]}`,
  dot && 'esa-badge--dot',
]
  .filter(Boolean)
  .join(' ');
---
<span class={cls}>
  {!dot && <span class="esa-badge__text">{value}</span>}
</span>

<style>
  .esa-badge {
    line-height: var(--badge-line-height, 1);
    --_badge-bg: var(--badge-bg, var(--color-background-brand, #43608a));
    --_badge-text: var(--badge-text-color, var(--color-content-default-knockout, #fff));
    --_badge-padding-y: var(--spacing-150, 0.375rem);
    --_badge-padding-x: var(--spacing-200, 0.5rem);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Sized by padding + text, not by a height token — --chip-height-* and its
       --badge-height-* hook were deleted 2026-08-15 (a px box cannot grow with rem
       text). --_badge-padding-y sits ONE RUNG BELOW --_badge-padding-x, which is what
       makes this read as an inline mark. Do NOT copy esa-button's rule here: a button
       sets --_btn-pad-y EQUAL to --_btn-padding-x, and it is a 40px control that can
       afford it; applying that to a chip renders it button-tall (measured: md went to
       38px). Wider-than-tall padding is the shape.
       aspect-ratio squares the count case the way .esa-button--icon-only does;
       min-width: fit-content is what keeps a long label from being squeezed by it —
       min-width:auto resolves to 0 on a box that is not a flex ITEM, so the ratio
       would otherwise crop a long label. */
    aspect-ratio: 1;
    min-width: fit-content;
    padding-block: var(--_badge-padding-y);
    padding-inline: var(--_badge-padding-x);
    border-radius: var(--badge-radius, var(--radius-control, 4px));
    background: var(--_badge-bg);
    color: var(--_badge-text);
    white-space: nowrap;
    box-sizing: border-box;
  }

  /* base .esa-badge = md. xs is one step below sm; sm/lg keep the old small/large values.
     Size no longer carries a font-size — that rung comes from LABEL_TYPE above. */
  .esa-badge--xs { --_badge-padding-y: var(--spacing-100, 0.25rem);  --_badge-padding-x: var(--spacing-100, 0.25rem); }
  .esa-badge--sm { --_badge-padding-y: var(--spacing-100, 0.25rem);  --_badge-padding-x: var(--spacing-150, 0.375rem); }
  .esa-badge--lg { --_badge-padding-y: var(--spacing-250, 0.625rem); --_badge-padding-x: var(--spacing-300, 0.75rem); }

  .esa-badge--secondary { --_badge-bg: var(--color-background-brand-secondary, #65ba74); --_badge-text: var(--color-content-on-brand-secondary, #203c25); }
  .esa-badge--success   { --_badge-bg: var(--color-background-utility-success, #bdee63); --_badge-text: var(--color-content-on-utility-success, #37401c); }
  .esa-badge--warning   { --_badge-bg: var(--color-background-utility-warning, #ffc53d); --_badge-text: var(--color-content-on-utility-warning, #4f3422); }
  .esa-badge--danger    { --_badge-bg: var(--color-background-utility-danger, #e5484d); }
  .esa-badge--info      { --_badge-bg: var(--color-background-utility-info, #0090ff); }

  .esa-badge--dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    padding: 0;
    border-radius: var(--radius-pill, 9999px);
  }

  .esa-badge--dot.esa-badge--primary   { --_badge-bg: var(--color-background-brand-hover,   #3e9b4f); }
  .esa-badge--dot.esa-badge--secondary { --_badge-bg: var(--color-background-brand-secondary-hover,  #46a758); }
  .esa-badge--dot.esa-badge--success   { --_badge-bg: var(--color-background-utility-success-hover,    #b0e64c); }
  .esa-badge--dot.esa-badge--warning   { --_badge-bg: var(--color-background-utility-warning-hover,    #ffba18); }
  .esa-badge--dot.esa-badge--danger    { --_badge-bg: var(--color-background-utility-danger-hover,     #dc3e42); }
  .esa-badge--dot.esa-badge--info      { --_badge-bg: var(--color-background-utility-info-hover,       #0588f0); }
</style>
