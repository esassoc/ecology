---
// esa-kbd — presentational (.astro). A keycap for rendering keyboard hints
// (/, Tab, Esc, ↑ ↓ ↵). Slot the key label. Token-driven, so it re-skins with the
// active theme. (Promoted from cb-fish's cbf-kbd; the same keycap styling was also
// duplicated inside esa-command-palette — this is the shared primitive both use.)
//
// TYPE: `label-xs` — a keycap is UI text, not code, and the sans face is deliberate
// (it also overrides the UA's monospace default for <kbd>). The import is the Astro
// half of the composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';
---
<kbd class="esa-kbd typography-microcopy-xs"><slot /></kbd>

<style>
  .esa-kbd {
    /* microcopy carries no leading, which is only safe because a keycap is one
       line. Say so, rather than relying on it being short. */
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    color: var(--color-content-default-muted, #838383);
    background: var(--color-background-elevation-raised, #fcfcfc);
    border: var(--border-width-default, 1px) solid var(--color-border-default, #cecece);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm, 0.25rem);
  }
</style>
