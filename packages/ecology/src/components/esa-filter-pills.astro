---
// esa-filter-pills — presentational list of active-filter chips, each removable.
// Faithful translation of the Angular esa-filter-pills: rounded chips showing
// "<label>: <displayValue>" with an x remove button.
//
// In Angular the chips came from the injected EsaFilterService. Here they are
// passed in as `filters`, keeping the component presentational. Each remove
// button dispatches a bubbling `esa-filter-remove` event carrying { name, value }
// so a parent esa-filter-container WC can update live state.
interface ActiveFilter {
  name: string;
  label: string;
  value: string;
  displayValue: string;
}
interface Props {
  filters?: ActiveFilter[];
}
const { filters = [] } = Astro.props;

// Chip text is UI text — `label-xs`. The import is the Astro half of the composite
// mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';
---
{filters.length > 0 && (
  <div class="esa-filter-pills">
    {/* The chip carries NO aria-label. It used to be `${label}: ${displayValue}` — a
        verbatim copy of the text already inside it, on a <span> whose implicit role is
        `generic`, which ARIA prohibits naming. Chromium computes it anyway, so this was
        not inert; it was a duplicate name only some browsers expose, free to drift out
        of sync with the visible text. The visible text IS the accessible text. */}
    {filters.map((filter) => (
      <span class="esa-filter-pills__chip typography-microcopy-xs-subtle">
        <span class="esa-filter-pills__label typography-microcopy-xs">{filter.label}:</span>
        <span class="esa-filter-pills__value">{filter.displayValue}</span>
        <button
          class="esa-filter-pills__remove"
          type="button"
          data-esa-filter-remove
          data-name={filter.name}
          data-value={filter.value}
          aria-label={`Remove ${filter.label} ${filter.displayValue}`}
        >
          <svg
            class="esa-filter-pills__remove-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </span>
    ))}
  </div>
)}

<style>
  .esa-filter-pills {
    --_pill-gap: var(--spacing-200, 0.5rem);
    --_pill-bg: var(--filter-pill-bg, var(--color-background-brand-muted, #d5edda));
    --_pill-text: var(--filter-pill-text, var(--color-content-brand, #3a7c59));
    --_pill-radius: var(--filter-pill-radius, var(--radius-pill, 9999px));
    --_pill-padding-y: var(--spacing-200, 0.5rem);
    --_pill-padding-x: var(--spacing-300, 0.75rem);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--_pill-gap);
  }

  .esa-filter-pills__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100, 0.25rem);
    /* Sized by padding + text — --filter-pill-height and the shared --chip-height-*
       ramp behind it were deleted 2026-08-15. --_pill-padding-y sits one rung below
       --_pill-padding-x (see esa-badge for why esa-button's equal-axis rule does not
       transfer to a chip). There is one rung only: this component has no size prop. */
    padding-block: var(--_pill-padding-y);
    padding-inline: var(--_pill-padding-x);
    background: var(--_pill-bg);
    border-radius: var(--_pill-radius);
    /* Type comes from .typography-label-xs on this element. --filter-pill-font-size is
       a PUBLIC tier-3 hook, so the one size declaration stays — a spoke overriding it
       must still win, and the composite's own token is the fallback. */
    font-size: var(--filter-pill-font-size, var(--typography-label-xs-font-size));
    white-space: nowrap;
    transition: background var(--transition-fast, 150ms ease);
  }

  .esa-filter-pills__chip:hover {
    background: var(--filter-pill-bg-hover, var(--color-background-brand-muted-hover, #c6e5cc));
  }

  /* No font-weight here: medium is what label-xs already carries on the chip. */
  .esa-filter-pills__label {
    margin-inline-end: var(--spacing-100, 0.25rem);
    color: var(--filter-pill-label-color, var(--color-content-default-secondary, #646464));
  }

  .esa-filter-pills__value {
    color: var(--_pill-text);
  }

  .esa-filter-pills__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    margin-inline-start: var(--spacing-050, 0.125rem);
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--filter-pill-remove-color, var(--color-content-default-secondary, #646464));
    border-radius: var(--radius-pill, 9999px);
    transition:
      color var(--transition-fast, 150ms ease),
      background var(--transition-fast, 150ms ease);
  }

  .esa-filter-pills__remove:hover {
    color: var(--filter-pill-remove-color-hover, var(--color-content-utility-danger, #ce2c31));
  }

  .esa-filter-pills__remove:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: 1px;
  }

  /* No line-height: the box is an explicit 16×16, so leading cannot change it. */
  .esa-filter-pills__remove-icon {
    width: 16px;
    height: 16px;
  }
</style>

<script>
  // Forward each remove click as a bubbling, composed event with the filter
  // identity, so a parent esa-filter-container can drop that value from state.
  //
  // DELEGATED, not per-button. This used to be
  // `document.querySelectorAll('[data-esa-filter-remove]').forEach(btn => …)`,
  // which runs once at load and therefore only ever wires the chips present in
  // the initial HTML. That defeats the whole reason this component exists as its
  // own chip rather than composing esa-pill: the remove is CONTROLLED — it emits
  // { name, value } and a parent updates filter state — so the very next render
  // of that parent produced chips whose X did nothing, with no error. One
  // listener on the document survives any number of re-renders.
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest?.('[data-esa-filter-remove]');
    if (!btn) return;
    btn.dispatchEvent(
      new CustomEvent('esa-filter-remove', {
        detail: {
          name: btn.getAttribute('data-name'),
          value: btn.getAttribute('data-value'),
        },
        bubbles: true,
        composed: true,
      })
    );
  });
</script>
