---
// esa-avatar — presentational (.astro).
// Faithful translation of the Angular esa-avatar: image → initials → icon fallback,
// deterministic hue from the name hash, circle/square shapes and size variants.
// Angular host classes → class list; @if/@else-if/@else → conditional render here.
interface Props {
  name?: string;
  src?: string;
  icon?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  shape?: 'circle' | 'square';
  /**
   * Explicit initials, overriding the first+last derivation below. Some callers
   * carry their own rule — esa-header-nav takes the first letter of EVERY word
   * capped at two, so "Mary Jane Watson" is MJ there and MW here — and a caller
   * that already knows the answer should not have to reshape `name` to smuggle
   * it through.
   */
  initials?: string;
}
const { name = '', src = '', icon = '', size = 'md', shape = 'circle', initials: initialsProp } = Astro.props;

const initials = (() => {
  if (initialsProp) return initialsProp;
  if (!name) return '';
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0][0].toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
})();

const hue = (() => {
  if (!name) return 200;
  let hash = 0;
  for (let i = 0; i < name.length; i++) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash) % 360;
})();

// Lucide "user" icon path — inlined to avoid an icon dependency.
const iconSize = size === 'xs' ? 14 : size === 'sm' ? 16 : size === 'lg' ? 24 : 20;

// Initials are UI text at emphasis — the -strong label composite, one rung per
// size, topping out at title for lg. The import is the Astro half of the
// composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

// NOTE: `lg` is the odd rung out — the other three are `-strong` (semibold) and it
// is now `title` (medium), because every `title-strong` call site moved to `title`.
// Flagged rather than silently re-pointed: this ramp no longer holds one weight.
const INITIALS_TYPE = {
  xs: 'label-2xs-strong',
  sm: 'label-xs-strong',
  md: 'label-md-strong',
  lg: 'title',
} as const;

const cls = ['esa-avatar', `esa-avatar--${size}`, `esa-avatar--${shape}`, `typography-${INITIALS_TYPE[size]}`]
  .filter(Boolean)
  .join(' ');
---
<span class={cls} style={`--_avatar-hue: ${hue}`}>
  {src ? (
    <img class="esa-avatar__image" src={src} alt={name || 'Avatar'} />
  ) : initials ? (
    <span class="esa-avatar__initials">{initials}</span>
  ) : (
    <svg
      class="esa-avatar__icon"
      xmlns="http://www.w3.org/2000/svg"
      width={iconSize}
      height={iconSize}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
  )}
</span>

<style>
  .esa-avatar {
    --_avatar-size: var(--avatar-size-md, 40px);
    /* Public so initials type can be re-pointed per instance. Each size rule
       below repeats the hook with its own literal, so an override wins whichever
       size is active rather than only at md. */
    --_avatar-font-size: var(--avatar-font-size, var(--typography-label-md-strong-font-size, var(--font-size-200, 0.9375rem)));
    --_avatar-radius: var(--avatar-radius, var(--radius-pill, 9999px));
    --_avatar-bg: var(--avatar-bg, hsl(var(--_avatar-hue, 200) 45% 65%));
    --_avatar-text: var(--avatar-text-color, var(--color-content-default-knockout, #fff));

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--_avatar-size);
    height: var(--_avatar-size);
    border-radius: var(--_avatar-radius);
    background: var(--_avatar-bg);
    color: var(--_avatar-text);
    /* The rest of the type comes from .typography-*-strong on this element. Only
       font-size stays, because --avatar-font-size is public and esa-header-nav
       sets it — the composite token is its fallback, one rung per size below. */
    font-size: var(--_avatar-font-size);
    overflow: hidden;
    flex-shrink: 0;
    user-select: none;
    box-sizing: border-box;
  }

  .esa-avatar--xs { --_avatar-size: var(--avatar-size-xs, 20px); --_avatar-font-size: var(--avatar-font-size, var(--typography-label-2xs-strong-font-size, var(--font-size-050, 0.625rem))); }
  .esa-avatar--sm { --_avatar-size: var(--avatar-size-sm, 28px); --_avatar-font-size: var(--avatar-font-size, var(--typography-label-xs-strong-font-size, var(--font-size-100, 0.75rem))); }
  .esa-avatar--lg { --_avatar-size: var(--avatar-size-lg, 56px); --_avatar-font-size: var(--avatar-font-size, var(--typography-title-font-size, var(--font-size-400, 1.25rem))); }

  .esa-avatar--square { --_avatar-radius: var(--radius-md, 0.5rem); }

  .esa-avatar__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No line-height here: .esa-avatar is a fixed --_avatar-size box that flex-centres
     its children, so the line box has nothing to push against. Setting it was
     defending against leading that could not reach this element. */
  /* NO tracking override here, deliberately. The initials carried a bare `0.02em`,
     a value belonging to no rung, on the argument that two capitals need air. The
     composite owns tracking along with the other four properties, and a component
     reaching past it to set one of the five by hand is the assembling-at-the-call-site
     problem in miniature — it is how a role stops meaning one thing. The delta is
     0.01em across two characters. The role wins. */
</style>
