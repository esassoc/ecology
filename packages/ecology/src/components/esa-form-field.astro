---
// esa-form-field — PRESENTATIONAL layout wrapper (.astro).
// Faithful translation of the Angular esa-form-field: label row + control slot +
// hint/error text. Error text replaces help text when present.
// Angular @if → conditional render; host classes → class list.
//
// TYPE: the component names a composite and does not assemble one. This import is
// the Astro half of the mechanism its Lit siblings get from `static styles =
// [typography, …]` — Astro bundles it into every page that uses this component, so
// a spoke gets the class definitions without a global import it has to remember.
import '@esa/tokens/typography.css';

// The label composite for each step of the control ramp. Note the letters do not
// line up — size="sm" takes the -xs rung — because the control ramp lands on
// 050·100·200·300 while the type families walk 050·100·150·200·300. See
// the FORMS header in component-tokens.css for the full table.
const LABEL_TYPE = { xs: 'label-2xs', sm: 'label-xs', md: 'label-md', lg: 'label-lg' } as const;

interface Props {
  /** The name of the value being collected. */
  label?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  /**
   * A constraint on what this field will accept — its format, its source, or
   * its limit. "As it appears on the permit." "Letters, numbers, hyphens."
   * Never reassurance addressed to the user ("We'll never share your email"),
   * and never a restatement of the field's own state — a disabled field already
   * reads as disabled.
   */
  helpText?: string;
  /** Why the current value was rejected, and what would be accepted instead. */
  errorText?: string;
  required?: boolean;
  disabled?: boolean;
}
const {
  label = '',
  size = 'md',
  helpText = '',
  errorText = '',
  required = false,
  disabled = false,
} = Astro.props;

const hasError = !!errorText;
const cls = [
  'esa-form-field',
  `esa-form-field--${size}`,
  hasError && 'esa-form-field--error',
  disabled && 'esa-form-field--disabled',
]
  .filter(Boolean)
  .join(' ');
---
<div class={cls}>
  {label && (
    <label class={`esa-form-field__label typography-${LABEL_TYPE[size]}`}>
      {label}
      {required && <span class="esa-form-field__required" aria-label="required">*</span>}
    </label>
  )}

  <div class="esa-form-field__input">
    <slot />
  </div>

  {hasError ? (
    <p class="esa-form-field__error typography-body-sm">{errorText}</p>
  ) : helpText ? (
    <p class="esa-form-field__help typography-body-sm">{helpText}</p>
  ) : null}
</div>

<style>
  .esa-form-field {
    --_label-color: var(--form-label-color, #171717);
    --_help-color: var(--form-help-color, #737373);
    --_error-color: var(--form-error-color, var(--color-content-danger, #ce2c31));
    --_label-gap: var(--form-label-gap, 4px);
    --_help-gap: var(--form-help-gap, 4px);
    --_required-color: var(--color-content-danger, #ce2c31);

    display: flex;
    flex-direction: column;
  }

  /* No size-keyed type here. The size variants used to exist only to swap the
     label's font-size; that is now a composite class chosen in the frontmatter,
     so the modifier classes carry nothing and are gone. */

  .esa-form-field__label {
    color: var(--_label-color);
    margin-block-end: var(--_label-gap);
  }

  .esa-form-field__required {
    color: var(--_required-color);
    margin-inline-start: 2px;
  }

  .esa-form-field__input {
    display: flex;
    flex-direction: column;
  }

  .esa-form-field__help,
  .esa-form-field__error {
    margin: 0;
    margin-block-start: var(--_help-gap);
  }

  .esa-form-field__help { color: var(--_help-color); }
  .esa-form-field__error { color: var(--_error-color); }

  .esa-form-field--disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
