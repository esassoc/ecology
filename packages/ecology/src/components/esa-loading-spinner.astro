---
// esa-loading-spinner — presentational (.astro).
// Faithful translation of the Angular esa-loading-spinner: xs/sm/md/lg sizes
// and an optional custom color (CSS value, defaults to --color-background-brand).
// Angular host classes + [style.--_spinner-color] → class list + inline style.
// A11Y: this used to carry `role="status" aria-label="Loading"` on the ring. That was
// a no-op dressed as a feature. `role="status"` is a LIVE REGION, and a live region
// only ever announces a CHANGE to its contents — this ring is permanently empty, so
// there was never a change and it never announced anything, on any screen reader.
// Worse, it was a standing live region: every spinner on the page was one more region
// competing with the others for announcements that do matter.
//
// A spinner is not a status message. It is a graphic that means "loading", so it is
// `role="img"` with a name — persistent, navigable, and re-readable, which a live
// region is not. When the loading STATE changes and that change needs announcing,
// that is the job of `announce()` in ../announcer.ts, called by whatever owns the
// state. This component cannot know when loading started or stopped.
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg';
  color?: string;
  /** Accessible name. Say what is loading when you can — "Loading results". */
  label?: string;
  /**
   * Hide from assistive technology entirely.
   *
   * For a spinner inside something that already says it is busy — an
   * `esa-button` with `loading` (which sets `aria-busy` and keeps its own label),
   * or an `esa-loading-overlay` that carries the message. Two names for one state
   * is noise, not redundancy.
   */
  decorative?: boolean;
}
const { size = 'md', color, label = 'Loading', decorative = false } = Astro.props;

const cls = ['esa-loading-spinner', `esa-loading-spinner--${size}`].join(' ');
const style = color ? `--_spinner-color: ${color}` : undefined;
---
<span class={cls} style={style} aria-hidden={decorative ? 'true' : undefined}>
  <span
    class="esa-loading-spinner__ring"
    role={decorative ? undefined : 'img'}
    aria-label={decorative ? undefined : label}
  ></span>
</span>

<style>
  .esa-loading-spinner {
    --_spinner-size: 32px;
    --_spinner-border-width: 3px;
    --_spinner-color: var(--loading-spinner-color, var(--color-background-brand, #43608a));

    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .esa-loading-spinner--xs { --_spinner-size: 14px; --_spinner-border-width: 2px; }
  .esa-loading-spinner--sm { --_spinner-size: 20px; --_spinner-border-width: 2px; }
  .esa-loading-spinner--lg { --_spinner-size: 48px; --_spinner-border-width: 4px; }

  .esa-loading-spinner__ring {
    width: var(--_spinner-size);
    height: var(--_spinner-size);
    border: var(--_spinner-border-width) solid var(--loading-spinner-track-color, var(--color-border-default-subtle, #efefef));
    border-top-color: var(--_spinner-color);
    border-radius: var(--radius-pill, 9999px);
    animation: esa-spinner-rotate var(--animation-spin, 750ms linear infinite);
    box-sizing: border-box;
  }

  @keyframes esa-spinner-rotate {
    to { transform: rotate(360deg); }
  }

  /* An infinite animation is the one kind SC 2.2.2 (Pause, Stop, Hide) and the
     reduced-motion preference both care about. It cannot be removed outright —
     a frozen ring reads as a broken one — so it slows to a step that still says
     "working" without spinning. */
  @media (prefers-reduced-motion: reduce) {
    .esa-loading-spinner__ring {
      animation-duration: 2.5s;
      animation-timing-function: steps(8, end);
    }
  }
</style>
