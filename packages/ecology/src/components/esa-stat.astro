---
// esa-stat — presentational single-metric block (.astro).
// A big display value, a readable label, and an optional muted sub/caption.
// Replaces the bespoke .stat / .stat__value / .stat__label / .stat__sub cluster
// every prototype re-implements.
//
// Value is `display-sm` — the display face at a large-but-tasteful rung, NOT the
// full `display`. Label is `label-md` (sentence case, secondary color) — NOT an
// uppercase, micro, letter-spaced overline. Sub is `body-sm`, muted.
// Container stays neutral — no background of its own (transparent); color is
// the consumer's job. accent=true tints the value with the spoke's secondary
// emphasis; default false keeps it primary text. Private --_* tokens read
// public semantic tokens with a literal fallback, mirroring esa-badge.
interface Props {
  value: string | number;
  label: string;
  sub?: string;
  accent?: boolean;
}
const { value, label, sub, accent = false } = Astro.props;

// TYPE: the block names roles rather than assembling them — `display-sm` is the
// composite for exactly this (700/bold/tight on the display face), `label-md` for
// the label, `body-sm` for the muted sub. The import is the Astro half of the
// composite mechanism; Lit siblings get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const cls = ['esa-stat', accent && 'esa-stat--accent'].filter(Boolean).join(' ');
---
<div class={cls}>
  <div class="esa-stat__value typography-display-sm">{value}</div>
  <div class="esa-stat__label typography-label-md">{label}</div>
  {sub && <div class="esa-stat__sub typography-body-sm">{sub}</div>}
</div>

<style>
  .esa-stat {
    --_stat-value-color: var(--stat-value-color, var(--color-content-default, #202020));
    /* Type comes from the composite classes in the markup. These six stay because
       they are the PUBLIC re-skin surface — each keeps one declaration below, with
       its composite token as the fallback, so a spoke override still wins. */
    --_stat-value-font: var(--typography-font-family-display, var(--typography-display-sm-font-family, var(--typography-font-family-display, 'DM Sans', sans-serif)));
    --_stat-value-size: var(--stat-value-size, var(--typography-display-sm-font-size, var(--font-size-700, 2.25rem)));
    --_stat-value-weight: var(--typography-font-weight-bold, var(--typography-display-sm-font-weight, var(--typography-font-weight-bold, 650)));
    --_stat-label-color: var(--color-content-default-secondary, #646464);
    --_stat-label-size: var(--font-size-200, var(--typography-label-md-font-size, var(--font-size-200, 0.9375rem)));
    --_stat-label-weight: var(--typography-font-weight-medium, var(--typography-label-md-font-weight, var(--typography-font-weight-medium, 500)));
    --_stat-sub-color: var(--color-content-default-muted, #838383);
    --_stat-sub-size: var(--font-size-150, var(--typography-body-sm-font-size, var(--font-size-150, 0.875rem)));
    --_stat-accent-color: var(--stat-accent-color, var(--color-content-brand-secondary, #2a7e3b));
    --_stat-gap: var(--spacing-050, 0.125rem);

    display: flex;
    flex-direction: column;
    gap: var(--_stat-gap);
    background: transparent;
  }

  .esa-stat__value {
    font-family: var(--_stat-value-font);
    font-size: var(--_stat-value-size);
    font-weight: var(--_stat-value-weight);
    color: var(--_stat-value-color);
  }

  .esa-stat--accent .esa-stat__value {
    color: var(--_stat-accent-color);
  }

  .esa-stat__label {
    font-size: var(--_stat-label-size);
    font-weight: var(--_stat-label-weight);
    color: var(--_stat-label-color);
  }

  .esa-stat__sub {
    font-size: var(--_stat-sub-size);
    color: var(--_stat-sub-color);
  }
</style>
