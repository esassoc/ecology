---
// esa-container — presentational (.astro). Centered, max-width layout wrapper with
// a symmetric side gutter. The single place the kit owns "constrain page content
// to a readable width." (Promoted from cb-fish's cbf-container; esa-app-bar already
// hardcodes the same centered-1556px pattern internally.)
interface Props {
  /** Max content width. Defaults to the kit's wide page width. */
  maxWidth?: string;
}
const { maxWidth = '1556px' } = Astro.props;

// TYPE: `body-md` is the reading default for a page section — loose text put
// straight into the container names a role instead of inheriting the document's.
// A DEFAULT, not a dictate: every esa-* and every type-role class inside overrides it.
import '@esa/tokens/typography.css';
---
<div class="esa-container typography-body-md" style={`--_container-max:${maxWidth}`}>
  <slot />
</div>

<style>
  .esa-container {
    width: 100%;
    max-width: var(--_container-max, 1556px);
    margin-inline: auto;
    padding-inline: var(--container-gutter, var(--spacing-600, 2rem));
  }
</style>
