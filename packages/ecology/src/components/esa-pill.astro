---
// esa-pill — presentational (.astro).
// Faithful translation of the Angular esa-pill: required label, color variants,
// size variants, optional leading Lucide icon, and an optional remove button.
// Angular host classes → class list; @if → conditional render. The remove
// interaction (emit + remove from DOM) is handled by a tiny inline script — light
// enough to keep this in the presentational bucket. Pass an inline SVG via the
// "icon" slot for the leading icon.
interface Props {
  label: string;
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info';
  removable?: boolean;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  /**
   * Project vocabulary this pill labels — a permit type, a survey stage, a species.
   * Emits `data-category`, which a spoke's theme scopes a colour ramp to. `variant`
   * is for the six SYSTEM intents and cannot express an open set; this is the axis
   * for the open set. See the "Custom colors" section on the doc page.
   */
  category?: string;
}
const { label, variant = 'default', removable = true, size = 'md', category } = Astro.props;

// Pill text is UI text — the label composite, one rung per size. The import is the
// Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const LABEL_TYPE = { xs: 'microcopy-2xs', sm: 'microcopy-xs', md: 'microcopy-sm', lg: 'microcopy-md' } as const;

const hasIconSlot = Astro.slots.has('icon');
const cls = [
  'esa-pill',
  `esa-pill--${variant}`,
  `esa-pill--${size}`,
  `typography-${LABEL_TYPE[size]}`,
].join(' ');
---
<span class={cls} data-category={category}>
  {hasIconSlot && (
    <span class="esa-pill__icon">
      <slot name="icon" />
    </span>
  )}
  <span class="esa-pill__label">{label}</span>
  {removable && (
    <button class="esa-pill__remove" type="button" aria-label="Remove" data-esa-pill-remove>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  )}
</span>

{/* NOT gated on `removable`, for the same reason esa-alert-box is not: a delegated
    listener exists precisely to catch pills rendered after load, so gating it on a
    BUILD-TIME prop reintroduces the bug at one remove — a page whose server-rendered
    pills are all non-removable would ship no listener, and a removable pill injected
    later would still have a dead X. */}
<script>
  // DELEGATED, not per-button. This used to be
  // `document.querySelectorAll('[data-esa-pill-remove]').forEach(btn => …)`,
  // which runs once at load, so any pill rendered afterwards had a dead X and
  // said nothing about it.
  //
  // CAPTURE phase, deliberately. The per-button version called
  // stopPropagation() so that removing a pill inside a clickable row did not
  // also activate the row. Delegating on the bubble phase would lose that — by
  // the time document sees the click, every ancestor already has. Listening in
  // capture puts this ahead of all of them, so stopPropagation() still means
  // what it meant.
  document.addEventListener(
    'click',
    (event) => {
      const btn = (event.target as HTMLElement).closest?.('[data-esa-pill-remove]');
      if (!btn) return;
      event.stopPropagation();
      const pill = btn.closest('.esa-pill') as HTMLElement | null;
      if (pill) {
        pill.dispatchEvent(new CustomEvent('removed', { bubbles: true }));
        pill.remove();
      }
    },
    true,
  );
</script>

<style>
  .esa-pill {
    --_pill-bg: var(--color-background-elevation-sunken, #f0f0f0);
    --_pill-text: var(--color-content-default, #202020);
    --_pill-border: var(--color-border-default-subtle, #d9d9d9);
    --_pill-padding-y: var(--spacing-150, 0.375rem);
    --_pill-padding-x: var(--spacing-200, 0.5rem);
    --_pill-gap: var(--spacing-100, 0.25rem);

    display: inline-flex;
    align-items: center;
    gap: var(--_pill-gap);
    /* Sized by padding + text — --pill-height-* and the shared --chip-height-* ramp
       behind it were deleted 2026-08-15. --_pill-padding-y sits one rung below
       --_pill-padding-x (see esa-badge for why esa-button's equal-axis rule does not
       transfer to a chip). The radius is 9999px, so the capsule follows whatever
       height the text and padding resolve to. Note this box has a 1px border on each
       side, so it renders 2px taller than esa-badge at the same rung. */
    padding-block: var(--_pill-padding-y);
    padding-inline: var(--_pill-padding-x);
    border: var(--border-width-default, 1px) solid var(--_pill-border);
    border-radius: var(--radius-sm, var(--radius-pill, 9999px));
    background: var(--_pill-bg);
    color: var(--_pill-text);
    white-space: nowrap;
    box-sizing: border-box;
  }

  /* Size no longer carries a font-size — that rung comes from LABEL_TYPE above. */
  .esa-pill--xs {
    --_pill-padding-y: var(--spacing-100, 0.25rem);
    --_pill-padding-x: var(--spacing-100, 0.25rem);
  }

  .esa-pill--sm {
    --_pill-padding-y: var(--spacing-100, 0.25rem);
    --_pill-padding-x: var(--spacing-150, 0.375rem);
  }

  .esa-pill--lg {
    --_pill-padding-y: var(--spacing-200, 0.5rem);
    --_pill-padding-x: var(--spacing-300, 0.75rem);
  }

  .esa-pill--primary {
    --_pill-bg: var(--color-background-brand-subtle, var(--color-grass-2));
    --_pill-text: var(--color-content-brand, var(--color-grass-11));
    --_pill-border: var(--color-border-brand, var(--color-grass-6));
  }

  .esa-pill--info {
    --_pill-bg: var(--color-background-utility-info-subtle, var(--color-blue-2));
    --_pill-text: var(--color-content-utility-info, #0d74ce);
    --_pill-border: var(--color-border-utility-info, var(--color-blue-6));
  }

  .esa-pill--success {
    --_pill-bg: var(--color-background-utility-success-subtle, var(--color-lime-2));
    --_pill-text: var(--color-content-utility-success, #5c7c2f);
    --_pill-border: var(--color-border-utility-success, var(--color-lime-6));
  }

  .esa-pill--warning {
    --_pill-bg: var(--color-background-utility-warning-subtle, var(--color-yellow-2));
    --_pill-text: var(--color-content-utility-warning, #ab6400);
    --_pill-border: var(--color-border-utility-warning, var(--color-yellow-6));
  }

  .esa-pill--danger {
    --_pill-bg: var(--color-background-utility-danger-subtle, var(--color-red-2));
    --_pill-text: var(--color-content-utility-danger, #ce2c31);
    --_pill-border: var(--color-border-utility-danger, var(--color-red-6));
  }

  /* ---------- CATEGORY COLOUR ----------
     For a label whose colour is PROJECT VOCABULARY — "Permit expired", "Awaiting
     survey", a species, a funding source. `variant` covers the six system intents
     and is deliberately closed; this axis is open, because the set is the spoke's
     and the hub cannot enumerate it.

     THE THREE NAMES BELOW ARE NOT HUB TOKENS AND MUST NOT BECOME ONE. They are
     declared by the SPOKE, scoped to its own vocabulary, and read here — the
     inverse of every other var() in this file. That is the whole point: the
     mechanism is ours, the values are the project's, so there is nothing for
     component-tokens.css to hold and no row in token-names.json. Each read keeps
     the default pill's own chain as its fallback, so a category with no ramp
     defined (or a typo in the name) renders an ordinary pill rather than losing
     the declaration.

     STEPS 2 / 6 / 11, matching the semantic variants above line for line — fill,
     border, text. That is not a coincidence to preserve loosely: it is what makes
     a project's own category read as a native member of the set beside
     `success` and `info` rather than a foreign object. Radix's custom-palette
     generator emits --accent-1..12 in exactly this scale, so a pasted ramp needs
     only the prefix renamed.

     CONTRAST: step 11 on step 2 is the pairing Radix tunes for legible text, and
     is why the ramp is generated rather than hand-picked — a fill and a text
     colour chosen independently is how #6b21a8 ends up on #202020. It is a good
     default, not a guarantee; bright hues are where it gets tight, and that
     verification belongs in the batched contrast pass. */
  .esa-pill[data-category] {
    --_pill-bg:     var(--category-2,  var(--color-background-elevation-sunken, #f0f0f0));
    --_pill-border: var(--category-6,  var(--color-border-default-subtle, #d9d9d9));
    --_pill-text:   var(--category-11, var(--color-content-default, #202020));
  }

  .esa-pill__icon {
    flex-shrink: 0;
    display: inline-flex;
  }

  /* .esa-pill__label had font-weight: 500 — exactly what label-* already carries,
     so it is inherited from the root composite now rather than restated here. */

  .esa-pill__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill, 9999px);
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--transition-fast, 150ms ease),
                background var(--transition-fast, 150ms ease);
  }

  .esa-pill__remove:hover {
    opacity: 1;
    background: var(--color-background-overlay-heavy-hover, rgba(0, 0, 0, 0.1));
  }

  .esa-pill__remove:focus-visible {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, #3e9b4f);
    outline-offset: var(--focus-ring-offset, 2px);
  }
</style>
