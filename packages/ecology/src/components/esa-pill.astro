---
// esa-pill — presentational (.astro).
// Faithful translation of the Angular esa-pill: required label, color variants,
// size variants, optional leading Lucide icon, and an optional remove button.
// Angular host classes → class list; @if → conditional render. The remove
// interaction (emit + remove from DOM) is handled by a tiny inline script — light
// enough to keep this in the presentational bucket. Pass an inline SVG via the
// "icon" slot for the leading icon.
interface Props {
  label: string;
  variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info';
  removable?: boolean;
  size?: 'xs' | 'sm' | 'md' | 'lg';
}
const { label, variant = 'default', removable = true, size = 'md' } = Astro.props;

const hasIconSlot = Astro.slots.has('icon');
const cls = ['esa-pill', `esa-pill--${variant}`, `esa-pill--${size}`].join(' ');
---
<span class={cls}>
  {hasIconSlot && (
    <span class="esa-pill__icon">
      <slot name="icon" />
    </span>
  )}
  <span class="esa-pill__label">{label}</span>
  {removable && (
    <button class="esa-pill__remove" type="button" aria-label="Remove" data-esa-pill-remove>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  )}
</span>

{/* NOT gated on `removable`, for the same reason esa-alert-box is not: a delegated
    listener exists precisely to catch pills rendered after load, so gating it on a
    BUILD-TIME prop reintroduces the bug at one remove — a page whose server-rendered
    pills are all non-removable would ship no listener, and a removable pill injected
    later would still have a dead X. */}
<script>
  // DELEGATED, not per-button. This used to be
  // `document.querySelectorAll('[data-esa-pill-remove]').forEach(btn => …)`,
  // which runs once at load, so any pill rendered afterwards had a dead X and
  // said nothing about it.
  //
  // CAPTURE phase, deliberately. The per-button version called
  // stopPropagation() so that removing a pill inside a clickable row did not
  // also activate the row. Delegating on the bubble phase would lose that — by
  // the time document sees the click, every ancestor already has. Listening in
  // capture puts this ahead of all of them, so stopPropagation() still means
  // what it meant.
  document.addEventListener(
    'click',
    (event) => {
      const btn = (event.target as HTMLElement).closest?.('[data-esa-pill-remove]');
      if (!btn) return;
      event.stopPropagation();
      const pill = btn.closest('.esa-pill') as HTMLElement | null;
      if (pill) {
        pill.dispatchEvent(new CustomEvent('removed', { bubbles: true }));
        pill.remove();
      }
    },
    true,
  );
</script>

<style>
  .esa-pill {
    --_pill-bg: var(--pill-bg, var(--color-background-sunken, #efefef));
    --_pill-text: var(--pill-text-color, var(--color-content-primary, #171717));
    --_pill-border: var(--pill-border-color, var(--color-border-subtle, #efefef));
    --_pill-height: var(--pill-height-md, 28px);
    --_pill-font-size: var(--font-size-150, 0.875rem);
    --_pill-padding-x: var(--spacing-200, 0.5rem);
    --_pill-gap: var(--spacing-100, 0.25rem);

    display: inline-flex;
    align-items: center;
    gap: var(--_pill-gap);
    height: var(--_pill-height);
    padding-inline: var(--_pill-padding-x);
    border: var(--border-width-default, 1px) solid var(--_pill-border);
    border-radius: var(--pill-radius, var(--radius-pill, 9999px));
    background: var(--_pill-bg);
    color: var(--_pill-text);
    font-size: var(--_pill-font-size);
    line-height: var(--line-height-none, 1);
    white-space: nowrap;
    box-sizing: border-box;
  }

  .esa-pill--xs {
    --_pill-height: var(--pill-height-xs, 18px);
    --_pill-font-size: var(--font-size-050, 0.625rem);
    --_pill-padding-x: var(--spacing-100, 0.25rem);
  }

  .esa-pill--sm {
    --_pill-height: var(--pill-height-sm, 22px);
    --_pill-font-size: var(--font-size-100, 0.75rem);
    --_pill-padding-x: var(--spacing-150, 0.375rem);
  }

  .esa-pill--lg {
    --_pill-height: var(--pill-height-lg, 34px);
    --_pill-font-size: var(--font-size-200, 0.9375rem);
    --_pill-padding-x: var(--spacing-300, 0.75rem);
  }

  .esa-pill--primary {
    --_pill-bg: var(--color-background-brand-subtle, var(--color-grass-2));
    --_pill-text: var(--color-content-brand, var(--color-grass-11));
    --_pill-border: var(--color-border-brand, var(--color-grass-6));
  }

  .esa-pill--info {
    --_pill-bg: var(--color-background-info-subtle, var(--color-blue-2));
    --_pill-text: var(--color-content-info, #0d74ce);
    --_pill-border: var(--color-border-info, var(--color-blue-6));
  }

  .esa-pill--success {
    --_pill-bg: var(--color-background-success-subtle, var(--color-lime-2));
    --_pill-text: var(--color-content-success, #5c7c2f);
    --_pill-border: var(--color-border-success, var(--color-lime-6));
  }

  .esa-pill--warning {
    --_pill-bg: var(--color-background-warning-subtle, var(--color-yellow-2));
    --_pill-text: var(--color-content-warning, #ab6400);
    --_pill-border: var(--color-border-warning, var(--color-yellow-6));
  }

  .esa-pill--danger {
    --_pill-bg: var(--color-background-danger-subtle, var(--color-red-2));
    --_pill-text: var(--color-content-danger, #ce2c31);
    --_pill-border: var(--color-border-danger, var(--color-red-6));
  }

  .esa-pill__icon {
    flex-shrink: 0;
    display: inline-flex;
  }

  .esa-pill__label {
    font-weight: 500;
  }

  .esa-pill__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill, 9999px);
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--transition-fast, 150ms ease),
                background var(--transition-fast, 150ms ease);
  }

  .esa-pill__remove:hover {
    opacity: 1;
    background: var(--pill-remove-bg-hover, rgba(0, 0, 0, 0.1));
  }

  .esa-pill__remove:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 2px);
  }
</style>
