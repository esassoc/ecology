---
// esa-app-bar — presentational layout primitive (.astro).
//
// The full-bleed horizontal chrome shell shared by top nav bars, sub-bars, and
// footers. It sets a COLOR CONTEXT (background + currentColor) from ecology
// semantic tokens via `tone`, then exposes three slots: start / default / end.
// Children (esa-icon-link, esa-icon-button, a brand lockup) INHERIT the color —
// so a bar's brand comes entirely from tokens, never from the children.
//
//   tone="surface"      → --color-background-elevation-raised bg, primary text
//   tone="brand"        → --color-background-brand bg, inverse text          (primary bar)
//   tone="brand-strong" → --color-background-default-knockout bg, inverse text  (dark sub-bar)
//
// THIS COMPONENT HAS NO TIER-3 SURFACE, and the paragraph that used to sit here
// claimed nine hooks it had not read since 2026-08-16 — --app-bar-{gap,pad-x,pad-y}
// and the six per-tone colour hooks. The tier-3 demotion pass deleted all nine
// (migrations.json: app-bar-hooks-removed) because each was read by exactly one
// component and held no value of its own, aliasing a tier-2 role it had no reason
// to diverge from. The stylesheet below points straight at those roles, which is
// the intended end state — do NOT re-add the hooks.
//
// The comment outlived the tokens by six weeks and cost real time: it reads as a
// wiring bug ("documented hooks the CSS forgot to read"), and the honest-looking
// fix — making the CSS read them again — would have re-added nine tier-2 aliases
// AND silently applied two callers' stale overrides, moving this bar from 32px to
// 12px gaps and from #fcfcfc to #f0f0f0. Retheme by re-pointing the tier-2 roles;
// change DENSITY by adding a variant here, not a per-instance knob.
type AppBarTone = 'surface' | 'brand' | 'brand-strong';

interface Props {
  tone?: AppBarTone;
  /** Constrain the inner row to `maxWidth` and center it. */
  contained?: boolean;
  maxWidth?: string;
  /** Semantic host element. */
  as?: 'header' | 'nav' | 'footer' | 'div';
  /**
   * Accessible name for the host element. REQUIRED whenever `as="nav"` — an
   * unnamed navigation landmark is indistinguishable from every other one in a
   * screen reader's landmark list, and this component spreads no rest props, so
   * without this there was no way to name one at all. Do NOT include the word
   * "navigation": the role is already announced, so `label="Main"` reads as
   * "Main, navigation" while `label="Main navigation"` stutters.
   */
  ariaLabel?: string;
  /** Extra class on the root, for per-instance layout overrides. */
  class?: string;
}

// TYPE: the three slot regions carry `label-md` so raw text dropped into a bar
// names a role instead of inheriting whatever the page happens to be. It is a
// DEFAULT, not a dictate — any esa-* slotted in brings its own composite and wins.
// The import is the Astro half of the composite mechanism; Lit siblings get it via
// `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

const { tone = 'surface', contained = false, maxWidth = '1556px', as = 'div', ariaLabel, class: className } = Astro.props;
const Tag = as;
const hasStart = Astro.slots.has('start');
const hasEnd = Astro.slots.has('end');
const cls = ['esa-app-bar', `esa-app-bar--${tone}`, className].filter(Boolean).join(' ');
const rowCls = ['esa-app-bar__row', contained && 'esa-app-bar__row--contained'].filter(Boolean).join(' ');
---
<Tag class={cls} aria-label={ariaLabel}>
  <div class={rowCls} style={contained ? `--_bar-max:${maxWidth}` : undefined}>
    {hasStart && (
      <div class="esa-app-bar__start typography-label-md"><slot name="start" /></div>
    )}
    <div class="esa-app-bar__main typography-label-md"><slot /></div>
    {hasEnd && (
      <div class="esa-app-bar__end typography-label-md"><slot name="end" /></div>
    )}
  </div>
</Tag>

<style>
  .esa-app-bar {
    /* PRIVATE. These are --_ prefixed for a reason: there is no public knob behind
       them any more (app-bar-hooks-removed, 2026-08-16). They read tier-1 spacing
       steps directly. Density belongs in a variant, not a per-instance override. */
    --_bar-gap: var(--spacing-600, 32px);
    --_bar-pad-x: var(--spacing-600, 32px);
    --_bar-pad-y: var(--spacing-400, 16px);

    display: block;
    width: 100%;
    background: var(--color-background-elevation-raised, #fcfcfc);
    color: var(--color-content-default, #202020);
  }
  .esa-app-bar--brand {
    background: var(--color-background-brand, #46a758);
    color: var(--color-content-default-knockout, #fcfcfc);
  }
  .esa-app-bar--brand-strong {
    background: var(--color-background-default-knockout, #202020);
    color: var(--color-content-default-knockout, #fcfcfc);
  }

  .esa-app-bar__row {
    display: flex;
    align-items: center;
    gap: var(--_bar-gap);
    padding: var(--_bar-pad-y) var(--_bar-pad-x);
  }
  .esa-app-bar__row--contained {
    max-width: var(--_bar-max, 1556px);
    margin-inline: auto;
  }

  /* start = left group · main = grows · end = pushed right */
  .esa-app-bar__start,
  .esa-app-bar__main,
  .esa-app-bar__end {
    display: inline-flex;
    align-items: center;
    gap: var(--_bar-gap);
  }
  .esa-app-bar__start { flex: none; }
  /* min-width: 0 or this never shrinks. A flex item's automatic minimum size is
     its content's min-content size, so a bar whose middle region holds anything
     with a fixed width pushes the `end` slot straight out through the bar's own
     right edge rather than compressing. Measured on esa-app-shell once its bar
     stopped spanning the full window: the profile button overflowed by 16px. */
  .esa-app-bar__main { flex: 1 1 auto; min-width: 0; }
  .esa-app-bar__end { flex: none; margin-left: auto; }
</style>
