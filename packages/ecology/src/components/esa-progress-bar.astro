---
// esa-progress-bar — presentational (.astro).
// Faithful translation of the Angular esa-progress-bar: determinate/indeterminate
// modes, size and color variants, optional label + percentage value, and the
// clamped 0–100 fill. Angular host classes/aria bindings → class list + attributes;
// @if → conditional render. (Static value snapshot — for live updates use a stack's
// own binding; the visual + token contract is preserved.)
interface Props {
  value?: number;
  mode?: 'determinate' | 'indeterminate';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'success' | 'warning' | 'danger';
  label?: string;
  /**
   * Show the numeric percentage. Defaults to `true` as of 2026-08-16 (was `false`):
   * the fill and the track differ ONLY by background colour, so in forced colors
   * mode both flatten to Canvas and a bar with no readout is unreadable at every
   * value. Opt out per instance where the bar is genuinely decorative.
   */
  showValue?: boolean;
}
const {
  value = 0,
  mode = 'determinate',
  size = 'md',
  variant = 'primary',
  label = '',
  showValue = true,
} = Astro.props;

// The header line (label + percentage) is UI text — the label composite, one rung
// per size. The import is the Astro half of the composite mechanism; Lit siblings
// get it via `static styles = [typography, …]`.
import '@esa/tokens/typography.css';

// Two ramps, not one. The header carries the size for both children, but only the
// LABEL was ever medium — the percentage read at the body weight it inherited. One
// ramp on the header would have quietly promoted the value to medium too.
const VALUE_TYPE = { xs: 'body-2xs', sm: 'body-xs', md: 'body-sm', lg: 'body-md' } as const;
const LABEL_TYPE = { xs: 'label-2xs', sm: 'label-xs', md: 'label-sm', lg: 'label-md' } as const;

const clampedValue = Math.max(0, Math.min(100, value));
const isDeterminate = mode === 'determinate';

const cls = [
  'esa-progress-bar',
  `esa-progress-bar--${size}`,
  `esa-progress-bar--${variant}`,
  mode === 'indeterminate' && 'esa-progress-bar--indeterminate',
]
  .filter(Boolean)
  .join(' ');

const showHeader = !!label || showValue;
---
{/*
  role="progressbar" is CORRECT here and is deliberately not a live region. A value
  that changes is a state change, and `aria-valuenow` is the property that reports it;
  wrapping this in aria-live would announce every increment, which is the textbook
  misuse. If a stack needs to announce that a long job finished, that is one call to
  `announce()` (../announcer.ts) at the end, not a region around the bar.

  Indeterminate mode is the gap this closes. It has no `aria-valuenow` by definition,
  so the bar announced as a progressbar with no value and nothing to say it was
  working — a screen reader read "Progress, progress bar" and stopped. `aria-busy`
  says the thing is in progress, and `aria-valuetext` gives the state a word, since
  there is no number to give.
*/}
<div
  class={cls}
  role="progressbar"
  aria-valuenow={isDeterminate ? clampedValue : undefined}
  aria-valuemin={isDeterminate ? '0' : undefined}
  aria-valuemax={isDeterminate ? '100' : undefined}
  aria-valuetext={isDeterminate ? undefined : 'Working'}
  aria-busy={isDeterminate ? undefined : 'true'}
  aria-label={label || 'Progress'}
>
  {showHeader && (
    <div class={`esa-progress-bar__header typography-${VALUE_TYPE[size]}`}>
      {label && <span class={`esa-progress-bar__label typography-${LABEL_TYPE[size]}`}>{label}</span>}
      {showValue && isDeterminate && (
        <span class="esa-progress-bar__value">{clampedValue}%</span>
      )}
    </div>
  )}
  <div class="esa-progress-bar__track">
    <div
      class="esa-progress-bar__fill"
      style={isDeterminate ? `width: ${clampedValue}%` : undefined}
    ></div>
  </div>
</div>

<style>
  .esa-progress-bar {
    --_progress-height: var(--progress-bar-height-md, 8px);
    --_progress-radius: var(--radius-pill, 9999px);
    --_progress-track-bg: var(--color-background-elevation-sunken, #f0f0f0);
    --_progress-fill-bg: var(--color-background-brand, #46a758);

    display: block;
    width: 100%;
  }

  .esa-progress-bar__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-100, 0.25rem);
  }

  .esa-progress-bar__label {
    color: var(--color-content-default, #202020);
  }

  .esa-progress-bar__value {
    color: var(--color-content-default-secondary, #646464);
    font-variant-numeric: tabular-nums;
  }

  .esa-progress-bar__track {
    position: relative;
    height: var(--_progress-height);
    border-radius: var(--_progress-radius);
    background: var(--_progress-track-bg);
    overflow: hidden;
  }

  .esa-progress-bar__fill {
    height: 100%;
    border-radius: var(--_progress-radius);
    background: var(--_progress-fill-bg);
    transition: width 300ms ease;
  }

  /* Size no longer carries a font-size — that rung comes from LABEL_TYPE above. */
  .esa-progress-bar--xs { --_progress-height: var(--progress-bar-height-xs, 2px); }
  .esa-progress-bar--sm { --_progress-height: var(--progress-bar-height-sm, 4px); }
  .esa-progress-bar--lg { --_progress-height: var(--progress-bar-height-lg, 12px); }

  .esa-progress-bar--success { --_progress-fill-bg: var(--color-background-utility-success, #bdee63); }
  .esa-progress-bar--warning { --_progress-fill-bg: var(--color-background-utility-warning, #ffc53d); }
  .esa-progress-bar--danger  { --_progress-fill-bg: var(--color-background-utility-danger, #e5484d); }

  .esa-progress-bar--indeterminate .esa-progress-bar__fill {
    width: 40% !important;
    animation: esa-progress-indeterminate var(--animation-indeterminate, 1500ms ease-in-out infinite);
  }

  /* An infinite animation is what SC 2.2.2 (Pause, Stop, Hide) and the reduced-motion
     preference are about. Stopping it outright would read as a stalled job, so it
     slows to a pulse that still says "working" without sliding across the screen. */
  @media (prefers-reduced-motion: reduce) {
    .esa-progress-bar--indeterminate .esa-progress-bar__fill {
      animation: esa-progress-pulse 2s ease-in-out infinite;
      width: 100% !important;
    }
    .esa-progress-bar__fill {
      transition: none;
    }
  }

  @keyframes esa-progress-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  @keyframes esa-progress-indeterminate {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(150%); }
    100% { transform: translateX(-100%); }
  }

  /* FORCED COLORS. Track and fill are two backgrounds and nothing else — no
     border on either — so both flatten to Canvas and the bar reads as empty at
     every value, in every variant. The track takes a real edge, the fill takes
     Highlight, and the two are distinguishable again.

     The four variants (primary/success/warning/danger) differ only by
     --_progress-fill-bg and cannot be told apart here; as with the badge dot,
     there is no system colour that means "warning". `label` and the numeric
     readout are what carry meaning, which is why showValue now defaults to true.

     Indeterminate mode keeps its transform animation — transform is not
     force-adjusted, so the motion survives once the fill is visible. */
  @media (forced-colors: active) {
    .esa-progress-bar__track {
      border: 1px solid CanvasText;
      background: Canvas;
    }
    .esa-progress-bar__fill { background: Highlight; }
  }
</style>
