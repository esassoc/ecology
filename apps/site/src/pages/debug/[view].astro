    <Section id="core" title="Tier 1 · Core / universal">
      <p>{coreCategory.note}</p>
      <div class="core-wrap">
        {coreCategory.groups.map((group) => (
          <details class="tok-group is-core" data-group>
            <summary>
              <code class="group-label">{group.label}</code>
              <span class="summary-right">
                <span class="core-flag">core</span>
                <span class="group-count">{group.tokens.length}</span>
              </span>
            </summary>
            <p class="cat-note">{coreSetNotes[group.label]}</p>
            <TokenGroupTable group={group} bare />
          </details>
        ))}
      </div>
      <p class="cat-note">
        Verified against <code>themes.css</code>: neither shipped theme (beacon, qanat) re-points any
        token in these three sets, so the core contract holds today. Z-index is a further candidate —
        it is theme-invariant here and is conventionally managed as core/shared — but it is left out
        above rather than promoted silently.
      </p>
    </Section>

    <Section id="primitive" title="Tier 1 · Primitive">
      <p>{TIER_NOTE.primitive}</p>
      {primitiveCategories.map((cat) => (
        <details class="tok-category" data-group>
          <summary>
            <span class="cat-label">{cat.label}</span>
            <span class="summary-right">
              {cat.gap && <span class="gap-flag">diverges</span>}
              <span class="group-count">{cat.count}</span>
            </span>
          </summary>
          <p class="cat-note">{cat.note}</p>
          {cat.gap && (
            <p class="cat-gap">
              <b>What we actually ship:</b> {cat.gap}
            </p>
          )}
          {cat.groups.length === 1 && cat.groups[0].label === cat.label.toLowerCase() ? (
            <TokenGroupTable group={cat.groups[0]} bare />
          ) : (
            <div class="cat-body">
              {cat.groups.map((group) => <TokenGroupTable group={group} />)}
            </div>
          )}
        </details>
      ))}
    </Section>
  </article>
</DocsLayout>

