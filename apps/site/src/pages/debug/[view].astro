            ))}
          </tbody>
        </table>
      </details>

      <h3 class="sub">Slot 4 · variant — present, and in the wrong place</h3>
      <div class="tally">
        <div class="tally-cell"><b>{t3.sizeRows.short.length + t3.sizeRows.long.length}</b><span>carry a size</span></div>
        <div class="tally-cell warn"><b>{t3.sizeRows.afterProperty.length}</b><span>of those, size after the property</span></div>
        <div class="tally-cell warn"><b>{t3.sizeRows.long.length}</b><span>in the long dialect</span></div>
