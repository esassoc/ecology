    <Section id="semantic" title="Tier 2 · Semantic">
      <p>{TIER_NOTE.semantic}</p>
      <p class="cat-note">
        Colour tokens map tier 1 to specific colour roles in the default (vanilla) theme, grouped here
        by <b>property</b> — the surface the colour lands on — then by variant family within each.
        Only {t2.surfaceNamed} of {t2.colorTotal} spell their property in the name; the other
        {' '}{t2.surfaceImplied} are placed by convention and marked <span class="inf">inferred</span>,
        so this grouping doubles as the worklist for making the names say what the grouping knows.
      </p>

      {t2.propertyGroups.map((prop) => (
        <details class="tok-category prop" data-group open>
          <summary>
            <span class="cat-label">{prop.label}</span>
            <span class="summary-right">
              {prop.inferred > 0 && <span class="inf-flag">{prop.inferred} inferred</span>}
              <span class="group-count">{prop.total}</span>
            </span>
          </summary>
          <p class="cat-note">{prop.note}</p>
          <p class="cat-note">
            Spelled in the name as {prop.words.map((w) => <code class="vocab">{w}</code>)}
            {prop.words.length > 1 && <span> — {prop.words.length} words for one property.</span>}
            {' '}<b>{prop.declared}</b> declared · <b>{prop.inferred}</b> inferred.
          </p>
          <div class="cat-body">
            {prop.families.map((fam) => (
              <details class="tok-group" data-group>
                <summary>
                  <code class="group-label">{fam.label}</code>
                  <span class="summary-right"><span class="group-count">{fam.rows.length}</span></span>
                </summary>
                <table class="tok-table">
                  <thead>
                    <tr><th>Token</th><th>Property</th><th>Variant</th><th>State</th><th>Resolves to</th><th>Used by</th></tr>
                  </thead>
                  <tbody>
                    {fam.rows.map((r) => {
                      const node = t2.semanticNodes.get(r.name);
                      return (
                        <tr data-token={r.name} title={node?.description ?? undefined}>
                          <td class="c-name"><code>{r.name}</code></td>
                          <td>
                            {r.declared ? (
                              <code class="vocab">{r.word}</code>
                            ) : (
                              <span class="inf" title={r.reason ?? undefined}>inferred</span>
                            )}
                          </td>
                          <td>{r.variant ? <code class="vocab">{r.variant}</code> : <span class="dim">—</span>}</td>
                          <td>{r.state ? <code class="vocab st">{r.state}</code> : <span class="dim">—</span>}</td>
                          <td class="c-value">
                            {node?.isColor && <span class="swatch" style={`background:${node.resolved}`} />}
                            <code>{node?.lineage[0]?.ref ?? '—'}</code>
                            <span class="dim"> · {node?.resolved}</span>
                          </td>
                          <td class="c-used">
                            {node && node.usedByTokens.length === 0 && node.usedByComponents.length === 0 ? (
                              <span class="orphan-flag">orphan</span>
                            ) : (
                              <details class="uses">
                                <summary>
                                  {node && node.usedByTokens.length > 0 && <span class="pill">{node.usedByTokens.length} tok</span>}
                                  {node && node.usedByComponents.length > 0 && <span class="pill">{node.usedByComponents.length} comp</span>}
                                </summary>
                                {node && node.usedByTokens.length > 0 && <p><b>Tokens:</b> {node.usedByTokens.join(', ')}</p>}
                                {node && node.usedByComponents.length > 0 && <p><b>Components:</b> {node.usedByComponents.join(', ')}</p>}
                              </details>
