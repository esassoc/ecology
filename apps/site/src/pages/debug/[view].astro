<!-- is:inline for the same reason as the <style> above: an Astro-processed
     script is bundled into dist/_astro/ even when the page itself is never
     emitted, leaving an orphan chunk in the shipped output. Inline means plain
     JS (no TS annotations) and no bundling — correct for a dev-only page. -->
<script is:inline>
  // Filter by token name. A group with no visible row hides itself, and any
  // group holding a match opens so hits are never buried behind a closed
  // <details>. Clearing the box re-collapses everything.
  (function () {
    var input = document.getElementById('tok-filter');
    var count = document.getElementById('tok-count');
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('tr[data-token]'));

    // The Core section is a second view over tokens that also appear under their
    // property category, so a row count would double-count them. Count distinct
    // token NAMES instead — otherwise the page claims more tokens than exist.
    function distinct(list) {
      var seen = {};
      var n = 0;
      list.forEach(function (name) { if (!seen[name]) { seen[name] = 1; n++; } });
      return n;
    }
    var totalDistinct = distinct(rows.map(function (r) { return r.dataset.token; }));

    function apply() {
      var q = ((input && input.value) || '').trim().toLowerCase();
      var hits = [];
      rows.forEach(function (row) {
        var hit = !q || (row.dataset.token || '').toLowerCase().indexOf(q) !== -1;
        row.hidden = !hit;
        if (hit) hits.push(row.dataset.token);
      });
      var shown = distinct(hits);
      groups.forEach(function (group) {
        var any = group.querySelector('tr[data-token]:not([hidden])') !== null;
        // Only hide while filtering. An expected-but-empty group has no rows and
        // must stay visible at rest — that hole in the set is the point.
        group.hidden = q ? !any : false;
        group.open = q ? any : false;
      });
      if (count) count.textContent = q ? shown + ' of ' + totalDistinct : totalDistinct + ' tokens';
    }

    if (input) input.addEventListener('input', apply);
    apply();
  })();
</script>
