    border: 1px solid transparent;
  }
  .tokens-debug .f-absent, .tokens-debug .f-missing {
    color: var(--color-content-danger, #c62a2f);
    background: var(--color-background-danger-subtle, #fef2f2);
    border-color: var(--color-border-danger, #fbbcbc);
  }
  .tokens-debug .f-partial, .tokens-debug .f-renamed {
    color: var(--color-content-warning, #a35200);
    background: var(--color-background-warning-subtle, #fffbeb);
    border-color: var(--color-border-warning, #fcd34d);
  }
  .tokens-debug .f-match {
    color: var(--color-content-success, #2a7e3b);
    background: var(--color-background-success-subtle, #f0fdf4);
    border-color: var(--color-border-success, #a7e8a7);
  }
  .tokens-debug .f-extra {
    color: var(--color-content-default-secondary, #666);
    background: var(--color-background-elevation-sunken, #f4f4f4);
    border-color: var(--color-border-default, #d4d4d4);
  }
  .tokens-debug tr.slot-absent td { background: var(--color-background-danger-subtle, #fef2f2); }
  .tokens-debug tr.slot-match td { background: var(--color-background-success-subtle, #f0fdf4); }
  .tokens-debug tr.row-zero code { color: var(--color-content-default-muted, #999); }

  .tokens-debug code.vocab {
    display: inline-block;
    margin: 1px 4px 1px 0;
    padding: 1px 6px;
    font-size: 0.72rem;
    border-radius: var(--radius-100, 4px);
    background: var(--color-background-elevation-sunken, #f4f4f4);
    border: 1px solid var(--color-border-default-subtle, #e5e5e5);
  }
  .tokens-debug code.vocab.st { background: var(--color-background-info-subtle, #eff6ff); border-color: var(--color-border-info, #93c5fd); }
  /* Knocked out, literally — the chip renders as its own subject. */
  .tokens-debug code.vocab.ko {
    background: var(--color-background-default-knockout, #202020);
    border-color: var(--color-background-default-knockout, #202020);
    color: var(--color-content-default-knockout, #fcfcfc);
  }
  .tokens-debug code.vocab.warnv { background: var(--color-background-warning-subtle, #fffbeb); border-color: var(--color-border-warning, #fcd34d); }

  .tokens-debug .ord {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .tokens-debug .o-rubric { color: var(--color-content-success, #2a7e3b); }
  .tokens-debug .o-inverted { color: var(--color-content-danger, #c62a2f); font-weight: 600; }
  .tokens-debug .o-surface-only, .tokens-debug .o-none { color: var(--color-content-default-muted, #999); }
  .tokens-debug table.parse .notes { font-size: 0.72rem; color: var(--color-content-default-secondary, #666); max-width: 30ch; }
  .tokens-debug table.parse .notes div + div { margin-top: 3px; }
  .tokens-debug .num { font-variant-numeric: tabular-nums; }

  /* Tier-2 CATEGORY level — the outermost node, and the one that answers "what
     kind of token is this" before anything else. Prose-cased and heavier than the
     property beneath it, so the two levels are told apart at a glance rather than
     by counting indents. */
  .tokens-debug details.tok-category.cat > summary .cat-label {
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }
  .tokens-debug details.tok-category.cat { border-width: 2px; }

  /* A neutral-by-name token whose VALUE comes from another intention. Quiet, and
     next to the name rather than the value column, because the disagreement is
     between those two things and the name is the half that looks fine alone. */
  .tokens-debug .derived {
    margin-inline-start: var(--spacing-150, 6px);
    font-size: 0.65rem;
    color: var(--color-content-default-secondary, #666);
    border: 1px solid var(--color-border-default, #d4d4d4);
    border-radius: var(--radius-100, 4px);
    padding: 0 4px;
    cursor: help;
    white-space: nowrap;
  }

  /* Tier-2 grouped by property, one level in. The property level answers "which
     declaration does this land in" — for colour, the surface. Mono-cased because
     these are literal CSS property names. */
  .tokens-debug details.tok-category.prop > summary .cat-label {
    text-transform: lowercase;
    font-family: var(--typography-font-family-mono, ui-monospace, monospace);
    font-size: 0.9rem;
  }
  .tokens-debug details.tok-category.prop { border-left: 3px solid var(--color-background-brand, #16a34a); }
  /* Nested inside a category: drop the box so the property reads as a CHILD of the
     category rather than a second card of equal weight. The left rule is the only
     chrome it needs at this depth. */
  .tokens-debug .cat-body details.tok-category.prop {
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    border-radius: 0;
    background: transparent;
    margin-bottom: var(--spacing-200, 8px);
  }
  /* .cat-note carries its own inset for the flat case; inside a .cat-body that is
     already inset it doubles up and the prose drifts right at every level. */
  .tokens-debug .cat-body > .cat-note { padding-inline: 0; }
  /* `inferred` marks a token whose property the NAME does not carry — the thing
     this grouping is meant to make visible, so it stays legible, not decorative. */
  .tokens-debug .inf {
    font-size: 0.7rem;
    font-style: italic;
    color: var(--color-content-warning, #a35200);
    border-bottom: 1px dotted var(--color-content-warning, #ab6400);
    cursor: help;
  }
  /* Typography roles: six fixed property columns, so the table is wide. Let it
     scroll inside its own box rather than pushing the page sideways. */
  .tokens-debug details.tok-category.type > .cat-body { overflow-x: auto; }
  .tokens-debug table.type-table { min-width: 60rem; }
  .tokens-debug table.type-table td { white-space: nowrap; }
  .tokens-debug table.type-table .resolved { display: block; font-size: 0.68rem; margin-top: 2px; }
  .tokens-debug table.type-table .fb { display: block; font-size: 0.65rem; color: var(--color-content-default-muted, #999); margin-top: 2px; }
  /* The tier-1 token behind the hook. Same shape as the colour rows' tier-1
     column — the value alone says what renders, this says which step of the
     scale it came from. */
  .tokens-debug table.type-table .t1 {
    display: block;
    font-size: 0.68rem;
    color: var(--color-content-default-secondary, #525252);
    margin-top: 2px;
  }
  .tokens-debug table.type-table .t1 .arrow { margin: 0 3px 0 0; }
  /* The end of the chain — the tier-1 step the composite actually lands on. */
  .tokens-debug table.type-table .t1 .t1-ref { color: var(--color-content, #171717); font-weight: 600; }
  .tokens-debug table.type-table .t1.direct { color: var(--color-content-warning, #a35200); }
  /* An unset property is the finding, not an absence — mark it, don't blank it.
     The quiet hatch is opt-in-unset; is-required is the one that's a defect. */
  .tokens-debug .req {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
    color: var(--color-content-danger, #c62a2f);
  }
  .tokens-debug table.type-table td.is-required { background: var(--color-background-danger-subtle, #fef2f2); }
  .tokens-debug table.type-table td.unset {
    background: repeating-linear-gradient(
      45deg,
      transparent, transparent 4px,
      var(--color-background-elevation-sunken, #f4f4f4) 4px, var(--color-background-elevation-sunken, #f4f4f4) 8px
    );
    font-size: 0.7rem;
    font-style: italic;
  }
  .tokens-debug table.findings .detail { font-size: 0.78rem; line-height: 1.55; max-width: 46ch; }
  .tokens-debug .pair {
    font-size: 0.7rem;
    color: var(--color-content-success, #2a7e3b);
  }
  .tokens-debug .inf-flag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-content-warning, #a35200);
    border: 1px solid var(--color-border-warning, #fcd34d);
    background: var(--color-background-warning-subtle, #fffbeb);
    border-radius: var(--radius-100, 4px);
    padding: 1px 6px;
  }

  /* Tier-3 audit: what a word in the part position actually turned out to be. */
  .tokens-debug .pk {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-100, 4px);
    padding: 1px 6px;
    border: 1px solid transparent;
  }
  .tokens-debug .pk-part {
    color: var(--color-content-default-secondary, #525252);
    border-color: var(--color-border-default, #e5e5e5);
  }
  .tokens-debug .pk-variant,
  .tokens-debug .pk-state {
    color: var(--color-content-warning, #a35200);
    border-color: var(--color-border-warning, #fcd34d);
    background: var(--color-background-warning-subtle, #fffbeb);
  }

  /* ---------------------------------------------- tier-1 naming audit */
  .tokens-debug .alias-list { display: block; margin: var(--spacing-200, 8px) 0; }
  .tokens-debug .rank { width: 1.5rem; color: var(--color-content-default-muted, #999); }
  /* A finding whose check now returns zero. Deliberately keeps the finding text
     above it — the record of what was wrong is the useful part. */
  .tokens-debug .resolved {
    margin: var(--spacing-300, 12px) 0;
    padding: var(--spacing-300, 12px);
    border: 1px solid var(--color-border-success, #a7e8a7);
    border-radius: var(--radius-200, 6px);
    background: var(--color-background-success-subtle, #f0fdf4);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .tokens-debug .resolved .slot-flag { margin: 0 var(--spacing-200, 8px) 0 0; }
  .tokens-debug tr.is-done td { opacity: 0.72; }
  .tokens-debug tr.is-done .rank { color: var(--color-content-success, #2a7e3b); }
  /* The verdict cells in this section pair a flag chip with a sentence. */
  .tokens-debug table.findings td.detail > div { margin-top: 4px; }
</style>

<!-- is:inline for the same reason as the <style> above: an Astro-processed
     script is bundled into dist/_astro/ even when the page itself is never
     emitted, leaving an orphan chunk in the shipped output. Inline means plain
     JS (no TS annotations) and no bundling — correct for a dev-only page. -->
<script is:inline>
  // Filter by token name. A group with no visible row hides itself, and any
  // group holding a match opens so hits are never buried behind a closed
  // <details>. Clearing the box re-collapses everything.
  (function () {
    var input = document.getElementById('tok-filter');
    var count = document.getElementById('tok-count');
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('tr[data-token]'));

    // The Core section is a second view over tokens that also appear under their
    // property category, so a row count would double-count them. Count distinct
    // token NAMES instead — otherwise the page claims more tokens than exist.
    function distinct(list) {
      var seen = {};
      var n = 0;
      list.forEach(function (name) { if (!seen[name]) { seen[name] = 1; n++; } });
      return n;
    }
    var totalDistinct = distinct(rows.map(function (r) { return r.dataset.token; }));

    function apply() {
      var q = ((input && input.value) || '').trim().toLowerCase();
      var hits = [];
      rows.forEach(function (row) {
        var hit = !q || (row.dataset.token || '').toLowerCase().indexOf(q) !== -1;
        row.hidden = !hit;
        if (hit) hits.push(row.dataset.token);
      });
      var shown = distinct(hits);
      groups.forEach(function (group) {
        var any = group.querySelector('tr[data-token]:not([hidden])') !== null;
        // Only hide while filtering. An expected-but-empty group has no rows and
        // must stay visible at rest — that hole in the set is the point.
        group.hidden = q ? !any : false;
        group.open = q ? any : false;
      });
      if (count) count.textContent = q ? shown + ' of ' + totalDistinct : totalDistinct + ' tokens';
    }

    if (input) input.addEventListener('input', apply);
    apply();
  })();
</script>
