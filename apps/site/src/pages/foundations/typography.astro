---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { withBase } from '@esa/docs/base';
import Section from '@esa/docs/Section.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
// The REAL composite stylesheet, so this page demonstrates the shipped artifact
// rather than a copy of it. It used to carry local copies of every role, which
// had already drifted — none of them set font-family, so the specimen was
// showing something the class does not actually do.
import '@esa/tokens/typography.css';

const families = [
  { token: '--typography-font-family-sans', value: "'DM Sans', sans-serif", usedFor: 'UI, body, headings' },
  { token: '--typography-font-family-mono', value: "'DM Mono', monospace", usedFor: 'Code, tabular data, tokens' },
];

const scale = [
  { token: '--font-size-050', min: '8px', max: '10px' },
  { token: '--font-size-100', min: '10px', max: '12px' },
  { token: '--font-size-150', min: '11px', max: '14px' },
  { token: '--font-size-200', min: '12px', max: '15px' },
  { token: '--font-size-250', min: '13px', max: '17px' },
  { token: '--font-size-300', min: '14px', max: '18px' },
  { token: '--font-size-400', min: '16px', max: '20px' },
  { token: '--font-size-500', min: '18px', max: '24px' },
  { token: '--font-size-600', min: '22px', max: '30px' },
  { token: '--font-size-700', min: '26px', max: '36px' },
  { token: '--font-size-800', min: '32px', max: '44px' },
  { token: '--font-size-900', min: '40px', max: '54px' },
  { token: '--font-size-1000', min: '48px', max: '64px' },
];

const weights = [
  { token: '--typography-font-weight-light', value: 300, label: 'Light' },
  { token: '--typography-font-weight-regular', value: 350, label: 'Regular' },
  { token: '--typography-font-weight-medium', value: 500, label: 'Medium' },
  { token: '--typography-font-weight-semibold', value: 550, label: 'Semibold' },
  { token: '--typography-font-weight-bold', value: 650, label: 'Bold' },
];

const lineHeights = [
  { token: '--line-height-none', value: '1', usedFor: 'Single-line control labels — the box supplies the height' },
  { token: '--line-height-tight', value: '1.3', usedFor: 'Headings, dense titles, helper text' },
  { token: '--line-height-normal', value: '1.6', usedFor: 'UI text, labels' },
  { token: '--line-height-relaxed', value: '1.8', usedFor: 'Long-form body copy' },
];

const letterSpacing = [
  { token: '--letter-spacing-tight', value: '-0.01em', usedFor: 'Large headings' },
  { token: '--letter-spacing-normal', value: '0', usedFor: 'No tracking — tabular figures, mono runs' },
  { token: '--letter-spacing-default', value: '0.01em', usedFor: 'Body and UI — 21 of 24 composites' },
  { token: '--letter-spacing-wide', value: '0.03em', usedFor: 'Small caps emphasis' },
  { token: '--letter-spacing-wider', value: '0.06em', usedFor: 'Overlines, all-caps labels' },
];

/* ---------------------------------------------------------------------------
 * The tier-2 composite tokens, read from the COMPILED output rather than typed
 * here, so this table cannot drift from what actually ships. Same build-time
 * pattern theming.ts uses for the per-component "Theming surface" tables.
 * ------------------------------------------------------------------------ */
const TOKENS_CSS = readFileSync(
  path.join(fileURLToPath(new URL('../../../../../packages/tokens/dist/tokens.css', import.meta.url))),
  'utf8',
);

const declared = new Map<string, string>();
for (const m of TOKENS_CSS.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)) {
  if (!declared.has(m[1])) declared.set(m[1], m[2].trim());
}

/** Walk a var() chain to the terminal literal. */
const resolveToken = (name: string, depth = 0): string => {
  const v = declared.get(name);
  if (v == null || depth > 10) return v ?? '—';
  const ref = v.match(/^var\(\s*(--[\w-]+)\s*\)$/);
  return ref ? resolveToken(ref[1], depth + 1) : v;
};

/** The tier-1 token a composite part points at, if it points at one. */
const pointsAt = (name: string): string | null =>
  declared.get(name)?.match(/^var\(\s*(--[\w-]+)\s*\)$/)?.[1] ?? null;

// Fixed order so every composite reads down the same columns; one that does not
// set a property shows nothing rather than silently reordering the list.
const TYPE_PROPS = [
  'font-family',
  'font-size',
  'font-weight',
  'line-height',
  'letter-spacing',
  'text-transform',
] as const;

/** The individual tier-2 tokens that make up one composite. */
const partsOf = (intention: string) =>
  TYPE_PROPS.map((prop) => `--typography-${intention}-${prop}`)
    .filter((t) => declared.has(t))
    .map((token) => ({
      token,
      prop: token.replace(`--typography-${intention}-`, ''),
      pointsAt: pointsAt(token),
      resolved: resolveToken(token),
    }));

// `was` is the pre-composite class name, kept as a deprecated alias in
// typography.css. Rendered so a spoke can find its migration in one place.
const composites = [
  { cls: 'typography-display',    token: '--typography-display-*',    note: 'size-800 · bold · tight',        was: null },
  { cls: 'typography-heading-lg', token: '--typography-heading-lg-*', note: 'size-600 · semibold · tight',    was: '.type-page-title' },
  { cls: 'typography-heading-md', token: '--typography-heading-md-*', note: 'size-500 · semibold · tight',    was: '.type-section-title' },
  { cls: 'typography-title', token: '--typography-title-*', note: 'size-400 · medium · normal',     was: '.type-card-title' },
  { cls: 'typography-body-lg',    token: '--typography-body-lg-*',    note: 'size-300 · regular · relaxed',   was: '.type-body-large' },
  { cls: 'typography-body-md',    token: '--typography-body-md-*',    note: 'size-200 · regular · relaxed',   was: '.type-body' },
  { cls: 'typography-body-sm',    token: '--typography-body-sm-*',    note: 'size-150 · regular · normal',    was: '.type-body-small' },
  { cls: 'typography-body-xs',    token: '--typography-body-xs-*',    note: 'size-100 · regular · normal',    was: null },
  { cls: 'typography-body-2xs',   token: '--typography-body-2xs-*',   note: 'size-050 · regular · normal',    was: null },
  { cls: 'typography-label-lg', token: '--typography-label-lg-*', note: 'size-300 · medium · normal',     was: null },
  { cls: 'typography-label-md', token: '--typography-label-md-*', note: 'size-200 · medium · normal',     was: null },
  { cls: 'typography-label-sm', token: '--typography-label-sm-*', note: 'size-150 · medium · normal',     was: null },
  { cls: 'typography-label-xs', token: '--typography-label-xs-*', note: 'size-100 · medium · normal',     was: '.typography-label' },
  { cls: 'typography-label-2xs', token: '--typography-label-2xs-*', note: 'size-050 · medium · normal',   was: null },
  { cls: 'typography-label-lg-strong', token: '--typography-label-lg-strong-*', note: 'size-300 · semibold · normal', was: null },
  { cls: 'typography-label-md-strong', token: '--typography-label-md-strong-*', note: 'size-200 · semibold · normal', was: null },
  { cls: 'typography-label-sm-strong', token: '--typography-label-sm-strong-*', note: 'size-150 · semibold · normal', was: null },
  { cls: 'typography-label-xs-strong', token: '--typography-label-xs-strong-*', note: 'size-100 · semibold · normal', was: null },
  { cls: 'typography-label-2xs-strong', token: '--typography-label-2xs-strong-*', note: 'size-050 · semibold · normal', was: null },
  { cls: 'typography-title-strong', token: '--typography-title-strong-*', note: 'size-400 · semibold · normal', was: null },
  { cls: 'typography-meta',       token: '--typography-meta-*',       note: 'size-100 · regular · normal',    was: '.type-caption' },
  { cls: 'typography-eyebrow-md', token: '--typography-eyebrow-md-*', note: 'size-100 · semibold · uppercase', was: null },
  { cls: 'typography-eyebrow-sm', token: '--typography-eyebrow-sm-*', note: 'size-050 · semibold · uppercase', was: '.type-overline' },
  { cls: 'typography-code-lg',    token: '--typography-code-lg-*',    note: 'mono · size-300',                was: null },
  { cls: 'typography-code-md',    token: '--typography-code-md-*',    note: 'mono · size-200',                was: null },
  { cls: 'typography-code-sm',    token: '--typography-code-sm-*',    note: 'mono · size-150',                was: '.type-code' },
];
---
<DocsLayout title="Typography — Ecology" activeHref="/foundations/typography">
  <nav class="crumbs"><a href={withBase('/')}>Ecology</a> <span>/</span> <span>Foundations</span> <span>/</span> <span>Typography</span></nav>
  <h1>Typography</h1>
  <p class="lede">One <strong>fluid type scale</strong> that interpolates between a small-screen min and a large-screen max, two font families, and and a set of <strong>composite tokens</strong> that bundle family, size, weight, line-height and tracking under one name.</p>

  <Section id="families" title="Font families">
    <p>DM Sans carries the entire UI. DM Mono is reserved for code, tokens and tabular figures.</p>
    <div class="families">
      {families.map((f) => (
        <div class="family">
          <div class="family__sample" style={`font-family: var(${f.token})`}>Aa Bb Cc 0123</div>
          <div class="family__meta">
            <code>{f.token}</code>
            <span class="family__value">{f.value}</span>
            <span class="family__role">{f.usedFor}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="scale" title="Type scale">
    <p>Each size is a <code>clamp()</code> — rendered here at its live computed value. The range shows the min (mobile) to max (desktop) px bounds.</p>
    <div class="scale">
      {scale.map((s) => (
        <div class="scale__row">
          <div class="scale__sample" style={`font-size: var(${s.token})`}>The quick brown fox</div>
          <div class="scale__meta">
            <code>{s.token}</code>
            <span class="scale__range">{s.min} → {s.max}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="weights" title="Font weights">
    <p>DM Sans is set on a custom axis — weights are intentionally a touch lighter than the usual 400/500/600/700 to read cleaner on screen.</p>
    <div class="weights">
      {weights.map((w) => (
        <div class="weight">
          <div class="weight__sample" style={`font-weight: var(${w.token})`}>{w.label}</div>
          <div class="weight__meta">
            <code>{w.token}</code>
            <span>{w.value}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="line-heights" title="Line heights">
    <div class="lh">
      {lineHeights.map((l) => (
        <div class="lh__row">
          <p class="lh__sample" style={`line-height: var(${l.token})`}>Ecology is a token-driven Angular component library. Line height controls vertical rhythm — tighter for headings, looser for sustained reading.</p>
          <div class="lh__meta">
            <code>{l.token}</code>
            <span class="lh__value">{l.value}</span>
            <span class="lh__role">{l.usedFor}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="letter-spacing" title="Letter spacing">
    <div class="ls">
      {letterSpacing.map((l) => (
        <div class="ls__row">
          <div class="ls__sample" style={`letter-spacing: var(${l.token})`}>Tracking sample · ESA Ecology</div>
          <div class="ls__meta">
            <code>{l.token}</code>
            <span class="ls__value">{l.value}</span>
            <span class="ls__role">{l.usedFor}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="composites" title="Composites">
    <p>
      A composite bundles the five tier-2 <code>--typography-*</code> tokens for one intention, and
      ships as a class because CSS has no composite custom property. The class carries the same name
      as its tokens — <code>.typography-body-sm</code> assembles
      <code>--typography-body-sm-*</code>. Nothing here restates a size or a
      weight — every value is a <code>var()</code>, so re-pointing
      <code>--typography-heading-lg-font-size</code> moves every large heading without touching
      the class.
    </p>
    <p>
      Names are <code>typography-&lt;intention&gt;[-&lt;variant&gt;]</code>: category, then the job the
      text does, then a t-shirt size where an intention has more than one. Where a composite lists a
      former name, that class still works as a deprecated alias — same tokens, same output — so
      migrating is a find-and-replace with no visual change.
    </p>
    <p>
      Open a composite to see the individual tokens it bundles. Note that <code>font-size</code>,
      <code>line-height</code> and <code>letter-spacing</code> point straight at a tier-1 value,
      while <code>font-family</code> and <code>font-weight</code> point at another <em>tier-2</em>
      role first (<code>--typography-font-family-display</code>, <code>--typography-font-weight-semibold</code>). That extra hop
      is deliberate: those two are the surface a spoke re-points when it swaps typeface, and a face
      change has to move every role at once rather than role by role.
    </p>
    <div class="roles">
      {composites.map((r) => (
        <details class="role">
          <summary class="role__head">
            <div class={`role__sample ${r.cls}`}>The quick brown fox</div>
            <div class="role__meta">
              <code>.{r.cls}</code>
              <span>{r.note}</span>
              <span class="role__token">{r.token}</span>
              {r.was && <span class="role__was">was <code>{r.was}</code></span>}
            </div>
          </summary>
          <table class="parts">
            <thead>
              <tr><th>Tier-2 token</th><th>Points at</th><th>Resolves to</th></tr>
            </thead>
            <tbody>
              {partsOf(r.cls.replace('type-', '')).map((p) => (
                <tr>
                  <td><code>{p.token}</code></td>
                  <td>{p.pointsAt ? <code class="parts__ref">{p.pointsAt}</code> : <span class="parts__dim">—</span>}</td>
                  <td class="parts__val">{p.resolved}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      ))}
    </div>
  </Section>
</DocsLayout>

<style>
  .families { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-400, 1rem); }
  .family { border: 1px solid var(--color-border-default, #e5e5e5); border-radius: 10px; padding: var(--spacing-400, 1rem); }
  .family__sample { font-size: 32px; color: var(--color-content-default, #171717); margin-bottom: var(--spacing-300, 0.75rem); }
  .family__meta { display: flex; flex-direction: column; gap: 3px; }
  .family__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 13px; color: var(--color-content-default, #171717); }
  .family__value { font-family: var(--typography-font-family-mono, monospace); font-size: 12.5px; color: var(--color-content-default-secondary, #525252); }
  .family__role { font-size: 13px; color: var(--color-content-default-secondary, #646464); }

  .scale { display: flex; flex-direction: column; }
  .scale__row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-400, 1rem); padding: var(--spacing-300, 0.75rem) 0; border-bottom: 1px solid var(--color-border-default-subtle, #efefef); }
  .scale__row:last-child { border-bottom: none; }
  .scale__sample { color: var(--color-content-default, #171717); line-height: 1.2; min-width: 0; flex: 1; }
  .scale__meta { display: flex; flex-direction: column; gap: 2px; text-align: right; flex: none; }
  .scale__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 12.5px; color: var(--color-content-default, #171717); }
  .scale__range { font-size: 12.5px; color: var(--color-content-default-secondary, #646464); }

  .weights { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--spacing-300, 0.75rem); }
  .weight { border: 1px solid var(--color-border-default, #e5e5e5); border-radius: 10px; padding: var(--spacing-400, 1rem); }
  .weight__sample { font-size: 28px; color: var(--color-content-default, #171717); margin-bottom: var(--spacing-250, 0.625rem); }
  .weight__meta { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-200, 0.5rem); }
  .weight__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 12px; color: var(--color-content-default, #171717); }
  .weight__meta span { font-size: 13px; color: var(--color-content-default-secondary, #646464); }

  .lh { display: flex; flex-direction: column; gap: var(--spacing-400, 1rem); }
  .lh__row { display: grid; grid-template-columns: 1fr 220px; gap: var(--spacing-400, 1rem); align-items: start; border: 1px solid var(--color-border-default, #e5e5e5); border-radius: 10px; padding: var(--spacing-400, 1rem); }
  .lh__sample { font-size: 16px; color: var(--color-content-default, #171717); margin: 0; max-width: 56ch; }
  .lh__meta { display: flex; flex-direction: column; gap: 2px; }
  .lh__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 12.5px; color: var(--color-content-default, #171717); }
  .lh__value { font-size: 13px; color: var(--color-content-default-secondary, #525252); }
  .lh__role { font-size: 13px; color: var(--color-content-default-secondary, #646464); }

  .ls { display: flex; flex-direction: column; }
  .ls__row { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-400, 1rem); padding: var(--spacing-300, 0.75rem) 0; border-bottom: 1px solid var(--color-border-default-subtle, #efefef); }
  .ls__row:last-child { border-bottom: none; }
  .ls__sample { font-size: 18px; color: var(--color-content-default, #171717); }
  .ls__meta { display: flex; flex-direction: column; gap: 2px; text-align: right; flex: none; }
  .ls__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 12.5px; color: var(--color-content-default, #171717); }
  .ls__value { font-size: 13px; color: var(--color-content-default-secondary, #525252); }
  .ls__role { font-size: 13px; color: var(--color-content-default-secondary, #646464); }

  .roles { display: flex; flex-direction: column; }
  .role { padding: var(--spacing-400, 1rem) 0; border-bottom: 1px solid var(--color-border-default-subtle, #efefef); }
  /* The summary IS the specimen row; the marker sits outside it so the sample
     keeps its own baseline alignment. */
  .role__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-400, 1rem); cursor: pointer; list-style: none; }
  .role__head::-webkit-details-marker { display: none; }
  .role__head::after { content: 'tokens \25BE'; flex: none; font-size: 11px; color: var(--color-content-default-secondary, #646464); letter-spacing: var(--letter-spacing-wide, 0.03em); }
  .role[open] .role__head::after { content: 'tokens \25B4'; }
  .parts { width: 100%; border-collapse: collapse; margin-top: var(--spacing-300, 0.75rem); }
  .parts th { text-align: left; font-size: 11px; font-weight: var(--typography-font-weight-semibold, 550); color: var(--color-content-default-secondary, #646464); text-transform: var(--text-transform-uppercase, uppercase); letter-spacing: var(--letter-spacing-wider, 0.06em); padding: 4px 8px; border-bottom: 1px solid var(--color-border-default-subtle, #efefef); }
  .parts td { padding: 4px 8px; font-size: 12px; border-bottom: 1px solid var(--color-border-default-subtle, #efefef); vertical-align: top; }
  .parts tr:last-child td { border-bottom: none; }
  .parts code { font-family: var(--typography-font-family-mono, monospace); font-size: 11.5px; }
  .parts__ref { color: var(--color-content-default-secondary, #525252); }
  .parts__val { font-family: var(--typography-font-family-mono, monospace); font-size: 11px; color: var(--color-content-default-secondary, #646464); word-break: break-word; }
  .parts__dim { color: var(--color-content-default-secondary, #646464); }
  .role:last-child { border-bottom: none; }
  .role__sample { color: var(--color-content-default, #171717); min-width: 0; flex: 1; }

  .role__meta { display: flex; flex-direction: column; gap: 2px; text-align: right; flex: none; }
  .role__meta code { font-family: var(--typography-font-family-mono, monospace); font-size: 12.5px; color: var(--color-content-default, #171717); }
  .role__meta span { font-size: 12.5px; color: var(--color-content-default-secondary, #646464); }
  .role__meta .role__token { font-family: var(--typography-font-family-mono, monospace); font-size: 11.5px; }
  .role__meta .role__was { font-size: 11.5px; font-style: var(--font-style-italic, italic); }
  .role__meta .role__was code { font-size: 11.5px; color: var(--color-content-default-secondary, #646464); }

  @media (max-width: 640px) {
    .lh__row { grid-template-columns: 1fr; }
  }
</style>
