  .crumbs a { color: var(--color-content-brand, #2a7e3b); }

  .tk { width: 100%; border-collapse: collapse; margin: var(--spacing-400, 1rem) 0; }
  .tk th, .tk td {
    text-align: left;
    vertical-align: top;
    padding: var(--spacing-250, 0.625rem) var(--spacing-300, 0.75rem);
    border-bottom: 1px solid var(--color-border-default, #e5e5e5);
  }
  .tk th { color: var(--color-content-default-secondary, #525252); white-space: nowrap; }

  pre {
    background: var(--color-background-elevation-sunken, #f5f5f5);
    border: 1px solid var(--color-border-default, #e5e5e5);
    border-radius: var(--radius-surface, 8px);
    padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem);
    overflow-x: auto;
  }

