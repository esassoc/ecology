  .callout {
    border-inline-start: 3px solid var(--color-border-utility-warning, #d97706);
    background: var(--color-background-utility-warning-subtle, #fffbeb);
    padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem);
    margin: var(--spacing-400, 1rem) 0;
  }

  ul { max-width: 78ch; }
  li { margin-bottom: var(--spacing-250, 0.625rem); }
  h3 { margin-top: var(--spacing-600, 1.5rem); }
