---
import PatternDoc from '../../layouts/PatternDoc.astro';
import Section from '@esa/docs/Section.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

const pathwayOptions = JSON.stringify([
  { label: 'Categorical exemption', value: 'cat-ex' },
  { label: 'Initial study / Negative declaration', value: 'is-nd' },
  { label: 'Initial study / Mitigated negative declaration', value: 'is-mnd' },
  { label: 'Environmental impact report', value: 'eir' },
]);
---
<PatternDoc
  name="Form section"
  slug="form-section"
  summary="A titled group of self-labelling controls that ends in an action row — the unit intake forms, settings panels, and dialog bodies are assembled from."
  whenToUse="Any screen that collects more than a couple of values — intake forms, settings panels, dialog bodies. One section per topic; stack sections to build a full form."
  composedOf={['esa-text-field', 'esa-select', 'esa-textarea', 'esa-radio-group', 'esa-error-summary', 'esa-button']}
>
  <Section id="default" title="Default">
    <p>
      A project-details section from an environmental review intake. <strong>Each control carries
      its own <code>label</code>, <code>help-text</code> and required state</strong> — that is what
      wires the name to the input inside its shadow root, and it is the whole field chrome, so no
      wrapper is involved. Short, related fields (lead agency / county) pair on one row; everything
      else runs single column. The action row closes the section: primary submit first, ghost
      cancel beside it.
    </p>
    <div class="pattern-stage">
      <section class="form-section" aria-labelledby="fs-default-title">
        <header class="form-section__header">
          <h3 id="fs-default-title" class="form-section__title">Project details</h3>
          <p class="form-section__desc">Tell us about the project under review. Fields marked * are required.</p>
        </header>

        <esa-text-field label="Project name" required
          help-text="As it appears on the notice of preparation."
          placeholder="e.g. Cypress Creek Trail Improvements"></esa-text-field>

        <div class="field-pair">
          <esa-text-field label="Lead agency" required
            placeholder="e.g. City of San Rafael"></esa-text-field>
          <esa-select label="County" class="fs-county" placeholder="Select a county" required></esa-select>
        </div>

        <esa-textarea label="Project description" required rows="4"
          help-text="Summarize the location, scope, and anticipated construction activity."
          placeholder="The project would construct…"></esa-textarea>

        <esa-radio-group label="Review pathway" required options={pathwayOptions}></esa-radio-group>

        <div class="form-section__actions">
          <EsaButton type="submit">Save and continue</EsaButton>
          <EsaButton variant="ghost">Cancel</EsaButton>
        </div>
      </section>
    </div>
  </Section>

  <Section id="validation" title="Validation state">
    <p>
      The same section after a failed submit: the name is missing and no pathway is selected.
      <strong>Two things happen, and both are needed.</strong>
    </p>
    <p>
      An <code>esa-error-summary</code> goes above the form and <em>takes focus</em>. Without it,
      pressing Submit appears to do nothing: focus is on the button at the bottom, the errors are
      added off-screen above, and a screen reader — which is on one element at a time — is told
      nothing at all. It is also what a page-zoom user, seeing only the region around the button,
      gets instead of silence.
    </p>
    <p>
      Then every invalid control takes <code>error-text</code>. One attribute reddens the border,
      sets <code>aria-invalid</code>, points <code>aria-describedby</code> at the message, and
      renders it with an icon and a visually-hidden "Error:" so the line is not distinguished from
      a help line by colour alone. Option groups take it too now. Word the summary and the inline
      message the same.
    </p>
    <div class="pattern-stage">
      <section class="form-section" aria-labelledby="fs-invalid-title">
        <header class="form-section__header">
          <h3 id="fs-invalid-title" class="form-section__title">Project details</h3>
          <p class="form-section__desc">Tell us about the project under review. Fields marked * are required.</p>
        </header>

        <esa-error-summary id="fs-summary"></esa-error-summary>

        <esa-text-field id="fs-name" label="Project name" required
          placeholder="e.g. Cypress Creek Trail Improvements"
          error-text="Enter a project name."></esa-text-field>

        <div class="field-pair">
          <esa-text-field label="Lead agency" required value="City of San Rafael"></esa-text-field>
          <esa-select label="County" id="fs-county-filled" class="fs-county"
            placeholder="Select a county" required></esa-select>
        </div>

        <esa-textarea label="Project description" required rows="4"
          help-text="Summarize the location, scope, and anticipated construction activity."
          value="A 0.8-mile multi-use path along Cypress Creek between Lindaro Street and Andersen Drive, with two prefabricated pedestrian bridges and native riparian planting."></esa-textarea>

        <esa-radio-group id="fs-pathway" label="Review pathway" required options={pathwayOptions}
          error-text="Select a review pathway."></esa-radio-group>

        <div class="form-section__actions">
          <EsaButton type="submit">Save and continue</EsaButton>
          <EsaButton variant="ghost">Cancel</EsaButton>
        </div>
      </section>
    </div>
  </Section>

  <Section id="composition-notes" title="Composition notes">
    <ul class="notes">
      <li>
        <strong>Self-chromed controls label themselves.</strong> <code>esa-text-field</code>,
        <code>esa-textarea</code> and the other Lit controls render into shadow DOM, so a
        <code>&lt;label&gt;</code> outside them can never be associated with the input inside —
        <code>esa-form-field</code>'s <code>label</code> is a visual caption only, and a control
        wrapped in it with its own <code>label</code> unset has <em>no accessible name</em>.
        Set the control's own <code>label</code> / <code>help-text</code> and leave the wrapper's
        unset. Reach for <code>esa-form-field</code>'s label only around a native
        <code>&lt;input&gt;</code> you can wire a <code>for</code>/<code>id</code> pair to yourself,
        or around a group that has no label of its own.
      </li>
      <li>
        <strong>A failed submit needs an <code>esa-error-summary</code>, not just red fields.</strong>
        Focus is on the Submit button when the form fails; the errors appear above it, off-screen,
        and nothing announces them. The summary is the thing that takes focus and says how many
        problems there are and where each one is. Set its <code>errors</code> and call
        <code>focus()</code> in the same handler that sets each field's <code>error-text</code>,
        and word the two the same.
      </li>
      <li>
        Error messages live in components, never ad-hoc styled spans. Every control that collects
        a value now takes <code>error-text</code> — including <code>esa-radio-group</code> and
        <code>esa-checkbox-group</code>, which previously had no error channel at all.
        <code>esa-field-error</code> is the escape hatch for a server-rendered message that is
        already on the page at load.
      </li>
      <li>
        The error no longer <em>replaces</em> help text — both render, and
        <code>aria-describedby</code> announces the error first, then the hint. A format
        requirement is most needed at the moment the format was got wrong, and the old
        either/or deleted it exactly then.
      </li>
      <li>
        The action row belongs to the section, not to any field: primary action first, ghost cancel
        second, left-aligned on the same axis as the labels, separated from the fields by a divider.
      </li>
      <li>
        Single column by default. Only pair short, related fields on one row, and collapse the pair
        on narrow viewports. Controls run full width — the section's <code>max-width</code> sets the
        measure, not the individual control.
      </li>
      <li>
        One size across the section: everything defaults to <code>md</code> on the shared scale, so
        inputs, selects, and buttons share heights and line up when they meet on a row.
      </li>
    </ul>
  </Section>
</PatternDoc>

<style>
  .form-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500, 1.5rem);
    max-width: 560px;
  }

  .form-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100, 0.25rem);
  }

  .form-section__title {
    margin: 0;
    font-size: var(--font-size-400, 1.125rem);
    font-weight: var(--typography-font-weight-semibold, 550);
    color: var(--color-content-default, #171717);
  }

  .form-section__desc {
    margin: 0;
    font-size: var(--font-size-300, 1rem);
    color: var(--color-content-default-secondary, #525252);
  }

  .field-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-400, 1rem);
  }

  @media (max-width: 640px) {
    .field-pair { grid-template-columns: 1fr; }
  }

  .form-section__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    padding-block-start: var(--spacing-400, 1rem);
    border-block-start: 1px solid var(--color-border-default, #e5e5e5);
  }

  .notes li {
    margin-block-end: var(--spacing-200, 0.5rem);
    line-height: var(--line-height-relaxed, 1.8);
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-radio-group';
  import '@esa/ecology/esa-error-summary';

  const counties = [
    'Alameda', 'Contra Costa', 'Marin', 'Napa', 'Sacramento',
    'San Francisco', 'San Mateo', 'Santa Clara', 'Solano', 'Sonoma',
  ].map((name) => ({ label: name, value: name.toLowerCase().replace(/\s+/g, '-') }));

  customElements.whenDefined('esa-select').then(() => {
    // Options are a property, not an attribute — assign to every county select.
    document.querySelectorAll('esa-select.fs-county').forEach((el) => {
      (el as any).options = counties;
    });
    // The validation specimen shows a partially completed section.
    const filled = document.getElementById('fs-county-filled');
    if (filled) (filled as any).value = 'marin';
  });

  // The validation specimen's summary. Errors are set so the specimen SHOWS the
  // post-submit state; focus() is deliberately NOT called — a doc page that grabs focus
  // on load is a worse bug than the one the summary fixes. In a real form the same
  // handler that sets these calls focus() as its last step.
  customElements.whenDefined('esa-error-summary').then(() => {
    const summary = document.getElementById('fs-summary') as any;
    if (summary) {
      summary.errors = [
        { field: 'fs-name', message: 'Enter a project name.' },
        { field: 'fs-pathway', message: 'Select a review pathway.' },
      ];
    }
  });
</script>
