---
import ComponentDoc from '../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Preview from '@esa/docs/Preview.astro';
import ApiTable from '../../components/ApiTable.astro';
import EsaIconLink from '@esa/ecology/esa-icon-link.astro';

// Prose only — names, types and defaults are generated from the component
// source by src/data/component-api.ts, so this table cannot drift.
const describe = {
  href: "When present renders an <a>; otherwise a <button> (e.g. a dropdown trigger).",
  icon: "Leading Lucide icon name.",
  iconRight: "Lucide icon to the right of the label — the dropdown/disclosure affordance, e.g. \"chevron-down\".",
  size: "sm = 14px (sub-bars), md = 16px (primary bars).",
  active: "Selected / current state (sets aria-current and semibold).",
  weight: "Label weight.",
};
---
<ComponentDoc name="Icon Link" category="Deprecated" slug="esa-icon-link" type=".astro" status="deprecated"
  supersededBy={'<EsaButton variant="chrome">'}
  summary="Deprecated 2026-08-14, folded into <a href='/components/esa-button'>esa-button</a> (migrations.json: <code>icon-link-to-button-chrome</code>). What it was: the atomic nav/menu link — <strong>[icon] label [iconRight affordance]</strong> — inheriting <code>currentColor</code> so it sat on any surface without knowing the brand, which is now what <code>variant=&quot;chrome&quot;</code> means. It was the most-composed brick in app chrome, which is why the shim stays until every spoke has run <code>/update-tokens</code>. <code>weight</code> has no destination: the button takes weight from its type composite.">

  <Section id="preview" title="Preview">
    <Preview code={`<EsaIconLink icon="trees" iconRight="chevron-down">Mitigation work</EsaIconLink>`}>
      <EsaIconLink icon="trees" iconRight="chevron-down">Mitigation work</EsaIconLink>
    </Preview>
  </Section>

  <Section id="oncontext" title="Inherits the surface (currentColor)">
    <p>The link carries no color of its own — it inherits <code>currentColor</code>. Drop the same markup on a dark bar or a light surface and it just works.</p>
    <Preview code={`<!-- on a dark bar: color set by the parent -->
<div style="color:#fff;background:#13273e">
  <EsaIconLink icon="database" iconRight="chevron-down">Data management</EsaIconLink>
</div>`}>
      <div style="display:flex;flex-direction:column;gap:12px;width:100%">
        <div style="display:flex;gap:40px;color:#fff;background:#13273e;padding:16px 24px;border-radius:8px">
          <EsaIconLink icon="database" iconRight="chevron-down">Data management</EsaIconLink>
          <EsaIconLink icon="activity" iconRight="chevron-down">System status</EsaIconLink>
          <EsaIconLink icon="settings" iconRight="chevron-down">System configuration</EsaIconLink>
        </div>
        <div style="display:flex;gap:40px;color:#1e5386;background:#f3f7fc;padding:16px 24px;border-radius:8px">
          <EsaIconLink icon="database" iconRight="chevron-down">Data management</EsaIconLink>
          <EsaIconLink icon="activity" iconRight="chevron-down">System status</EsaIconLink>
        </div>
      </div>
    </Preview>
  </Section>

  <Section id="sizes" title="Sizes">
    <Preview code={`<EsaIconLink icon="credit-card" size="sm">Funding</EsaIconLink>
<EsaIconLink icon="credit-card" size="md">Funding</EsaIconLink>`}>
      <div style="display:flex;gap:32px;align-items:center">
        <EsaIconLink icon="credit-card" size="sm">Funding (sm)</EsaIconLink>
        <EsaIconLink icon="credit-card" size="md">Funding (md)</EsaIconLink>
      </div>
    </Preview>
  </Section>

  <Section id="variants" title="Link · trigger · active">
    <Preview code={`<EsaIconLink href="/dashboard" icon="layout-dashboard">Dashboard</EsaIconLink>
<EsaIconLink icon="circle-user" iconRight="chevron-down">Angela Zhao</EsaIconLink>
<EsaIconLink icon="trending-up" active>Reporting</EsaIconLink>`}>
      <div style="display:flex;gap:32px;align-items:center">
        <EsaIconLink href="/dashboard" icon="layout-dashboard">Dashboard</EsaIconLink>
        <EsaIconLink icon="circle-user" iconRight="chevron-down">Angela Zhao</EsaIconLink>
        <EsaIconLink icon="trending-up" active>Reporting</EsaIconLink>
      </div>
    </Preview>
  </Section>

  <Section id="api" title="API">
    <ApiTable slug="esa-icon-link" describe={describe} />
  </Section>
</ComponentDoc>
