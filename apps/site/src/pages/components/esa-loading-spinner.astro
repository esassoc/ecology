---
import ComponentDoc from '../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Preview from '@esa/docs/Preview.astro';
import ApiTable from '@esa/docs/ApiTable.astro';
import LoadingSpinner from '@esa/ecology/esa-loading-spinner.astro';

// Prose only — names, types and defaults are generated from the component
// source by src/data/component-api.ts, so this table cannot drift.
const describe = {
  size: "Ring diameter (14 / 20 / 32 / 48px).",
  color: "Any CSS color value for the rotating arc. Defaults to --color-background-brand.",
};
---
<ComponentDoc name="Loading Spinner" category="Display" slug="esa-loading-spinner" type=".astro" status="stable"
  summary="Rotating ring indicator. Three sizes plus an optional custom color.">

  <Section id="preview" title="Preview">
    <Preview code={`<LoadingSpinner />`}>
      <LoadingSpinner />
    </Preview>
  </Section>

  <Section id="sizes" title="Sizes">
    <Preview code={`<LoadingSpinner size="xs" />
<LoadingSpinner size="sm" />
<LoadingSpinner size="md" />
<LoadingSpinner size="lg" />`}>
      <LoadingSpinner size="xs" />
      <LoadingSpinner size="sm" />
      <LoadingSpinner size="md" />
      <LoadingSpinner size="lg" />
    </Preview>
  </Section>

  <Section id="states" title="Custom color">
    <p>Pass any CSS color (including a token reference) to recolor the rotating arc.</p>
    <Preview code={`<LoadingSpinner color="var(--color-background-utility-success, #22c55e)" />
<LoadingSpinner color="var(--color-background-utility-warning, #f59e0b)" />
<LoadingSpinner color="var(--color-background-utility-danger, #ef4444)" />`}>
      <LoadingSpinner color="var(--color-background-utility-success, #22c55e)" />
      <LoadingSpinner color="var(--color-background-utility-warning, #f59e0b)" />
      <LoadingSpinner color="var(--color-background-utility-danger, #ef4444)" />
    </Preview>
  </Section>

  <Section id="api" title="API">
    <ApiTable slug="esa-loading-spinner" describe={describe} />
  </Section>

  <Section id="accessibility" title="Accessibility">
    <ul class="a11y">
      <li>The ring carries <code>role="status"</code> and <code>aria-label="Loading"</code>.</li>
      <li>Decorative-only when paired with adjacent loading text — keep one accessible name, not two.</li>
    </ul>
  </Section>

</ComponentDoc>
