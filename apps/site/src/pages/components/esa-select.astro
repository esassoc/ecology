---
import ComponentDoc from '../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Preview from '@esa/docs/Preview.astro';
import ApiTable from '../../components/ApiTable.astro';
import { withBase } from '@esa/docs/base';

// Prose only — names, types and defaults are generated from the component
// source by src/data/component-api.ts, so this table cannot drift.
const describe = {
  label: "Field label above the control.",
  options: "Selectable options. Set as a property (not an attribute).",
  size: "Control size (reflected attribute). No xs — see Sizes.",
  placeholder: "Placeholder shown when nothing is selected.",
  "help-text": "Helper text below the control.",
  "error-text": "Error message; sets the error state when present.",
  required: "Marks the field required (renders a * after the label).",
  disabled: "Disables interaction (reflected attribute).",
  multiple: "Allow multiple selections.",
  searchable: "Type-to-filter the option list. When false the input is read-only.",
  "chip-mode": "In multi-select, render selected values as removable chips.",
  value: "Property accessor. Single = string; multiple = string array.",
};

const events = [
  { name: 'change', type: 'CustomEvent<{ value: string | string[] }>', description: 'Fired on selection change. Composed and bubbles. Form value is the string (single) or comma-joined values (multiple).' },
];
---
<ComponentDoc name="Select" category="Forms" slug="esa-select" type="wc" status="stable"
  summary="Form-associated searchable select with single/multi-select, chips, and full keyboard navigation. A Lit Web Component migrated from the Angular <code>esa-select</code>.">

  <Section id="preview" title="Preview">
    <Preview code={`<esa-select label="Fruit" placeholder="Choose a fruit" help-text="Type to filter"></esa-select>`}>
      <esa-select label="Fruit" placeholder="Choose a fruit" help-text="Type to filter"></esa-select>
    </Preview>
  </Section>

  <Section id="sizes" title="Sizes">
    <p>
      Three sizes, not four. Select has no <code>xs</code>: at 28px the trigger and its chevron fall
      below a comfortable tap target, and because the option list it opens is sized independently,
      shrinking the trigger buys nothing downstream. <code>sm</code> is the floor — reach for it in
      dense table rows and filter bars. Controls without a popup, like
      <a href={withBase('/components/esa-text-field')}>Text Field</a>, still offer <code>xs</code>.
    </p>
    <Preview code={`<esa-select label="Small" size="sm"></esa-select>
<esa-select label="Medium" size="md"></esa-select>
<esa-select label="Large" size="lg"></esa-select>`}>
      <esa-select label="Small" size="sm"></esa-select>
      <esa-select label="Medium" size="md"></esa-select>
      <esa-select label="Large" size="lg"></esa-select>
    </Preview>
  </Section>

  <Section id="states" title="States">
    <p>Multi-select renders chips with <code>chip-mode</code>. Error, required, disabled, and read-only states are all driven by attributes.</p>
    <Preview code={`<esa-select label="Toppings" multiple chip-mode placeholder="Add toppings"></esa-select>
<esa-select label="Required" required></esa-select>
<esa-select label="Error" error-text="Please make a selection"></esa-select>
<esa-select label="Disabled" disabled></esa-select>`}>
      <esa-select label="Toppings" multiple chip-mode placeholder="Add toppings"></esa-select>
      <esa-select label="Required" required></esa-select>
      <esa-select label="Error" error-text="Please make a selection"></esa-select>
      <esa-select label="Disabled" disabled></esa-select>
    </Preview>
  </Section>

  <Section id="api" title="API">
    <ApiTable slug="esa-select" describe={describe} events={events} />
  </Section>

  <Section id="accessibility" title="Accessibility">
    <ul class="a11y">
      <li>Input has <code>role="combobox"</code> with <code>aria-expanded</code>, <code>aria-haspopup="listbox"</code>, and <code>aria-autocomplete="list"</code>.</li>
      <li>Dropdown is <code>role="listbox"</code>; options are <code>role="option"</code> with <code>aria-selected</code> / <code>aria-disabled</code>.</li>
      <li>Keyboard: ArrowUp/Down navigate, Enter selects, Escape/Tab close. Outside-click closes.</li>
      <li>Chip remove buttons carry an <code>aria-label</code> ("Remove {'{label}'}").</li>
      <li>Form-associated via <code>ElementInternals</code> — value submits with the enclosing form.</li>
    </ul>
  </Section>

</ComponentDoc>

<script>
  import '@esa/ecology/esa-select';
  const opts = [
    { label: 'Apple', value: 'apple' },
    { label: 'Banana', value: 'banana' },
    { label: 'Cherry', value: 'cherry' },
    { label: 'Date', value: 'date', disabled: true },
    { label: 'Elderberry', value: 'elderberry' },
    { label: 'Fig', value: 'fig' },
    { label: 'Grape', value: 'grape' },
  ];
  customElements.whenDefined('esa-select').then(() => {
    document.querySelectorAll('esa-select').forEach((el) => {
      (el as any).options = opts;
    });
  });
</script>

<style>
  h3 { font-size: 16px; font-weight: 600; margin: var(--spacing-500, 1.5rem) 0 var(--spacing-200, 0.5rem); }
</style>
