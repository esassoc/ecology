---
import ComponentDoc from "../../layouts/ComponentDoc.astro";
import Section from "@esa/docs/Section.astro";
import Preview from "@esa/docs/Preview.astro";
import ApiTable from '@esa/docs/ApiTable.astro';
import EsaAppBar from "@esa/ecology/esa-app-bar.astro";
import EsaIconLink from "@esa/ecology/esa-icon-link.astro";
import EsaIconButton from "@esa/ecology/esa-icon-button.astro";

// Prose only — names, types and defaults are generated from the component
// source by src/data/component-api.ts, so this table cannot drift.
const describe = {
  tone: "Color context. surface → --color-background-elevation-raised/text-primary; brand → --color-background-brand/text-inverse; brand-strong → --color-background-default-knockout/text-inverse. Children inherit the text color.",
  contained: "Constrain the inner row to maxWidth and center it.",
  maxWidth: "Inner row max-width when contained.",
  as: "Semantic host element.",
  ariaLabel: "Accessible name for the host element. REQUIRED when as=\"nav\" — an unnamed navigation landmark cannot be told apart from any other in a screen reader's landmark list, and this component spreads no rest props, so there was previously no way to name one. Omit the word \"navigation\": the role is announced already.",
};
---

<ComponentDoc
  name="App Bar"
  category="Navigation"
  slug="esa-app-bar"
  type=".astro"
  status="stable"
  summary="The full-bleed chrome shell shared by top nav bars, sub-bars, and footers. It sets a <strong>color context</strong> (background + currentColor) from semantic tokens via <code>tone</code>, then exposes <code>start</code> / default / <code>end</code> slots. Children — <a href='/components/esa-icon-link'>Icon Link</a>, <a href='/components/esa-icon-button'>Icon Button</a>, a brand lockup — inherit the color, so a bar's brand comes entirely from tokens."
>
  <Section id="tones" title="Tones">
    <p>
      Each tone maps to ecology semantic tokens; a spoke re-themes by
      re-pointing those tokens (e.g. <code>--color-background-brand</code>, <code
        >--color-background-default-knockout</code
      >) — never by touching this component.
    </p>
    <Preview
      align="start"
      code={`<EsaAppBar tone="surface">…</EsaAppBar>
<EsaAppBar tone="brand">…</EsaAppBar>
<EsaAppBar tone="brand-strong">…</EsaAppBar>`}
    >
      <div style="display:flex;flex-direction:column;gap:12px;width:100%">
        <EsaAppBar tone="surface">
          <EsaIconLink icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton slot="end" icon="search" label="Search" />
        </EsaAppBar>
        <EsaAppBar tone="brand">
          <EsaIconLink icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton slot="end" icon="search" label="Search" />
        </EsaAppBar>
        <EsaAppBar tone="brand-strong">
          <EsaIconLink icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton slot="end" icon="search" label="Search" />
        </EsaAppBar>
      </div>
    </Preview>
  </Section>

  <Section id="slots" title="Slots: start · main · end">
    <p>
      The <code>end</code> slot is pushed right with <code
        >margin-left:auto</code
      >. This is the whole anatomy of a top bar.
    </p>
    <Preview
      align="start"
      code={`<EsaAppBar tone="brand" as="header">
  <span slot="start"><strong>CB Fish</strong></span>
  <EsaIconLink icon="trees" iconRight="chevron-down">Mitigation work</EsaIconLink>
  <EsaIconLink icon="trending-up" iconRight="chevron-down">Reporting</EsaIconLink>
  <EsaIconLink icon="credit-card" iconRight="chevron-down">Funding</EsaIconLink>
  <EsaIconButton slot="end" icon="search" label="Search" />
  <EsaIconLink slot="end" href="/dashboard" icon="layout-dashboard">Dashboard</EsaIconLink>
  <EsaIconLink slot="end" icon="circle-user" iconRight="chevron-down">Angela Zhao</EsaIconLink>
</EsaAppBar>`}
    >
      <EsaAppBar tone="brand" as="header">
        <span slot="start" style="font-weight:700;font-size:18px"
          >CB&nbsp;Fish</span
        >
        <EsaIconLink icon="trees" iconRight="chevron-down"
          >Mitigation work</EsaIconLink
        >
        <EsaIconLink icon="trending-up" iconRight="chevron-down"
          >Reporting</EsaIconLink
        >
        <EsaIconLink icon="credit-card" iconRight="chevron-down"
          >Funding</EsaIconLink
        >
        <EsaIconButton slot="end" icon="search" label="Search" />
        <EsaIconLink slot="end" href="/dashboard" icon="layout-dashboard"
          >Dashboard</EsaIconLink
        >
        <EsaIconLink slot="end" icon="circle-user" iconRight="chevron-down"
          >Angela Zhao</EsaIconLink
        >
      </EsaAppBar>
    </Preview>
  </Section>

  <Section id="api" title="API">
    <ApiTable slug="esa-app-bar" describe={describe} />
  </Section>
</ComponentDoc>
