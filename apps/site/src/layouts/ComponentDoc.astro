---
import DocsLayout from './DocsLayout.astro';
import Section from '@esa/docs/Section.astro';
import { withBase } from '@esa/docs/base';
import { themingSurface, lineageFor } from '../data/theming';
import { typeRolesBySlug, propertyTokensOf } from '../data/composite-classes';
import ThemingTable from './_ThemingTable.astro';

interface Props {
  name: string;          // display name, e.g. "Button"
  category: string;      // e.g. "Core"
  slug: string;          // component basename, e.g. "esa-button"
  type: '.astro' | 'wc' | 'reference';
  status?: 'stable' | 'reference';
  summary: string;
  wraps?: string;        // reference only, e.g. "AG Grid"
}
const { name, category, slug, type, status = 'stable', summary, wraps } = Astro.props;

const activeHref = `/components/${slug}`;
const pascal = slug.split('-').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join('');
const importLine =
  type === '.astro' ? `import ${pascal} from '@esa/ecology/${slug}.astro';`
  : type === 'wc' ? `import '@esa/ecology/${slug}';`
  : null;
const statusLabel = type === 'reference' ? 'Reference' : 'Stable';
const statusClass = type === 'reference' ? 'pill--reference' : 'pill--stable';

// Build-time-extracted public theming surface (src/data/theming.ts) — every
// token this component's CSS reads. Rendered on every component page so
// "what can my spoke re-point?" can never drift from the source.
// Split by BLAST RADIUS, not just tier — the two questions a spoke author
// actually asks are "what is mine to turn?" and "what will I move if I turn
// it?". Ownership is read from the `/* esa-foo */` groups in
// component-tokens.css, so this split is authored, not guessed.
const hooks = themingSurface[slug] ?? [];
const ownHooks = hooks.filter((h) => h.scope === 'exclusive');
const sharedHooks = hooks.filter((h) => h.scope !== 'exclusive');

// TYPE ROLES — the half of the surface a var() scan cannot see. A composite is a
// CLASS (CSS has no composite custom property), so a component that names one
// reads no typography token at all and the table above goes quiet about text.
// That is a documentation hole the composite migration OPENED: esa-dialog's title
// used to read --font-size-400 and --typography-font-weight-semibold and the table
// listed both. Re-pointing a role moves every component naming it, which is the
// same blast-radius question the rest of this section is organised around.
const typeRoles = typeRolesBySlug.get(slug);
const rolesWithReach = (typeRoles?.roles ?? []).map((cls) => ({
  cls,
  tokens: propertyTokensOf(cls).map((t) => ({ name: t, lineage: lineageFor(t) })),
  alsoUsedBy: [...typeRolesBySlug.entries()]
    .filter(([s, r]) => s !== slug && r.roles.includes(cls))
    .map(([s]) => s)
    .sort(),
}));
---
<DocsLayout title={`${name} — Ecology`} activeHref={activeHref}>
  <nav class="crumbs"><a href={withBase('/')}>Ecology</a> <span>/</span> <span>{category}</span> <span>/</span> <span>{name}</span></nav>
  <h1>{name}</h1>
  <p class="lede" set:html={summary} />
  <div class="meta-row">
    <span class={`pill ${statusClass}`}>{statusLabel}</span>
    {type !== 'reference' && <span class="pill">{type}</span>}
    {wraps && <span class="pill">wraps {wraps}</span>}
    {importLine && <code class="imp">{importLine}</code>}
  </div>
  <slot />

  {(hooks.length > 0 || rolesWithReach.length > 0) && (
    <Section id="theming-surface" title="Theming surface">
      <p class="ts-note">
        Every public token this component reads, extracted from its source at build time,
        split by <strong>blast radius</strong>: the hooks that belong to this component,
        then the shared and system tokens it consumes alongside everything else. The
        <strong>Resolves&nbsp;to</strong> column walks each token's real lineage —
        component&nbsp;→&nbsp;semantic&nbsp;→&nbsp;primitive&nbsp;→&nbsp;raw value — so you
        can see exactly where re-pointing it lands. A spoke re-skins by overriding these in
        its <code>theme-&lt;slug&gt;.css</code>; component internals are never edited. No
        hook for what you need? File it with <code>/request-lego</code>.
      </p>
      {rolesWithReach.length > 0 && (
        <Fragment>
          <h3 class="ts-h">Type roles it names</h3>
          <p class="ts-sub">
            This component does not set a size, weight, face or tracking of its own —
            it names a <strong>composite</strong>, and the composite carries all five.
            A composite is a class rather than a token, so none of it appears in the
            tables below; re-theme text by re-pointing the token family, not by editing
            the component.
            {typeRoles && !typeRoles.delivered && (
              <strong class="ts-warn">
                {' '}⚠ This component applies a composite but never imports its
                definitions, so the class matches no rule where it renders.
              </strong>
            )}
          </p>
          <table class="ts-table">
            <thead>
              <tr><th>Role</th><th>Re-point</th><th>Reach</th></tr>
            </thead>
            <tbody>
              {rolesWithReach.map((r) => (
                <tr>
                  <td><code>.{r.cls}</code></td>
                  <td>
                    <ul class="ts-tokens">
                      {r.tokens.map((t) => {
                        const terminal = t.lineage[t.lineage.length - 1];
                        const via = t.lineage.slice(0, -1).map((l) => l.ref);
                        return (
                          <li>
                            <code>{t.name}</code>
                            <span class="ts-val">{terminal ? terminal.ref : '—'}</span>
                            {via.length > 0 && <span class="ts-via">via {via.join(' → ')}</span>}
                          </li>
                        );
                      })}
                    </ul>
                  </td>
                  <td>
                    {r.alsoUsedBy.length === 0 ? (
                      <span class="ts-only">only here</span>
                    ) : (
                      <details>
                        <summary>+{r.alsoUsedBy.length} more component{r.alsoUsedBy.length === 1 ? '' : 's'}</summary>
                        <span class="ts-readers">{r.alsoUsedBy.join(', ')}</span>
                      </details>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </Fragment>
      )}

      <h3 class="ts-h">Wired to this component</h3>
      {ownHooks.length > 0 ? (
        <Fragment>
          <p class="ts-sub">
            No other component reads these — re-point them and <code>{slug}</code> is the
            only thing that moves.
          </p>
          <ThemingTable hooks={ownHooks} mode="own" />
        </Fragment>
      ) : (
        <p class="ts-sub ts-empty">
          None. This component has no hooks of its own — it themes entirely through the
          shared tokens below, so every override here also moves its siblings.
        </p>
      )}

      <h3 class="ts-h">Shared tokens it reads</h3>
      <p class="ts-sub">
        Owned by a family or by the semantic layer. Still overridable — but scope the
        override (<code>{'esa-foo { --form-border-color: … }'}</code>) unless you mean to move
        everything that reads it. <strong>Reach</strong> says what else that is.
      </p>
      <ThemingTable hooks={sharedHooks} mode="shared" />
    </Section>
  )}
</DocsLayout>

<style>
  /* Token-table styling lives in _ThemingTable.astro (Astro styles are per-component),
     so the type-roles table below repeats the three rules it needs rather than
     reaching across a scope boundary that does not exist. */
  .ts-table { width: 100%; border-collapse: collapse; }
  .ts-table th { text-align: left; padding: var(--spacing-200, 0.5rem) var(--spacing-300, 0.75rem); border-bottom: 2px solid var(--color-border-default, #e5e5e5); }
  .ts-table td { padding: var(--spacing-150, 0.375rem) var(--spacing-300, 0.75rem); border-bottom: 1px solid var(--color-border-default, #e5e5e5); vertical-align: top; }
  .ts-only { color: var(--color-content-default-muted, #888); }
  .ts-tokens { margin: 0; padding: 0; list-style: none; }
  .ts-tokens code { font-size: 0.8125rem; }
  .ts-tokens li { margin-block-end: var(--spacing-150, 0.375rem); }
  .ts-val { display: block; font-size: 0.8125rem; color: var(--color-content-default, #171717); }
  .ts-via { display: block; font-size: 0.75rem; color: var(--color-content-default-muted, #999); }
  .ts-readers { display: block; margin-top: 3px; font-size: 0.8125rem; color: var(--color-content-default-muted, #999); }
  .ts-warn { color: var(--color-content-utility-danger, #ce2c31); }
  .ts-note { color: var(--color-content-default-secondary, #444); }
  .ts-h { margin: var(--spacing-600, 2rem) 0 var(--spacing-100, 0.25rem); }
  .ts-sub { margin: 0 0 var(--spacing-300, 0.75rem); color: var(--color-content-default-secondary, #444); }
  .ts-empty { color: var(--color-content-default-muted, #888); }
</style>
