    "@esa/tokens": "*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/web-components-vite": "^10.5.8",
    "lit": "^3.2.0",
    "storybook": "^10.5.8",
    "vite": "^6.0.0"
  }
}
